<Modal Buttons="ModalButtons.YesCancel"
       ModalTitle="@TextResources.APP_StringKeys_Aggregate_CheckBeforeApprove"
       @ref="ModalApprove"
       Size="ModalSize.Large"
       CancelBtnText="@TextResources.APP_StringKeys_Close"
       YesBtnText="@TextResources.APP_StringKeys_Approve_Aggregate_Docs"
       OnYesModal="OnApproveAggregateClick"
       YesBtnClass="btn-danger">
    <ModalBodyContentHtml>
        <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:10px;">
            <label style="margin-right: 30px !important;">@TextResources.APP_StringKeys_Description :</label>
            <TelerikTextBox @bind-Value="CurrentAggregate.Description"
                            Class="form-control input-search-span-lg pointer" Width="400px !important">
            </TelerikTextBox>
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Check_Before_Revoke_Aggregate"
       @ref="RevokeModal"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Disconfirm"
       OkBtnText="@TextResources.APP_StringKeys_Approve"
       OnOkModal="OnRevokeClick">
    <ModalBodyContentHtml>
        <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:10px;">
            <label style="margin-right: 30px !important;">@TextResources.APP_StringKeys_Description :</label>
            <TelerikTextBox @bind-Value="RevokeAggregateDescription"
                            Class="form-control input-search-span-lg pointer" Width="400px !important">
            </TelerikTextBox>
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.YesCancel"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
       @ref="ModalPrint"
       Size="ModalSize.Large"
       CancelBtnText="@TextResources.APP_StringKeys_Close"
       YesBtnText="@TextResources.APP_StringKeys_Print"
       OnYesModal="OnApprovePrintClick"
       YesBtnClass="btn-danger">
    <ModalBodyContentHtml>
        <div class="text-align-center bg-success text-light">
            @TextResources.APP_StringKeys_Message_Success .
            @TextResources.APP_StringKeys_Print_Aggregated_Document
        </div>
        <br />
        <div class="text-align-center">
            @CurrentAggregate.CurrentAggCode?.Replace('+', '-')
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.YesCancel"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
       @ref="ModalRemove"
       Size="ModalSize.Large"
       CancelBtnText="@TextResources.APP_StringKeys_Close"
       YesBtnText="@TextResources.APP_StringKeys_Remove"
       OnYesModal="OnSuggestDocRemoveClick"
       OnCancelModal="async ()=>await ModalSuggestDetails.Open(new())"
       YesBtnClass="btn-danger">
    <ModalBodyContentHtml>
        <div class="text-align-center bg-danger text-light">
            @TextResources.APP_StringKeys_Remove_CheckBeforeDelete
        </div>
    </ModalBodyContentHtml>
</Modal>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>