@page "/product/exgu"
@inherits SiloBasePage
@namespace Silo.Modules.Guarantee.Pages
@using Silo.Application.Dto;
@using Silo.Application.Features;
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Silo.Identity.Client
@using Silo.Shared.Components.Report
@using Telerik.Blazor.Components
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>
@if (IsFiltersShown)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 " style="height: 100px;">
            <h6>@TextResources.APP_StringKeys_Filters</h6>
            <div class="form-group form-inline  search-button-div" style="margin-top:-136px !important;width:480px;">
                <button class="btn btn-success" type="button" title="@TextResources.APP_StringKeys_Filters"
                        style="margin-left: 2px;" @onclick="OnFilterModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Filter_alt"></MaterialIcon>
                </button>
                <button class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                        style="margin-left: 2px;" @onclick="OnClearClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button class="btn btn-primary" type="button"
                        title="@TextResources.APP_StringKeys_Send"
                        @onclick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                </button>
            </div>
            @if (ApplyFilters.Any())
            {
                <div class="form-group form-inline col-md-10" style="margin-bottom:10px!important; margin-top:15px;">
                    <FilterReportEditSection Filters="ApplyFilters">
                    </FilterReportEditSection>
                </div>
            }
        </div>
    </div>
}

<div class="row col-md-12" style="margin-top: 5px;">
    <div class="card card-stats col-md-12 text-align-center">
        <TelerikGrid Data="Products"
                     PageSize="10"
                     Navigable="true"
                     Pageable="true"
                     Sortable="true"
                     Width="100%"
                     ScrollMode="@GridScrollMode.Scrollable">
            <RowTemplate Context="product">
                <td class="td-style td-style-full">
                    <TelerikCheckBox @bind-Value="product.IsSelected"
                                     OnChange="OnToggleSelectChange">
                    </TelerikCheckBox>
                </td>
                <td class="td-style td-style-full">@product.ProductCode</td>
                <td class="td-style td-style-full">@product.ProductName</td>
                <td class="td-style td-style-full">@product.TechnicalCode</td>
                <td class="td-style td-style-full">@product.ProductType</td>
                <td class="td-style td-style-full">@product.ProductGroup</td>
                <td class="td-style td-style-full">@product.ProductSubGroupTitle</td>
                <td class="td-style td-style-full">@product.ProductBrand</td>
                <td class="td-style td-style-full">@product.ProductClassTitle</td>
                <td class="td-style td-style-full">@product.Size</td>
                <td class="td-style td-style-full">@product.Qc</td>
                <td class="td-style td-style-full">@product.GuaranteeStatus</td>
                <td class="td-style td-style-full">@product.GuaranteeDuration</td>
                <td class="td-style td-style-full">@product.ExpireStatus</td>
                <td class="td-style td-style-full">@product.ExpireDuration</td>
            </RowTemplate>
            <GridColumns>
                <GridCheckboxColumn Visible="true" Width="30px" HeaderClass="header-select-all">
                    <HeaderTemplate>
                        @{
                            @if (Products is not null)
                            {
                                <TelerikCheckBox @bind-Value="@IsAllSelected"
                                                 TabIndex="-1"
                                                 OnChange="OnToggleSelectAll" />
                            }
                        }
                    </HeaderTemplate>
                </GridCheckboxColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductCode)"
                            Width="150px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductName)"
                            Width="200px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.TechnicalCode)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductType)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductGroup)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductSubGroupTitle)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductBrand)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ProductClassTitle)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.Size)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.Qc)"
                            Width="100px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.GuaranteeStatus)"
                            Width="120px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.GuaranteeDuration)"
                            Width="120px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ExpireStatus)"
                            Width="120px">
                </GridColumn>
                <GridColumn Field="@nameof(GetGuaranteeProductsVm.ExpireDuration)"
                            Width="120px">
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (Products is not null)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 text-align-right" style="margin-bottom:5px;">
            <EditForm Model="Command"
                      OnInvalidSubmit="OnInvalidSubmit"
                      OnValidSubmit="OnValidSubmit">
                <div class="form-group form-inline" style="margin-bottom:20px!important; margin-top:15px; ">
                    <label>@TextResources.APP_StringKeys_Guarantee_Type</label>
                    <TelerikDropDownList Data="GuaranteeItems"
                                         TextField="@(nameof(TelerikDropDownItemGeneric<GuaranteeTypes>.Name))"
                                         ValueField="@(nameof(TelerikDropDownItemGeneric<GuaranteeTypes>.Value))"
                                         @bind-Value="Command.GuaranteeType"
                                         Width="250px"
                                         Class="drop-all">
                    </TelerikDropDownList>
                    @if (Command.GuaranteeType == GuaranteeTypes.Date)
                    {
                        <label>@TextResources.APP_StringKeys_ToDate</label>
                        <DatePicker @bind-Value="Command.GuaranteeDate">
                        </DatePicker>
                    }
                    else
                    {
                        <label>@TextResources.APP_StringKeys_ExpireAndGuarantee_ExpireDays</label>
                        <TelerikNumericTextBox @bind-Value="Command.GuaranteeMonths"
                                               Width="100px">
                        </TelerikNumericTextBox>
                        <label>@TextResources.APP_StringKeys_Month</label>
                    }
                </div>
                <div class="form-group form-inline" style="margin-bottom:20px!important; margin-top:5px; margin-right:11px;">
                    <label>@TextResources.APP_StringKeys_Expire_Type</label>
                    <TelerikDropDownList Data="GuaranteeItems"
                                         TextField="@(nameof(TelerikDropDownItemGeneric<GuaranteeTypes>.Name))"
                                         ValueField="@(nameof(TelerikDropDownItemGeneric<GuaranteeTypes>.Value))"
                                         @bind-Value="Command.ExpireType"
                                         Width="250px"
                                         Class="drop-all">
                    </TelerikDropDownList>
                    @if (Command.ExpireType == GuaranteeTypes.Date)
                    {
                        <label>@TextResources.APP_StringKeys_ToDate</label>
                        <DatePicker @bind-Value="Command.ExpireDate">
                        </DatePicker>
                    }
                    else
                    {
                        <label>@TextResources.APP_StringKeys_ExpireAndGuarantee_ExpireDays</label>
                        <TelerikNumericTextBox @bind-Value="Command.ExpireMonths"
                                               Width="100px">
                        </TelerikNumericTextBox>
                        <label>@TextResources.APP_StringKeys_Month</label>
                    }
                </div>
                <div class="form-group form-inline  search-button-div" style="margin-top:-136px !important;width:480px;">
                    <button type="button"
                            class="btn btn-warning"
                            @onclick="OnClearClick"
                            style="margin-right: 10px">
                        <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                    </button>
                    <button type="submit"
                            class="btn btn-primary"
                            style="margin-right: 5px">
                        <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<Modal Buttons="ModalButtons.No"
       ModalTitle="@TextResources.APP_StringKeys_Filters"
       @ref="FiltersModal"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            @if (FiltersModal.ModalClass.Equals("Show"))
            {
                <FilterReportSelectSection Filters="Filters" OnSearchClick="OnAddNewFilterClick">
                </FilterReportSelectSection>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>