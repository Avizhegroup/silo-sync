@page "/product/addactiontype"
@using Silo.Application.Features;
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Telerik.Blazor.Components
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center" style="margin-bottom:5px; padding:12px;">
        <EditForm Model="Request"
                  OnInvalidSubmit="OnInvalidSubmit"
                  OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 10px !important;">
                <label style="margin-right: 77px !important;">@TextResources.APP_StringKeys_Code</label>
                <TelerikNumericTextBox @bind-Value="Request.Code"
                                       Class="form-control input-search-span"></TelerikNumericTextBox>
                <label style="margin-right:93px;">@TextResources.APP_StringKeys_Title</label>
                <TelerikTextBox @bind-Value="Request.Title"
                                Class="form-control input-search-span"></TelerikTextBox>
                <label style="margin-right:46px;">@TextResources.APP_StringKeys_fld_ActionTypeFromDestinationType</label>
                <TelerikMultiSelect Data="@Warehouses"
                                    @bind-Value="Request.ChoosenFromWarehouseTypes"
                                    TextField="Title"
                                    ValueField="Code"
                                    width="179px"/>

                <label style="margin-right:20px;">@TextResources.APP_StringKeys_ActionTypeToTypeDestinationType</label>
                <TelerikMultiSelect Data="@Warehouses"
                                    @bind-Value="Request.ChoosenToWarehouseTypes"
                                    TextField="Title"
                                    ValueField="Code"
                                    width="179px" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right:25px;">@TextResources.APP_StringKeys_RfidPower</label>
                <TelerikNumericTextBox @bind-Value="Request.RfidPower"
                                       Class="form-control input-search-span"></TelerikNumericTextBox>
                <label style="margin-right:13px;">@TextResources.APP_StringKeys_ActionTypePermitedDocStatus</label>
                <TelerikMultiSelect Data="@DocumentStatuses"
                                    @bind-Value="Request.ChoosenDocumentPermittedStatuses"
                                    TextField="Title"
                                    ValueField="Id"
                                    width="179px" />
                <label style="margin-right:11px;">@TextResources.APP_StringKeys_ActionTypeChangeDocStatus</label>
                <TelerikMultiSelect Data="@DocumentStatuses"
                                    @bind-Value="Request.ChoosenDocumentChangeStatuses"
                                    TextField="Title"
                                    ValueField="Id"
                                    width="179px" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important; margin-top:8px;">
                <label style="margin-right:21px;">@TextResources.APP_StringKeys_ActionControls</label>
                <button type="button"
                        class="btn btn-light"
                        @onclick="OnActionControlsModalOpen">
                    @GetActionControlsText()
                    <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
                </button>
            </div>

            <div style="left:12px; top:92px; position:absolute;">
                <button type="button"
                        class="btn btn-light"
                        @onclick="OnOpenModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
                </button>
                <button type="button"
                        class="btn btn-danger"
                        @onclick="OnRemoveClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Delete"></MaterialIcon>
                </button>
                <button type="button"
                        class="btn btn-warning"
                        @onclick="OnRefreshClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button type="submit"
                        class="btn btn-primary">
                    <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
                </button>
            </div>


        </EditForm>

    </div>
</div>


<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
       @ref="ModalAction"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @if (ActionTypes is not null)
            {
                <TelerikGrid Data="ActionTypes"
                             PageSize="5"
                             Navigable="true"
                             Pageable="true"
                             FilterMode="@GridFilterMode.FilterRow"
                             Sortable="true">
                    <RowTemplate Context="actiontype">
                        <td class="td-style td-dt">@actiontype.Code</td>
                        <td class="td-style td-dt">@actiontype.Title</td>
                        <td class="td-style td-dt">
                            <button @onclick="async () => await OnSelectType(actiontype)"
                                    type="button" class="btn btn-success tr-buttom">
                                @TextResources.APP_StringKeys_Choose
                            </button>
                        </td>
                    </RowTemplate>
                    <GridColumns>
                        <GridColumn Field="@nameof(GetAllActionTypesDto.Code)"
                                    Title="@TextResources.APP_StringKeys_OperationCode"></GridColumn>
                        <GridColumn Field="@nameof(GetAllActionTypesDto.Title)"
                                    Title="@TextResources.APP_StringKeys_ActionType"></GridColumn>
                        <GridColumn></GridColumn>
                    </GridColumns>

                </TelerikGrid>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
       @ref="ModalMessage"
       Size="ModalSize.Normal"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @MessageText
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.Close"
       @ref="ModalActionControls"
       ModalTitle="@TextResources.APP_StringKeys_ActionControls"
       CloseBtnText="@TextResources.APP_StringKeys_Choose"
       CloseBtnClass="btn-primary"
       OnCloseModal="OnActionControlsModalClose"
       Size="ModalSize.Large">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @if (ActionControls is not null)
            {
                <TelerikGrid Data="ActionControls"
                             PageSize="10"
                             Navigable="true"
                             Pageable="true"
                             Sortable="true">
                    <RowTemplate Context="control">
                        <td class="td-style">
                            <TelerikCheckBox @bind-Value="control.IsChoosen"></TelerikCheckBox>
                        </td>
                        <td class="td-style">@control.Code</td>
                        <td class="td-style">@control.Name</td>
                    </RowTemplate>
                    <GridColumns>
                        <GridCheckboxColumn Visible="true"
                                            Width="30px"
                                            HeaderClass="header-select-all">
                            <HeaderTemplate>
                                @{
                                    <TelerikCheckBox @bind-Value="@IsAllActionControlsChoosen"
                                                     OnChange="() => ActionControls.ForEach(p => p.IsChoosen = IsAllActionControlsChoosen)" />
                                }
                            </HeaderTemplate>
                        </GridCheckboxColumn>
                        <GridColumn Field="@nameof(GetAllActionTypeControlsDto.Code)"></GridColumn>
                        <GridColumn Field="@nameof(GetAllActionTypeControlsDto.Name)"></GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>
