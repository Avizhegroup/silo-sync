@page "/product/adddestinationtype"
@using Silo.Application.Features;
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Silo.Application.Shared.Features
@using Telerik.Blazor.Components
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center" style="margin-bottom:5px; padding:12px;">
        <EditForm Model="Request"
                  OnInvalidSubmit="OnInvalidSubmit"
                  OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 10px !important;">
                <label style="margin-right: 20px !important;">@TextResources.APP_StringKeys_Code</label>
                <TelerikTextBox @bind-Value="Request.Code"
                                       Class="form-control input-search-span"></TelerikTextBox>
                <label style="margin-right:93px;">@TextResources.APP_StringKeys_Title</label>
                <TelerikTextBox @bind-Value="Request.Title"
                                Class="form-control input-search-span"></TelerikTextBox>
            </div>

            <div style="left:12px; top:10px; position:absolute;">
                <button type="button"
                        class="btn btn-light"
                        @onclick="OnOpenModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
                </button>
                <button type="button"
                        class="btn btn-danger"
                        @onclick="OnRemoveClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Delete"></MaterialIcon>
                </button>
                <button type="button"
                        class="btn btn-warning"
                        @onclick="OnRefreshClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button type="submit"
                        class="btn btn-primary">
                    <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
                </button>
            </div>

        </EditForm>

    </div>
</div>


<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
       @ref="ModalAction"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @if (DestinationTypes is not null)
            {
                <TelerikGrid Data="DestinationTypes"
                             PageSize="10"
                             Navigable="true"
                             Pageable="true"
                             FilterMode="@GridFilterMode.FilterRow"
                             Sortable="true">
                    <RowTemplate Context="destinationtype">
                        <td class="td-style td-dt">@destinationtype.Code</td>
                        <td class="td-style td-dt">@destinationtype.Title</td>
                        <td class="td-style td-dt">
                            <button @onclick="async () => await OnSelectType(destinationtype)"
                                    type="button" class="btn btn-success tr-buttom">
                                @TextResources.APP_StringKeys_Choose
                            </button>
                        </td>
                    </RowTemplate>
                    <GridColumns>
                        <GridColumn Field="@nameof(GetAllDestinationTypeDto.Code)"
                                    Title="@TextResources.APP_StringKeys_Code"></GridColumn>
                        <GridColumn Field="@nameof(GetAllDestinationTypeDto.Title)"
                                    Title="@TextResources.APP_StringKeys_Title"></GridColumn>
                        <GridColumn></GridColumn>
                    </GridColumns>

                </TelerikGrid>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
       @ref="ModalMessage"
       Size="ModalSize.Normal"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @MessageText
        </div>
    </ModalBodyContentHtml>
</Modal>