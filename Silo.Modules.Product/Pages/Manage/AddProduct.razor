                                    Width="70px"></GridColumn>
                        <GridColumn Width="50px"></GridColumn>
                    </GridColumns>
                    <DetailTemplate>
                        @{
                            ExcelProductDto casted = context as ExcelProductDto;

                            <h6>
                                @TextResources.APP_StringKeys_Product_Add_Properties
                            </h6>
                            <div>
                                <label>@TextResources.APP_StringKeys_ProductCode :</label>
                                <label>@casted.ProductCode |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_Chart_Regcode :</label>
                                <label>@casted.ProductTechnicalCode |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductType :</label>
                                <label>@casted.ProductTechnicalCode |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_Product_Group :</label>
                                <label>@casted.ProductGroup |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_Product_Brand :</label>
                                <label>@casted.ProductBrand |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_Product_Size :</label>
                                <label>@casted.ProductSize |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_Chart_Qc :</label>
                                <label>@casted.ProductStatus |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductUnit :</label>
                                <label>@casted.ProductUnit |</label>
                                <div>
                                    <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductTitle :</label>
                                    <label>@casted.ProductTitle |</label>
                                    <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductENTitle :</label>
                                    <label>@casted.ProductENTitle |</label>
                                </div>
                            </div>
                            <h6>
                                @TextResources.APP_StringKeys_Product_Add_Tags_Properties
                            </h6>
                            <div>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductCount :</label>
                                <label>@casted.ProductPackValue |</label>
                                <label style="margin-right: 5px !important;">@TextResources.APP_StringKeys_ProductValue :</label>
                                <label>@casted.ProductValue |</label>
