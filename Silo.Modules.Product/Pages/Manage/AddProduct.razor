                        <GridColumn Field="@nameof(ExcelProductDto.ProductType)"
                                    Title="@TextResources.APP_StringKeys_ProductType"
                                    Width="70px"></GridColumn>
                        <GridColumn Field="@nameof(ExcelProductDto.ProductGroup)"
