@page "/product/addproducttype"
@using Silo.Application.Features;
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Telerik.Blazor.Components
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<div class="card card-stats col-md-12 text-align-center" style="margin-top:5px; padding: 10px">
    <form asp-action="Search" asp-controller="Home" method="post" role="form" class="form-search-span" id="form-main">
        <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
            <label style="margin-right: 13px !important;">@TextResources.APP_StringKeys_ProductTypeCode :</label>
            <input @bind-value="Request.Code" type="text" style="width: 130px !important;" class="form-control input-search-span-lg pointer" />
        </div>
        <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
            <label style="margin-right: 0px !important;">@TextResources.APP_StringKeys_ProductTypeTitle :</label>
            <input @bind-value="Request.Title" type="text" style="width: 360px !important;" class="form-control input-search-span-lg pointer" />
        </div>
        <div class=" d-flex flex-row align-items-center flex-wrap save-button-div" style="margin-top: -35px;">
            <button type="button"
                    id="btn-search"
                    class="btn btn-secondary"
                    @onclick="async(e)=> await ModalDetails.Open(e)">
                <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
            </button>
            <button id="btn-clear" class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                    style="margin-left: 2px;margin-right: 2px;" @onclick="()=> Request = new()">
                <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
            </button>
            <button type="button"
                    @onclick="OnSaveProductType"
                    class="btn btn-primary"
                    title="@TextResources.APP_StringKeys_Send">
                <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
            </button>
        </div>
    </form>
</div>

<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
@ref="ModalDetails"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            <TelerikGrid Data="ProductTypes"
                         PageSize="5"
                         Navigable="true"
                         Pageable="true"
                         FilterMode="@GridFilterMode.FilterRow"
                         Sortable="true">
                <RowTemplate Context="type">
                    <td class="td-style td-dt">@type.Code</td>
                    <td class="td-style td-dt">@type.Title</td>
                    <td class="td-style td-dt">
                        <button @onclick="async ()=> await OnSelectType(type)"
                                class="btn-dt-1 btn-success tr-buttom btn">
                            @TextResources.APP_StringKeys_Choose
                        </button>
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GetAllProductTypeVm.Code)"
                                Title="@TextResources.APP_StringKeys_Chart_ProductCode"></GridColumn>
                    <GridColumn Field="@nameof(GetAllProductTypeVm.Title)"
                                Title="@TextResources.APP_StringKeys_ProductSerial"></GridColumn>
                    <GridColumn></GridColumn>
                </GridColumns>

            </TelerikGrid>
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
@ref="ModalMessage"
       Size="ModalSize.Normal"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @MessageText
        </div>
    </ModalBodyContentHtml>
</Modal>