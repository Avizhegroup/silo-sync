@page "/tag/transfer"
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using Silo.Modules.Product.Components
@using Silo.Shared.Components
@using Telerik.Blazor.Components
@using Silo.Components.DynamicField
@using Microsoft.AspNetCore.Components.Web
@using Silo.Shared.Components.Modals
@using Silo.Shared.Components.Print

<PageTitle>@PageTitle</PageTitle>
<div class="row col-md-12">
    @if (IsFiltersShown)
    {
        <TagFilterBar OnSerialSelected="OnSourceSerialSelected"
                      OnClear="OnFilterClear" />
    }
    @if (SourceProductInfos.Any())
    {
        <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
            <div class="form-search-span" style="padding-top:10px;">
                <div class=" d-flex flex-row align-items-center flex-wrap gap-2" style=" margin-top:5px; margin-right:15px; margin-bottom:10px;">
                    <div class="card-header">
                        <h6 class="card-title mb-0 text-center">
                            @TextResources.APP_StringKeys_Info
                        </h6>
                    </div>
                    <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:7px !important;">@TextResources.APP_StringKeys_ProductName :</label>
                        <input readonly="readonly" type="text" value="@SourceProductInfos[0].ProductName" style=" width: 400px !important;" class="form-control input-search-span-lg pointer" />
                    </div>
                    <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:12px !important;">@TextResources.APP_StringKeys_ProductSerial :</label>
                        <input readonly="readonly" type="text" value="@SourceProductInfos[0].ProductSerial" style=" width: 200px !important;" class="form-control input-search-span-lg pointer" />
                    </div>
                    <button type="button" class="btn btn-warning btn-sm" @onclick="OnClearClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                    </button>
                </div>
            </div>
        </div>
        <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right:61px !important;">@TextResources.APP_StringKeys_ProductCode :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].ProductCode"
                       style=" width: 140px !important;" class="form-control input-search-span-lg pointer" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right:26px !important;">@TextResources.APP_StringKeys_TagEPC :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].TagEpc" style="width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 75px!important;">@TextResources.APP_StringKeys_Warehouse :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].Warehouse" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 55px!important;">@TextResources.APP_StringKeys_Zone :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].TagZone" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 69px!important;">@TextResources.APP_StringKeys_ProductCount :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].ProductCount" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 29px;">@TextResources.APP_StringKeys_TagAge :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].ProductAge" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 22px;">@TextResources.APP_StringKeys_Freeze_Status :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].FreezeStatus" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 77px;">@TextResources.APP_StringKeys_User :</label>
                <input readonly="readonly" type="text" value="@SourceProductInfos[0].RegisterUserName" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
        </div>
        @if (DynamicFieldDtos.Any())
        {
            <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
                <div class="card-header">
                    <h6 class="card-title mb-0 text-center">
                        @TextResources.APP_StringKeys_Dynamic_Fields
                    </h6>
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <DynamicFieldFillValue @ref="DynamicFieldRef"
                                           DynamicFieldsDto="DynamicFieldDtos">
                    </DynamicFieldFillValue>
                </div>
            </div>
        }
        <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
            <div class="card-header">
                <h6 class="card-title mb-0 text-center">
                    تنظیمات انتقال
                </h6>
            </div>
            <div class="d-flex flex-row align-items-center flex-wrap gap-3" style="margin-top:10px; margin-bottom:10px;">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" id="modeNew" name="transferMode"
                           checked="@(TransferMode == TransferCountTagModes.NewSerial)"
                           @onchange="() => OnTransferModeChanged(TransferCountTagModes.NewSerial)" />
                    <label class="form-check-label" for="modeNew">@TextResources.APP_StringKeys_New</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" id="modeExisting" name="transferMode"
                           checked="@(TransferMode == TransferCountTagModes.ExistingSerial)"
                           @onchange="() => OnTransferModeChanged(TransferCountTagModes.ExistingSerial)" />
                    <label class="form-check-label" for="modeExisting">موجود</label>
                </div>
            </div>
            @if (TransferMode == TransferCountTagModes.ExistingSerial)
            {
                <div class="d-flex flex-row align-items-center flex-wrap gap-2" style="margin-bottom:10px;">
                    <label style="margin-right:7px !important;">@TextResources.APP_StringKeys_ProductSerial :</label>
                    <input @bind-value="DestinationSerial"
                           @bind-value:event="oninput"
                           type="text"
                           class="form-control input-search-span-lg pointer"
                           style="width: 200px !important;" />
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OnSearchDestinationClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                    </button>
                    <button type="button" class="btn btn-light btn-sm" @onclick="async () => await DestinationModal.Open()">
                        <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
                    </button>
                </div>
                @if (DestinationProductInfos.Any())
                {
                    <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:7px !important;">@TextResources.APP_StringKeys_ProductName :</label>
                        <input readonly="readonly" type="text" value="@DestinationProductInfos[0].ProductName" style="width: 400px !important;" class="form-control input-search-span-lg pointer" />
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:61px !important;">@TextResources.APP_StringKeys_ProductCode :</label>
                        <input readonly="readonly" type="text" value="@DestinationProductInfos[0].ProductCode" style="width: 140px !important;" class="form-control input-search-span-lg pointer" />
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right: 69px!important;">@TextResources.APP_StringKeys_ProductCount :</label>
                        <input readonly="readonly" type="text" value="@DestinationProductInfos[0].ProductCount" class="form-control input-search-span-lg" style="width: 140px !important;" />
                    </div>
                }
            }
            <div class="d-flex flex-row align-items-center flex-wrap gap-2" style="margin-top:10px; margin-bottom:10px;">
                <label style="margin-right:7px !important;">@TextResources.APP_StringKeys_Count :</label>
                <input @bind-value="TransferQuantityText"
                       @bind-value:event="oninput"
                       type="number"
                       min="1"
                       class="form-control input-search-span-lg pointer"
                       style="width: 140px !important;" />
                <button type="button" class="btn btn-primary btn-sm" @onclick="OnExecuteTransferClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
                </button>
            </div>
        </div>
        @if (TransferResult is not null)
        {
            <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px; border: 2px solid #28a745;">
                <div class="card-header">
                    <h6 class="card-title mb-0 text-center text-success">
                        @TextResources.APP_StringKeys_Alert_Success
                    </h6>
                </div>
                <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important; margin-top:10px;">
                    <label style="margin-right:12px !important; font-weight:bold;">@TextResources.APP_StringKeys_ProductSerial @TextResources.APP_StringKeys_From :</label>
                    <input readonly="readonly" type="text" value="@TransferResult.SourceSerial" style="width: 200px !important;" class="form-control input-search-span-lg pointer" />
                </div>
                <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right:12px !important; font-weight:bold;">@TextResources.APP_StringKeys_ProductSerial @TextResources.APP_StringKeys_Destination :</label>
                    <input readonly="readonly" type="text" value="@TransferResult.DestinationSerial" style="width: 200px !important;" class="form-control input-search-span-lg pointer" />
                </div>
                <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right:61px !important; font-weight:bold;">@TextResources.APP_StringKeys_ProductCode :</label>
                    <input readonly="readonly" type="text" value="@TransferResult.ProductCode" style="width: 140px !important;" class="form-control input-search-span-lg pointer" />
                </div>
                <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right:235px !important; font-weight:bold;">@TextResources.APP_StringKeys_ProductName :</label>
                    <input readonly="readonly" type="text" value="@TransferResult.ProductName" style="width: 400px !important;" class="form-control input-search-span-lg pointer" />
                </div>
                <div class="d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right:175px !important; font-weight:bold;">@TextResources.APP_StringKeys_Count :</label>
                    <input readonly="readonly" type="text" value="@TransferResult.TransferredQuantity" style="width: 140px !important;" class="form-control input-search-span-lg pointer" />
                </div>
                <div style="margin-right:15px;">
                    <button type="button"
                            class="btn btn-sm btn-success"
                            @onclick="async e => await SelectPrintFormatRef.ShowPrintFormatsAsync(e)">
                        <MaterialIcon IconName="print"></MaterialIcon>
                    </button>
                </div>
            </div>
        }
    }
</div>
<CascadingValue Value="Notification">
    <ProductSerialModal @ref="DestinationModal"
                        MultiSelect="false"
                        OnSelectSerials="OnDestinationSerialsSelected">
    </ProductSerialModal>
</CascadingValue>
<CascadingValue Value="IsLoading">
    <CascadingValue Value="Notification">
        <SelectPrintFormat @ref="SelectPrintFormatRef"
                           OnFileNameSelect="OnPrintActionClick">
        </SelectPrintFormat>
    </CascadingValue>
</CascadingValue>
<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>
