@page "/tag/edit"
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using Silo.Modules.Product.Components
@using Newtonsoft.Json.Linq
@using Silo.Shared.Components
@using Telerik.Blazor.Components
@using Silo.Components.DynamicField
@using Silo.Application.Dto.DynamicField
@using Silo.Shared.Components.Print
@using Silo.Application.Dto
@using Silo.Application.Features
@using Microsoft.AspNetCore.Components.Web
@using Silo.Shared.Components.Modals
@using Telerik.Blazor.Components.Grid


<div class="row col-md-12">
    @if (IsFiltersShown)
    {
        <TagFilterBar OnSerialSelected="OnSerialSelected"
                      OnClear="OnFilterClear" />
    }

    @if (ProductInfos.Any())
    {
        <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
            <div class="form-search-span" style="padding-top:10px;">
                <div class=" d-flex flex-row align-items-center flex-wrap gap-2" style=" margin-top:5px; margin-right:15px; margin-bottom:10px;">

                    <div class="card-header">
                        <h6 class="card-title mb-0 text-center">
                            @TextResources.APP_StringKeys_Info
                        </h6>
                    </div>
                    <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:7px !important;">@TextResources.APP_StringKeys_ProductName :</label>
                        <input readonly="readonly" type="text" value="@ProductInfos[0].ProductName" style=" width: 400px !important;" class="form-control input-search-span-lg pointer" />
                    </div>
                    <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                        <label style="margin-right:12px !important;">@TextResources.APP_StringKeys_ProductSerial :</label>
                        <input readonly="readonly" type="text" value="@ProductInfos[0].ProductSerial" style=" width: 200px !important;" class="form-control input-search-span-lg pointer" />
                    </div>

                    <button class="btn btn-sm btn-primary" style="margin-right:12px;" @onclick="OnSaveClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Save" />
                    </button>

                    <button type="button" class="btn btn-warning btn-sm"  @onclick="OnClearClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            @onclick="async e => await SelectPrintFormatRef.ShowPrintFormatsAsync(e)">
                        <MaterialIcon IconName="print"></MaterialIcon>
                    </button>

                    <button class="btn btn-success btn-sm" @onclick="OnOpenGallery">
                        <MaterialIcon IconName="photo_library" />
                    </button>
                </div>
            </div>
        </div>
        <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
            <label style="margin-right:61px !important;">@TextResources.APP_StringKeys_ProductCode :</label>
            <input readonly="readonly" type="text" value="@ProductInfos[0].ProductCode"
                   style=" width: 140px !important;" class="form-control input-search-span-lg pointer" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right:26px !important;">@TextResources.APP_StringKeys_TagEPC :</label>
                <input readonly="readonly" type="text" value="@ProductInfos[0].TagEpc" style="width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
            </div>          
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right: 75px!important;">@TextResources.APP_StringKeys_Warehouse :</label>
                    <input readonly="readonly" type="text" value="@ProductInfos[0].Warehouse" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    <label style="margin-right: 55px!important;">@TextResources.APP_StringKeys_Zone :</label>
                    <input readonly="readonly" type="text" value="@ProductInfos[0].TagZone" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 69px!important;">@TextResources.APP_StringKeys_ProductCount :</label>
                <input readonly="readonly" type="text" value="@ProductInfos[0].ProductCount" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 29px;">@TextResources.APP_StringKeys_TagAge :</label>
                <input readonly="readonly" type="text" value="@ProductInfos[0].ProductAge" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 22px;">@TextResources.APP_StringKeys_Freeze_Status :</label>
                <input readonly="readonly" type="text" value="@ProductInfos[0].FreezeStatus" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                <label style="margin-right: 77px;">@TextResources.APP_StringKeys_User :</label>
                <input readonly="readonly" type="text" value="@ProductInfos[0].RegisterUserName" class="form-control input-search-span-lg" style="    width: 140px !important;" />
            </div>
        </div>
        @if (ProductProperties is not null)
        {
            <div class="card card-stats col-md-12 text-align-center" style="margin-top: 5px; flex-flow:wrap; padding:20px;">
                <div class="card-header">
                    <h6 class="card-title mb-0 text-center">
                        @TextResources.APP_StringKeys_Dynamic_Fields
                    </h6>
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                    @if (DynamicFieldDtos.Any())
                    {
                        <DynamicFieldFillValue @ref="DynamicFieldRef"
                                               DynamicFieldsDto="DynamicFieldDtos">
                        </DynamicFieldFillValue>
                    }
                </div>
            </div>
        }
    }
</div>

<CascadingValue Value="IsLoading">
    <CascadingValue Value="Notification">
        <SelectPrintFormat @ref="SelectPrintFormatRef"
                           OnFileNameSelect="OnPrintActionClick">
        </SelectPrintFormat>
    </CascadingValue>
</CascadingValue>
<CascadingValue Value="Notification">
    <Gallery @ref="GalleryRef"
             AllowedExtensions="image/png, image/jpeg, application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    </Gallery>
</CascadingValue>
<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>