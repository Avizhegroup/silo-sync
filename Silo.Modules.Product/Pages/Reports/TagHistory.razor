@page "/report/taghistory"
@page "/report/taghistory/{productserial?}"
@inherits SiloBasePage
@namespace Silo.Modules.Product.Pages
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Newtonsoft.Json.Linq;
@using Silo.Application.Features;
@using Silo.Modules.Product.Components
@using Silo.Shared.Components
@using Silo.Shared.Components.Print
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>
<div class="row col-md-12">
    @if (IsFiltersShown)
    {
        <TagFilterBar OnSerialSelected="OnSerialSelected"
                      OnClear="OnFilterClear" />
    }
    @if (TimeLine.Any())
    {
        <div class="card card-stats col-md-4 text-align-center" style="margin-top: 5px; flex-direction:row; padding:20px; margin-right:0px;margin-left:0px;">
            <div>
                <TelerikStepper Linear="false" Orientation="@StepperOrientation.Vertical" StepType="@StepperStepType.Steps" @bind-Value="ActiveStepperIndex">
                    <StepperSteps>
                        @foreach (var tagEvent in TimeLine)
                        {
                            <StepperStep Class="telerik-stepper-label">
                                <Template>
                                    <button class="btn @tagEvent.Color" @onclick="async () => await OnStepperChanged(tagEvent.TagEventType)">
                                        <MaterialIcon IconName="@tagEvent.Icon"></MaterialIcon>
                                    </button>
                                    <div style="margin-right:5px; flex-direction:column; display:flex;" @onclick="async () => await OnStepperChanged(tagEvent.TagEventType)">
                                        <span style="margin-bottom: 4px;">
                                            <b>
                                                @tagEvent.TagEventDescription
                                            </b>
                                        </span>
                                        <span class="btn @tagEvent.Color badge" style="float:right; width: fit-content; direction:ltr;">
                                            @if (tagEvent.TagEventType == TagEventType.Revoke)
                                            {
                                                @tagEvent.TagEventDateTimeShamsi
                                            }
                                            else
                                            {
                                                @(PersianCalendarTools.GregorianToPersian(tagEvent.TagEventDateTime) + " " +
                                                                                    tagEvent.TagEventDateTime.ToShortTimeString())
                                            }
                                        </span>
                                    </div>
                                </Template>
                            </StepperStep>
                        }
                        <StepperStep Class="telerik-stepper-label">
                            <Template>
                                <button class="btn btn-info">
                                    <MaterialIcon IconName="@MaterialIconsHelper.Start"></MaterialIcon>
                                </button>
                                <div style="margin-right:5px; flex-direction:column; display:flex;">
                                    <span style="margin-bottom: 4px;">
                                        <b>
                                            شروع
                                        </b>
                                    </span>
                                </div>
                            </Template>
                        </StepperStep>

                    </StepperSteps>
                </TelerikStepper>
            </div>
        </div>
        <div class="card card-stats col-md-8 text-align-center" style="margin-top: 5px; margin-right:0px;margin-left:0px;">
            <TelerikTabStrip ActiveTabIndex="@ActiveTabIndex" 
                             ActiveTabIndexChanged="@OnTabChanged">
                <TabStripTab Title="@TextResources.APP_StringKeys_Tag_Cargo">
                    @if (ProductInfos.Any())
                    {
                        <div class="card card-stats text-align-center" style="margin-top: 5px; flex-flow:wrap;">
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right:65px !important;">@TextResources.APP_StringKeys_ProductSerial :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductSerial" style=" width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right:34px !important;">سریال قبلی :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].OldProductSerial" style="width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right:27px !important;">@TextResources.APP_StringKeys_TagEPC :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].TagEpc" style="width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
                            </div>

                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_TagStatus :</label>
                                <input readonly="readonly" type="text"
                                       @bind-value="ProductInfos[0].TagStatusTitle"
                                       style="width: 140px !important;" class="form-control input-search-span-lg pointer" />
                            </div>
                            @if (ProductInfos[0].TagStatus.Equals("1"))
                            {
                                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                    <label style="margin-right: 75px!important;">@TextResources.APP_StringKeys_Warehouse :</label>
                                    <input readonly="readonly" type="text" @bind-value="ProductInfos[0].Warehouse" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                                </div>
                                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                    <label style="margin-right: 55px!important;">@TextResources.APP_StringKeys_Zone :</label>
                                    <input readonly="readonly" type="text" @bind-value="ProductInfos[0].TagZone" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                                </div>
                            }
                            else
                            {
                                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                    <label style="margin-right: 75px!important;">@TextResources.APP_StringKeys_Warehouse :</label>
                                    <input readonly="readonly" type="text" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                                </div>
                                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                    <label style="margin-right: 55px!important;">@TextResources.APP_StringKeys_Zone :</label>
                                    <input readonly="readonly" type="text" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                                </div>
                            }
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 69px!important;">@TextResources.APP_StringKeys_ProductCount :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductCount" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 46px;">@TextResources.APP_StringKeys_ProductValue :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductValue" style="    width: 140px !important;" class="form-control input-search-span-lg" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 13px;">@TextResources.APP_StringKeys_ProductSumCountInPack :</label>
                                <input readonly="readonly" type="text" @bind-value="@ProductInfos[0].ProductCountInPack" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 30px;">@TextResources.APP_StringKeys_ProductPackWeight :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductPackWeight" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 26px;">@TextResources.APP_StringKeys_ProductPackVolume :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductPackVolume" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 31px;">@TextResources.APP_StringKeys_TagAge :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductAge" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 41px;">@TextResources.APP_StringKeys_TagAgeAnalyse :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].ProductAgeAnalysis" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 21px;">@TextResources.APP_StringKeys_Inspect_LastResult :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].LastInspectResult" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 29px;">@TextResources.APP_StringKeys_Freeze_Status :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].FreezeStatus" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 73px;">@TextResources.APP_StringKeys_User :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].RegisterUserName" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                            <div class="d-flex flex-row" style="margin-right: 5px;">
                                <button class="btn btn-secondary" @onclick="async () => await OnOpenGallery()">
                                    <MaterialIcon IconName="photo_library"></MaterialIcon>
                                </button>
                            </div>
                            <div class="d-flex flex-row" style="margin-right: 5px;">
                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="async e => await SelectPrintFormatRef.ShowPrintFormatsAsync(e)">
                                    <MaterialIcon IconName="print"></MaterialIcon>
                                </button>
                            </div>
                        </div>
                        <div class="card card-stats text-align-center" style="margin-top: 5px; flex-flow:wrap;">
                            <h6 class="form-title card-title" style="text-align: center !important;">
                                @TextResources.APP_StringKeys_OtherInformation
                            </h6>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                @if (ProductProperties is not null)
                                {
                                    @foreach (JProperty item in ProductProperties)
                                    {
                                        <span class="tech-item" style="margin-left:10px">
                                            <label>@item.Name</label>
                                            <input type="text" readonly class="form-control input-search-span" value="@item.Value" style="width:200px!important;" />
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (RelatedTags.Any())
                    {
                        <div class="card card-stats text-align-center" style="margin-top: 5px; flex-flow:wrap;">
                            <h6 class="form-title card-title" style="text-align: center !important;">
                                تگ‌های مرتبط (والد و فرزند)
                            </h6>
                            <div class="text-align-center">
                                <TelerikGrid Data="RelatedTags"
                                             PageSize="10"
                                             Navigable="true"
                                             Pageable="true"
                                             Sortable="true">
                                    <RowTemplate Context="related">
                                        <td class="td-style td-dt">@related.RelationType</td>
                                        <td class="td-style td-dt">@related.ProductSerial</td>
                                        <td class="td-style td-dt">@related.TagEpc</td>
                                        <td class="td-style td-dt">@related.ProductName</td>
                                        <td class="td-style td-dt">@related.ProductCode</td>
                                        <td class="td-style td-dt">@related.ProductCount</td>
                                        <td class="td-style td-dt">@related.TagStatusTitle</td>
                                        <td class="td-style td-dt">@related.RegisterDate</td>
                                    </RowTemplate>
                                    <GridColumns>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.RelationType)"
                                                    Title="نوع رابطه"
                                                    Width="70px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.ProductSerial)"
                                                    Title="@TextResources.APP_StringKeys_ProductSerial"
                                                    Width="120px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.TagEpc)"
                                                    Title="@TextResources.APP_StringKeys_TagEPC"
                                                    Width="120px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.ProductName)"
                                                    Title="@TextResources.APP_StringKeys_ProductTitle"
                                                    Width="150px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.ProductCode)"
                                                    Title="@TextResources.APP_StringKeys_ProductCode"
                                                    Width="100px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.ProductCount)"
                                                    Title="@TextResources.APP_StringKeys_ProductCount"
                                                    Width="80px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.TagStatusTitle)"
                                                    Title="@TextResources.APP_StringKeys_TagStatus"
                                                    Width="100px"></GridColumn>
                                        <GridColumn Field="@nameof(GetTagRelatedTagsVm.RegisterDate)"
                                                    Title="@TextResources.APP_StringKeys_Date"
                                                    Width="100px"></GridColumn>
                                    </GridColumns>
                                </TelerikGrid>
                            </div>
                        </div>
                    }
                </TabStripTab>
                <TabStripTab Title="@TextResources.APP_StringKeys_Product_Add_Properties">
                    @if (ProductInfos.Any())
                    {
                        <div class="card card-stats text-align-center" style="height:235px;">
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 31px !important;">@TextResources.APP_StringKeys_ProductCode :</label>
                                <input readonly="readonly" id="ProductCode" type="text" name="ProductCode" @bind-value="ProductInfos[0].ProductCode" style="    width: 150px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 35px !important;">@TextResources.APP_StringKeys_Chart_Regcode :</label>
                                <input readonly="readonly" id="ProductTechnicalCode" type="text" name="ProductTechnicalCode" @bind-value="ProductInfos[0].RegCode" style="width: 110px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 17px !important;">@TextResources.APP_StringKeys_ProductType :</label>
                                <input readonly="readonly" id="ProductType" type="text" name="ProductType" @bind-value="ProductInfos[0].ProductTypeTitle" style="width: 135px !important;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap " style="margin-bottom: 2px !important;">
                                <label style="margin-right: 12px !important;">@TextResources.APP_StringKeys_ProductTitle :</label>
                                <input readonly="readonly" id="ProductTitle" type="text" name="ProductTitle" @bind-value="ProductInfos[0].ProductName" class="form-control input-search-span-xxslg pointer" style="    width: 563px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label>@TextResources.APP_StringKeys_ProductENTitle :</label>
                                <input readonly="readonly" id="ProductENTitle" type="text" name="ProductENTitle" @bind-value="ProductInfos[0].ProductENTitle" class="form-control input-search-span-xxslg pointer" style="width:563px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 20px !important;">@TextResources.APP_StringKeys_Product_Size :</label>
                                <input readonly="readonly" id="ProductSize" type="text" name="ProductSize" @bind-value="ProductInfos[0].ProductSize" style="width: 150px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 4px !important;">@TextResources.APP_StringKeys_Chart_Qc :</label>
                                <input readonly="readonly" id="ProductStatus" type="text" name="ProductStatus" @bind-value="ProductInfos[0].ProductStatusTitle" style="width: 108px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 17px;">@TextResources.APP_StringKeys_ProductUnit :</label>
                                <input readonly="readonly" id="ProductUnit" type="text" name="ProductUnit" @bind-value="ProductInfos[0].ProductUnit" class="form-control input-search-span-lg" style="width: 135px !important;" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: unset;">
                                <label style="margin-right: 20px !important;">@TextResources.APP_StringKeys_ProductGroup :</label>
                                <input readonly="readonly" id="ProductSize" type="text" name="ProductSize" @bind-value=" ProductInfos[0].ProductGroup" style="width: 150px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 13px !important;">@TextResources.APP_StringKeys_Product_SubGroup :</label>
                                <input readonly="readonly" id="ProductSize" type="text" name="ProductSize" @bind-value=" ProductInfos[0].ProductSubGroup" style="width: 108px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 23px !important;">@TextResources.APP_StringKeys_ProductBrand :</label>
                                <input readonly="readonly" id="ProductStatus" type="text" name="ProductStatus" @bind-value="ProductInfos[0].ProductBrand" style="width: 134px !important;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-right: 680px;margin-top: -196px;">
                                @if (ProductInfos[0].ProductGalleryId == 0)
                                {
                                    <img id="img-product" width="180" height="180" src="/images/Utilities/Product_pic_2.png" style="margin-right:-40px;margin-top: -30px;">
                                }
                                else
                                {
                                    <img id="img-product" width="180" height="180" src="@ProductInfos[0].ImageBase64" style="margin-right:-40px;margin-top: -30px;">
                                }
                            </div>
                        </div>
                        <div class="card card-stats text-align-center">
                            <h6 class="form-title card-title" style="text-align: center !important;">
                                @TextResources.APP_StringKeys_Product_Add_TechnicalInfo
                            </h6>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 20px !important;">
                                @if (TechnicalData is not null)
                                {
                                    @foreach (JProperty item in TechnicalData)
                                    {
                                        <span class="tech-item" style="margin-left:10px">
                                            <label>@item.Name</label>
                                            <input type="text" readonly class="form-control input-search-span" value="@item.Value" style="width:200px!important;" />
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }
                </TabStripTab>
                <TabStripTab Title="@TextResources.APP_StringKeys_Product">
                    @if (ProductInfos.Any())
                    {
                        <div class="card card-stats text-align-center">
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 35px !important;">@TextResources.APP_StringKeys_Date :</label>
                                @if (!string.IsNullOrEmpty(ProductInfos[0].TagRegisterShamsiUnixDate))
                                {
                                    <input readonly="readonly" id="ProductDate" type="text" name="ProductDate" @bind-value="ProductInfos[0].TagRegisterShamsiUnixDate.ToNormalPersianDateTime().Split(' ')[0]" style="width: 90px !important;" class="form-control input-search-span-lg pointer" />
                                    <input readonly="readonly" id="ProductTime" type="text" name="ProductTime" @bind-value="ProductInfos[0].TagRegisterShamsiUnixDate.ToNormalPersianDateTime().Split(' ')[1]" style="width: 55px !important;" class="form-control input-search-span-lg pointer" />
                                }
                                else
                                {
                                    <input readonly="readonly" id="ProductDate" type="text" name="ProductDate" style="width: 90px !important;" class="form-control input-search-span-lg pointer" />
                                    <input readonly="readonly" id="ProductTime" type="text" name="ProductTime" style="width: 55px !important;" class="form-control input-search-span-lg pointer" />
                                }
                                <label style="margin-right: 10px !important;">تاریخ عملیاتی :</label>
                                <input readonly="readonly" id="ProductActionDate" type="text" name="ProductActionDate" @bind-value="ProductInfos[0].RegisterActionDate" style="width: 90px !important;" class="form-control input-search-span-lg pointer" />

                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_ProductPropertyA :</label>
                                <input readonly="readonly" id="ProductLine" type="text" name="ProductLine" @bind-value="ProductInfos[0].fld_ProductPropertyATitle" style="width: 95px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_ProductPropertyB :</label>
                                <input readonly="readonly" id="ProductShift" type="text" name="Shift" @bind-value="ProductInfos[0].fld_ProductPropertyBTitle" style="width: 95px !important;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 14px !important;">@TextResources.APP_StringKeys_RegUser :</label>
                                <input readonly="readonly" id="Username" type="text" name="Username" @bind-value="ProductInfos[0].Username" style="width: 95px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right:87px !important;">سند تولید :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].DocumentCode" style="width: 140px !important; font-size: 50%;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 111px;">@TextResources.APP_StringKeys_RegisterDevice :</label>
                                <input readonly="readonly" type="text" @bind-value="ProductInfos[0].RegisterDevice" class="form-control input-search-span-lg" style="    width: 140px !important;" />
                            </div>
                        </div>
                    }

                </TabStripTab>
                <TabStripTab Title="@TextResources.APP_StringKeys_Sales">
                    @if (Sales.Any())
                    {
                        <div class="card card-stats text-align-center">
                            <h6 class="form-title card-title" style="text-align: center !important;">
                                @TextResources.APP_StringKeys_Sales_Info
                            </h6>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 35px !important;">@TextResources.APP_StringKeys_Date :</label>
                                <input readonly="readonly" @bind-value="Sales[0].Date" style="width: 90px !important;" class="form-control input-search-span-lg pointer" />
                                <input readonly="readonly" @bind-value="Sales[0].Time" style="width: 55px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 19px !important;">@TextResources.APP_StringKeys_OperationCode :</label>
                                <input readonly="readonly" @bind-value="Sales[0].MovementActionId" style="width: 70px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_GateOpCode :</label>
                                <input readonly="readonly" @bind-value="Sales[0].GateOpCode" style="width: 70px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_TagAgeAnalyse :</label>
                                <input readonly="readonly" @bind-value="Sales[0].AgeAnalsys" style="width: 100px !important;" class="form-control input-search-span-lg pointer" />
                            </div>
                            <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom: 2px !important;">
                                <label style="margin-right: 8px !important;">@TextResources.APP_StringKeys_Description :</label>
                                <input readonly="readonly" @bind-value="Sales[0].MovementActionDesc" style="width: 100px !important;" class="form-control input-search-span-lg pointer" />
                                <label style="margin-right: 40px !important;">@TextResources.APP_StringKeys_DocCode :</label>
