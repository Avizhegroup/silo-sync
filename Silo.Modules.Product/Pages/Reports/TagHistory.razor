                                            <h6>
                                                @TextResources.APP_StringKeys_Inspect_Result_Reported_By_Inspector
                                            </h6>
                                            <div class="text-align-right">
                                                @foreach (var inspectValue in inspect.Values)
                                                {
                                                    GetAllInspectElementVm element = InspectElements.FirstOrDefault(p => p.Id == inspectValue.InspectElementId);
                                                    <div>
                                                        <label style="display: unset;">@element.Name :</label>
                                                        <label style="display: unset;">
                                                            @switch (element.InspectElementType)
                                                            {
                                                                case InspectElementType.OneOption:
                                                                    @(element.Value.Equals("true") ? TextResources.APP_StringKeys_Verified : TextResources.APP_StringKeys_Unverified)
                                                                    break;
                                                                case InspectElementType.MultiOption:
                                                                    @element.Options.FirstOrDefault(p => p == element.Value)
                                                                    break;
                                                                case InspectElementType.Int or InspectElementType.String:
                                                                    @element.Value
                                                                    break;
                                                            }
                                                        </label>
                                                    </div>
