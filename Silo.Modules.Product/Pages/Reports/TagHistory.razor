                                        <td class="td-style">@alert.StationName</td>
                                        <td class="td-style">@PersianCalendarTools.GregorianToPersian(alert.Date)</td>
                                        <td class="td-style">@alert.Time</td>
                                        <td class="td-style">@alert.Type</td>
                                        <td class="td-style">@alert.Username</td>
                                    </RowTemplate>
                                    <GridColumns>
                                        <GridColumn Field="@nameof(GetGateAlertsBySerialVm.StationName)"
                                                    Title="@TextResources.APP_StringKeys_Station"
                                                    Width="110px">
                                        </GridColumn>
                                        <GridColumn Field="@nameof(GetGateAlertsBySerialVm.Date)"
                                                    Title="@TextResources.APP_StringKeys_Date"
                                                    Width="100px">
                                        </GridColumn>
                                        <GridColumn Field="@nameof(GetGateAlertsBySerialVm.Time)"
                                                    Title="@TextResources.APP_StringKeys_Time"
                                                    Width="100px">
                                        </GridColumn>
                                        <GridColumn Field="@nameof(GetGateAlertsBySerialVm.Type)"
                                                    Title="@TextResources.APP_StringKeys_Alert_Desc"></GridColumn>
                                        <GridColumn Field="@nameof(GetGateAlertsBySerialVm.Username)"
                                                    Title="@TextResources.APP_StringKeys_CreateUser"></GridColumn>
                                    </GridColumns>
                                </TelerikGrid>
                            </div>
                        </div>
                    }
                </TabStripTab>
                <TabStripTab Title="ریز تغییرات">
                    @if (TagChangeLogs.Any())
                    {
                        <TelerikGrid Data="@TagChangeLogs"
                                     PageSize="10"
                                     Pageable="true"
                                     Sortable="true"
                                     Navigable="true">
                            <RowTemplate Context="log">
                                @{
                                    var action = GetAction(log.Description);
                                }
                                <td class="td-style">@log.RecordKey</td>
                                <td class="td-style">@(string.IsNullOrWhiteSpace(log.UserName) ? "نامشخص" : log.UserName)</td>
                                <td class="td-style">@GetActionTitle(log.Description)</td>
                                <td class="td-style">@($"{PersianCalendarTools.GregorianToPersian(log.CreatedAt)} {log.CreatedAt:HH:mm}")</td>
                                <td class="td-style">
                                    @if (action == "UPDATE")
                                    {
                                        <span class="text-primary">برای مشاهده جزئیات، ردیف را باز کنید</span>
                                    }
                                    else
                                    {
                                        <span>@ToReadableTagChange(log.Description)</span>
                                    }
                                </td>
                            </RowTemplate>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetTablesChangeLogDto.RecordKey)"
                                            Title="@TextResources.APP_StringKeys_ProductSerial"
                                            Width="150px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_CreateUser" Width="180px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_OperationType" Width="130px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_Date" Width="180px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_Details" />
                            </GridColumns>
                            <DetailTemplate Context="log">
                                @{
                                    var item = (GetTablesChangeLogDto)log;
                                    var action = GetAction(item.Description);
                                }

                                @if (action == "UPDATE")
                                {
                                    var rows = GetUpdateRows(item.Description);

                                    @if (rows.Any())
                                    {
                                        <div class="p-2 bg-light border rounded">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:35%">اطلاعات تغییر یافته</th>
                                                        <th style="width:32%">مقدار قبلی</th>
                                                        <th style="width:33%">مقدار جدید</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in rows)
                                                    {
                                                        <tr>
                                                            <td>@row.Field</td>
                                                            <td dir="rtl">@row.OldValue</td>
                                                            <td dir="rtl">@row.NewValue</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 text-muted">جزئیات ویرایش قابل نمایش نیست.</div>
                                    }
                                }
                                else
                                {
                                    <div class="p-2">
                                        @ToReadableTagChange(item.Description)
                                    </div>
                                }
                            </DetailTemplate>
                        </TelerikGrid>
                    }
                </TabStripTab>
                <TabStripTab Title="لاگ GPS">
                    @if (GpsLogs.Any())
                    {
                        <TelerikGrid Data="@GpsLogs"
                                     PageSize="10"
                                     Pageable="true"
                                     Sortable="true"
                                     Navigable="true">
                            <RowTemplate Context="log">
                                @{
                                    var jsonData = JsonDocument.Parse(log.AdditionalData);
                                    jsonData.RootElement.TryGetProperty("ActionTypeTitle", out var actionTypeTitle);
                                    var mapLink = $"https://www.google.com/maps/search/?api=1&query={log.Lat},{log.Long}";
                                }
                                <td class="td-style">
                                  @actionTypeTitle
                                </td>
                                <td class="td-style">@PersianCalendarTools.GregorianToPersian(log.LogDateTime)</td>
                                <td class="td-style">@log.UserName</td>
                                <td class="td-style">@($"{log.Lat},{log.Long}")</td>
                                <td class="td-style">
                                    <a href="@mapLink"
                                       class="btn-dt-1 btn-success tr-buttom btn"
                                       target="_blank">
                                        <MaterialIcon IconName="@MaterialIconsHelper.Map" />
                                    </a>
                                </td>
                            </RowTemplate>
                            <GridColumns>
                                <GridColumn Title="@TextResources.APP_StringKeys_OperationType" Width="130px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_Date" Width="180px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_CreateUser" Width="180px" />
                                <GridColumn Title="مختصات"
                                            Width="100px" />
                                <GridColumn Title="@TextResources.APP_StringKeys_Details" />
                            </GridColumns>
                        </TelerikGrid>
                    }
                </TabStripTab>
            </TelerikTabStrip>
        </div>
    }
</div>
<CascadingValue Value="Notification">
    <Gallery @ref="GalleryRef"
             Readonly="true">
    </Gallery>
</CascadingValue>
<CascadingValue Value="IsLoading">
    <CascadingValue Value="Notification">
        <SelectPrintFormat @ref="SelectPrintFormatRef"
                           OnFileNameSelect="OnPrintActionClick">
        </SelectPrintFormat>
    </CascadingValue>
</CascadingValue>
<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>