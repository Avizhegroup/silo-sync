@page "/register/cancel"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Application.Features
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@TextResources.APP_StringKeys_Product_Revoke" Subtitle="@RegisterTexts.CancelSubtitle"
                ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps" />

    <SectionCard Step="1" Title="@RegisterTexts.CancelStepFind" Hint="@RegisterTexts.CancelStepFindHint">
        <div class="row g-3 align-items-end">
            <FormField Class="col-md-6 col-lg-4" Label="@($"{TextResources.APP_StringKeys_ProductSerial} / EPC")" For="cancel-input">
                <ScanInput Id="cancel-input" @bind-Value="Input" OnKeyUp="OnInputKeyUp"
                           Placeholder="@RegisterTexts.CancelInputPlaceholder" Enabled="@(!IsLoading && !ConfirmPending)" />
            </FormField>
            <div class="col-auto d-flex gap-2">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsLoading && !ConfirmPending)" OnClick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search" /> @TextResources.APP_StringKeys_Search
                </TelerikButton>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(!IsLoading)" OnClick="OnClearClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh" /> @TextResources.APP_StringKeys_New
                </TelerikButton>
            </div>
        </div>
    </SectionCard>

    <StatusMessage Kind="@MessageKind" Message="@Message" />

    @if (Product is not null)
    {
        <SectionCard Step="2" Title="@RegisterTexts.CancelStepProduct">
            <RegisterGrid TItem="GetRevokeTagsVm" Data="ProductList" Sortable="false" EmptyText="@null">
                <Columns>
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.Size)" Title="@TextResources.APP_StringKeys_Product_Size" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.RegCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.Qc)" Title="@TextResources.APP_StringKeys_Chart_Qc" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.Warehouse)" Title="@TextResources.APP_StringKeys_Field_Warehouse_Title" />
                </Columns>
            </RegisterGrid>
        </SectionCard>

        @if (ConfirmPending)
        {
            <ConfirmBar Kind="danger" Message="@string.Format(TextResources.APP_StringKeys_Revoke_Confirm, Product.ProductSerial)"
                        YesText="@TextResources.APP_StringKeys_Confirm" NoText="@TextResources.APP_StringKeys_Close"
                        OnYes="OnConfirmYes" OnNo="OnConfirmNo" />
        }
        else
        {
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" Enabled="@(!IsLoading)" OnClick="OnCancelClick">
                <MaterialIcon IconName="@MaterialIconsHelper.Cancel" /> @TextResources.APP_StringKeys_Revoke
            </TelerikButton>
        }
    }
</div>

<PageLoader Visible="IsLoading" />
