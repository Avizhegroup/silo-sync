@page "/register/test/group"
@inherits SiloBasePage
@implements IDisposable
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.GroupTitle" Subtitle="@RegisterTexts.GroupSubtitle" ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps">
        <NavLink href="/register/test" class="btn btn-outline-secondary">@RegisterTexts.TestSingleLink</NavLink>
    </PageHeader>

    <SectionCard Step="1" Title="@RegisterTexts.GroupTitle">
        <HeaderContent>
            <span class="badge rounded-pill @(IsReading ? "bg-warning text-dark" : "bg-secondary")">@(IsReading ? RegisterTexts.Reading : RegisterTexts.Stopped)</span>
        </HeaderContent>
        <ChildContent>
            <div class="d-flex flex-wrap align-items-center gap-4">
                <div class="fs-5">@RegisterTexts.GroupAllTags: <strong>@Rows.Count</strong></div>
                <div class="fs-5 @(NotRegisteredCount > 0 ? "text-danger" : string.Empty)">@TextResources.APP_StringKeys_No_Register: <strong>@NotRegisteredCount</strong></div>
                <div class="text-secondary">@RegisterTexts.GroupWaitingLookup: @_pending.Count</div>
                <div class="d-flex flex-wrap gap-2 ms-md-auto">
                    @if (IsReading)
                    {
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" FillMode="@ThemeConstants.Button.FillMode.Outline" OnClick="StopAsync">
                            <MaterialIcon IconName="@MaterialIconsHelper.Stop" /> @TextResources.APP_StringKeys_Pause
                        </TelerikButton>
                    }
                    else
                    {
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="IsDeviceConnected" OnClick="StartAsync">
                            <MaterialIcon IconName="@MaterialIconsHelper.PlayArrow" /> @RegisterTexts.GroupStart
                        </TelerikButton>
                    }
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="IsDeviceConnected" OnClick="ResetAsync">
                        <MaterialIcon IconName="@MaterialIconsHelper.DeleteSweep" /> @TextResources.APP_StringKeys_Clear
                    </TelerikButton>
                </div>
            </div>
        </ChildContent>
    </SectionCard>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <StatusMessage Kind="danger" Message="@ErrorMessage" />
    }

    <SectionCard Step="2" Title="@TextResources.APP_StringKeys_Result">
        <RegisterGrid TItem="GroupTagRow" Data="Rows" PageSize="20" Sortable="false"
                      RowKind="@(row => row.IsRegistered ? "success" : "danger")" EmptyText="@RegisterTexts.GroupHowTo2">
            <Columns>
                <GridColumn Field="@nameof(GroupTagRow.Index)" Title="#" Width="70px" />
                <GridColumn Field="@nameof(GroupTagRow.Epc)" Title="@TextResources.APP_StringKeys_TagEPC" />
                <GridColumn Title="@TextResources.APP_StringKeys_ProductSerial">
                    <Template Context="item">@(((GroupTagRow)item).IsRegistered ? ((GroupTagRow)item).Serial : TextResources.APP_StringKeys_No_Register)</Template>
                </GridColumn>
                <GridColumn Field="@nameof(GroupTagRow.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                <GridColumn Field="@nameof(GroupTagRow.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                <GridColumn Field="@nameof(GroupTagRow.RegCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                <GridColumn Field="@nameof(GroupTagRow.ContractStatus)" Title="@TextResources.APP_StringKeys_ContractStatus" />
            </Columns>
        </RegisterGrid>
    </SectionCard>
</div>
