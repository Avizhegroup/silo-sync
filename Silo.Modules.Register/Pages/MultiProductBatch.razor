@page "/register/batch"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Application.Features
@using Silo.Shared.Components.Modals
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>

<div class="container-fluid mt-2">
    @if (!CanSave)
    {
        <div class="alert alert-warning">You are not allowed to register new serials (the list of allowed users is configured by the administrator).</div>
    }
    <div class="card shadow-sm mb-3">
        <div class="card-header">@TextResources.APP_StringKeys_OperationInfo @TextResources.APP_StringKeys_Register</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <span>@TextResources.APP_StringKeys_OperationCode: @ActionId</span>
            <div class="input-group" style="max-width:380px">
                <button type="button" class="btn btn-outline-secondary" title="-1" disabled="@IsLoading" @onclick="() => StepActionAsync(-1)">&lsaquo;</button>
                <input class="form-control" inputmode="numeric" placeholder="@TextResources.APP_StringKeys_OperationCode" @bind="OpenActionId" @bind:event="oninput" @onkeyup="OnOpenActionKeyUp" />
                <button type="button" class="btn btn-outline-secondary" disabled="@(IsLoading || string.IsNullOrWhiteSpace(OpenActionId))" @onclick="OnOpenActionClick">@TextResources.APP_StringKeys_Search</button>
                <button type="button" class="btn btn-outline-secondary" title="+1" disabled="@IsLoading" @onclick="() => StepActionAsync(1)">&rsaquo;</button>
            </div>
            <button type="button" class="btn btn-warning" disabled="@IsLoading" @onclick="OnNewClick">@TextResources.APP_StringKeys_New</button>
            <NavLink href="/print/management" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Print</NavLink>
            <span class="text-muted small">F5 clear &middot; F6 save &middot; F7 print</span>
            @if (HasSavedRows)
            {
                <NavLink href="@($"/register/print?actionId={ActionId}")" class="btn btn-success">Register and print labels</NavLink>
            }
            <div class="form-check">
                <input id="register-single" type="checkbox" class="form-check-input" @bind="IsSingleMode" disabled="@(Rows.Count > 0)" />
                <label for="register-single" class="form-check-label">Single product (save directly)</label>
            </div>
            <div class="form-check">
                <input id="register-check" type="checkbox" class="form-check-input" @bind="CheckRemaining" />
                <label for="register-check" class="form-check-label">Check the document's remaining quantity</label>
            </div>
            <NavLink href="/report/register" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Reports</NavLink>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label>@TextResources.APP_StringKeys_Line</label>
                <TelerikDropDownList Data="Lines" TextField="Title" ValueField="Code" @bind-Value="Line"
                                     DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="180px" />
            </div>
            <div>
                <label>@TextResources.APP_StringKeys_Chart_Shift</label>
                <TelerikDropDownList Data="Shifts" TextField="Title" ValueField="Code" @bind-Value="Shift"
                                     DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="180px" />
            </div>
            <div>
                <label>@TextResources.APP_StringKeys_Production_Warehouse</label>
                <TelerikDropDownList Data="Warehouses" TextField="DestinationTitle" ValueField="DestinationCode"
                                     @bind-Value="Warehouse" DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="200px" />
            </div>
            <div>
                <label for="register-document">@TextResources.APP_StringKeys_DocKey</label>
                <div class="input-group">
                    <input id="register-document" class="form-control" value="@DocumentId" @onchange="OnDocumentChanged" disabled="@HasSavedRows" />
                    <button type="button" class="btn btn-outline-secondary" disabled="@(IsLoading || HasSavedRows)" @onclick="ToggleDocumentsAsync">Documents</button>
                </div>
            </div>
        </div>
    </div>

    @if (ShowDocuments)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex gap-3 align-items-center">
                <span>Documents</span>
                <input class="form-control" style="max-width:260px" placeholder="@TextResources.APP_StringKeys_DocKey" @bind="DocumentSearch" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ToggleDocumentsAsync">@TextResources.APP_StringKeys_Close</button>
            </div>
            <div class="card-body table-responsive" style="max-height:320px;overflow:auto">
                <table class="table table-sm align-middle">
                    <tbody>
                        @foreach (var document in FilteredDocuments)
                        {
                            <tr @key="document.Key">
                                <td>@document.Key</td>
                                <td>@document.Description</td>
                                <td><button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectDocumentAsync(document.Key)">@TextResources.APP_StringKeys_Choose</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (LoadedDocument is not null)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">@TextResources.APP_StringKeys_DocKey: @LoadedDocument.Key</div>
            <div class="card-body row g-3">
                @if (HeaderRows.Count > 0)
                {
                    <div class="col-12 col-lg-4">
                        <table class="table table-sm">
                            @foreach (var header in HeaderRows)
                            {
                                <tr><th>@header.Key</th><td>@header.Value</td></tr>
                            }
                        </table>
                    </div>
                }
                <div class="col-12 col-lg">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>@TextResources.APP_StringKeys_ProductCode</th><th>@TextResources.APP_StringKeys_ProductName</th><th>Requested</th><th>Remaining</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in DocumentItems)
                            {
                                <tr @key="item.ProductCode">
                                    <td>@item.ProductCode</td>
                                    <td>@item.ProductTitle</td>
                                    <td>@item.Count</td>
                                    <td>@(item.Remain?.ToString("0.##") ?? "-")</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-primary" disabled="@(IsLoading || HasSavedRows)" @onclick="() => SelectDocumentItemAsync(item)">@TextResources.APP_StringKeys_Choose</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (IsSingleMode)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex flex-wrap gap-3 align-items-center">
                <span>Serial list (optional - leave empty to let the server generate the serials)</span>
                <span class="badge bg-@(Serials.Count > 0 ? "success" : "secondary")">@Serials.Count</span>
                @if (Serials.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto" disabled="@HasSavedRows" @onclick="ClearSerials">@TextResources.APP_StringKeys_Delete</button>
                }
            </div>
            <div class="card-body d-flex flex-wrap gap-3 align-items-end">
                <div>
                    <label for="serial-mode">Source</label>
                    <select id="serial-mode" class="form-select" @bind="SerialMode">
                        <option value="range">Range</option>
                        <option value="excel">Excel (.xlsx)</option>
                    </select>
                </div>
                @if (SerialMode == "range")
                {
                    <div><label for="serial-from">From</label><input id="serial-from" class="form-control" style="max-width:150px" @bind="RangeFrom" /></div>
                    <div><label for="serial-to">To (not included)</label><input id="serial-to" class="form-control" style="max-width:150px" @bind="RangeTo" /></div>
                    <div><label for="serial-cut-start">Fixed prefix: start</label><input id="serial-cut-start" type="number" min="0" class="form-control" style="max-width:110px" @bind="CutStart" /></div>
                    <div><label for="serial-cut-length">Fixed prefix: length</label><input id="serial-cut-length" type="number" min="0" class="form-control" style="max-width:110px" @bind="CutLength" /></div>
                    <button type="button" class="btn btn-outline-primary" disabled="@HasSavedRows" @onclick="GenerateRange">@TextResources.APP_StringKeys_Add</button>
                }
                else
                {
                    <div class="form-check">
                        <input id="serial-header" type="checkbox" class="form-check-input" @bind="ExcelHasHeader" />
                        <label for="serial-header" class="form-check-label">First row is a header</label>
                    </div>
                    <InputFile OnChange="OnExcelSelected" accept=".xlsx" class="form-control" style="max-width:320px" disabled="@HasSavedRows" />
                }
            </div>
            @if (Serials.Count > 0)
            {
                <div class="card-footer text-muted small">@string.Join(", ", Serials.Take(5))@(Serials.Count > 5 ? " ..." : string.Empty)</div>
            }
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header">@TextResources.APP_StringKeys_Search_Product</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <button type="button" class="btn btn-outline-primary" disabled="@IsLoading" @onclick="OnChooseProductClick">@TextResources.APP_StringKeys_Search_Product</button>
            <span>@CurrentProduct?.ProductCode — @CurrentProduct?.ProductName</span>
            <span>@CurrentProduct?.TechnicalCode — @CurrentProduct?.ProductStatusTitle</span>
            <div>
                <label for="register-count">@TextResources.APP_StringKeys_Count</label>
                <input id="register-count" type="number" min="1" class="form-control" @bind="Count" disabled="@(IsSingleMode && Serials.Count > 0)" />
            </div>
            <div>
                <label for="register-value">@TextResources.APP_StringKeys_PackValue</label>
                <input id="register-value" class="form-control" @bind="PackValue" />
            </div>
            <div class="form-check">
                <input id="register-weight-toggle" type="checkbox" class="form-check-input" @bind="ShowWeightPanel" />
                <label for="register-weight-toggle" class="form-check-label">Pack value from total weight</label>
            </div>
            @if (ShowWeightPanel)
            {
                <div class="input-group" style="max-width:320px">
                    <input class="form-control" inputmode="decimal" placeholder="Total weight" @bind="TotalWeight" />
                    <button type="button" class="btn btn-outline-primary" disabled="@(CurrentProduct is null)" @onclick="OnApplyAverageWeight">Average</button>
                </div>
            }
            <button type="button" class="btn btn-primary" disabled="@(IsLoading || HasSavedRows || !CanSave)" @onclick="OnAddClick">@(IsSingleMode ? TextResources.APP_StringKeys_Confirm : TextResources.APP_StringKeys_Add)</button>
        </div>
        @if (DynamicFields.Count > 0)
        {
            <div class="card-body d-flex flex-wrap gap-3">
                @foreach (var field in DynamicFields)
                {
                    <div @key="field">
                        <label>@field.Title</label>
                        @if (field.ValueOptions?.Contains('|') == true)
                        {
                            <select class="form-select" @bind="field.Value" disabled="@(field.IsReadOnly == true)">
                                <option value="">@TextResources.APP_StringKeys_NotChoosed</option>
                                @foreach (var option in field.ValueOptions.Split('|'))
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="form-control" @bind="field.Value" readonly="@(field.IsReadOnly == true)" />
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <span>@TextResources.APP_StringKeys_Count: @Rows.Sum(p => p.Count)</span>
            <button type="button" class="btn btn-success" disabled="@(IsLoading || !CanSave || !Rows.Any(p => !p.IsSaved))" @onclick="OnSaveClick">@TextResources.APP_StringKeys_Confirm</button>
        </div>
        <div class="card-body">
            <TelerikGrid Data="Rows" Pageable="true" Sortable="true" PageSize="10">
                <GridColumns>
                    <GridColumn Field="@nameof(BatchRow.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(BatchRow.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(BatchRow.TechnicalCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                    <GridColumn Field="@nameof(BatchRow.Count)" Title="@TextResources.APP_StringKeys_Count" />
                    <GridColumn Field="@nameof(BatchRow.PackValue)" Title="@TextResources.APP_StringKeys_PackValue" />
                    <GridColumn Field="@nameof(BatchRow.TotalValue)" Title="@TextResources.APP_StringKeys_SumValue" />
                    <GridColumn Field="@nameof(BatchRow.DocumentId)" Title="@TextResources.APP_StringKeys_DocKey" />
                    <GridColumn Title="@TextResources.APP_StringKeys_ProductSerial">
                        <Template Context="item">@(((BatchRow)item).Serials is { } serials ? $"{((BatchRow)item).SavedCount}/{serials.Count}" : "-")</Template>
                    </GridColumn>
                    <GridColumn Title="@TextResources.APP_StringKeys_Status">
                        <Template Context="item">@(((BatchRow)item).IsSaved ? TextResources.APP_StringKeys_Done : TextResources.APP_StringKeys_New)</Template>
                    </GridColumn>
                    <GridColumn Title="@TextResources.APP_StringKeys_Delete">
                        <Template Context="item">
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(IsLoading || ((BatchRow)item).IsSaved || ((BatchRow)item).SavedCount > 0)" @onclick="() => OnRemoveClick((BatchRow)item)">@TextResources.APP_StringKeys_Delete</button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    </div>
</div>

<ProductCodeModal @ref="ProductModal" OnClickProduct="OnProductSelected" />

@if (IsLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End" LoaderType="LoaderType.InfiniteSpinner"
                            Text="@TextResources.APP_StringKeys_Loading" />
}
