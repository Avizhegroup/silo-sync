@page "/register/batch"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Application.Features
@using Silo.Shared.Components.Modals
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>

<div class="container-fluid mt-2">
    <div class="card shadow-sm mb-3">
        <div class="card-header">@TextResources.APP_StringKeys_OperationInfo @TextResources.APP_StringKeys_Register</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <span>@TextResources.APP_StringKeys_OperationCode: @ActionId</span>
            <button type="button" class="btn btn-warning" disabled="@IsLoading" @onclick="OnNewClick">@TextResources.APP_StringKeys_New</button>
            <NavLink href="/print/management" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Print</NavLink>
            <NavLink href="/report/register" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Reports</NavLink>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label>@TextResources.APP_StringKeys_Line</label>
                <TelerikDropDownList Data="Lines" TextField="Title" ValueField="Code" @bind-Value="Line"
                                     DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="180px" />
            </div>
            <div>
                <label>@TextResources.APP_StringKeys_Chart_Shift</label>
                <TelerikDropDownList Data="Shifts" TextField="Title" ValueField="Code" @bind-Value="Shift"
                                     DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="180px" />
            </div>
            <div>
                <label>@TextResources.APP_StringKeys_Production_Warehouse</label>
                <TelerikDropDownList Data="Warehouses" TextField="DestinationTitle" ValueField="DestinationCode"
                                     @bind-Value="Warehouse" DefaultText="@TextResources.APP_StringKeys_NotChoosed" Width="200px" />
            </div>
            <div>
                <label for="register-document">@TextResources.APP_StringKeys_DocKey</label>
                <input id="register-document" class="form-control" @bind="DocumentId" disabled="@Rows.Any(p => p.IsSaved)" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header">@TextResources.APP_StringKeys_Search_Product</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <button type="button" class="btn btn-outline-primary" disabled="@IsLoading" @onclick="OnChooseProductClick">@TextResources.APP_StringKeys_Search_Product</button>
            <span>@CurrentProduct?.ProductCode — @CurrentProduct?.ProductName</span>
            <span>@CurrentProduct?.TechnicalCode — @CurrentProduct?.ProductStatusTitle</span>
            <div>
                <label for="register-count">@TextResources.APP_StringKeys_Count</label>
                <input id="register-count" type="number" min="1" class="form-control" @bind="Count" />
            </div>
            <div>
                <label for="register-value">@TextResources.APP_StringKeys_PackValue</label>
                <input id="register-value" class="form-control" @bind="PackValue" />
            </div>
            <button type="button" class="btn btn-primary" disabled="@(IsLoading || Rows.Any(p => p.IsSaved))" @onclick="OnAddClick">@TextResources.APP_StringKeys_Add</button>
        </div>
        @if (DynamicFields.Count > 0)
        {
            <div class="card-body d-flex flex-wrap gap-3">
                @foreach (var field in DynamicFields)
                {
                    <div @key="field">
                        <label>@field.Title</label>
                        @if (field.ValueOptions?.Contains('|') == true)
                        {
                            <select class="form-select" @bind="field.Value" disabled="@(field.IsReadOnly == true)">
                                <option value="">@TextResources.APP_StringKeys_NotChoosed</option>
                                @foreach (var option in field.ValueOptions.Split('|'))
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="form-control" @bind="field.Value" readonly="@(field.IsReadOnly == true)" />
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <span>@TextResources.APP_StringKeys_Count: @Rows.Sum(p => p.Count)</span>
            <button type="button" class="btn btn-success" disabled="@(IsLoading || !Rows.Any(p => !p.IsSaved))" @onclick="OnSaveClick">@TextResources.APP_StringKeys_Confirm</button>
        </div>
        <div class="card-body">
            <TelerikGrid Data="Rows" Pageable="true" Sortable="true" PageSize="10">
                <GridColumns>
                    <GridColumn Field="@nameof(BatchRow.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(BatchRow.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(BatchRow.TechnicalCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                    <GridColumn Field="@nameof(BatchRow.Count)" Title="@TextResources.APP_StringKeys_Count" />
                    <GridColumn Field="@nameof(BatchRow.PackValue)" Title="@TextResources.APP_StringKeys_PackValue" />
                    <GridColumn Field="@nameof(BatchRow.TotalValue)" Title="@TextResources.APP_StringKeys_SumValue" />
                    <GridColumn Field="@nameof(BatchRow.DocumentId)" Title="@TextResources.APP_StringKeys_DocKey" />
                    <GridColumn Title="@TextResources.APP_StringKeys_Status">
                        <Template Context="item">@(((BatchRow)item).IsSaved ? TextResources.APP_StringKeys_Done : TextResources.APP_StringKeys_New)</Template>
                    </GridColumn>
                    <GridColumn Title="@TextResources.APP_StringKeys_Delete">
                        <Template Context="item">
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(IsLoading || ((BatchRow)item).IsSaved)" @onclick="() => OnRemoveClick((BatchRow)item)">@TextResources.APP_StringKeys_Delete</button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    </div>
</div>

<ProductCodeModal @ref="ProductModal" OnClickProduct="OnProductSelected" />

@if (IsLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End" LoaderType="LoaderType.InfiniteSpinner"
                            Text="@TextResources.APP_StringKeys_Loading" />
}
