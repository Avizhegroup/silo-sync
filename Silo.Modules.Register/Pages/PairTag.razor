@page "/register/pair"
@inherits SiloBasePage
@implements IDisposable
@namespace Silo.Modules.Register.Pages


<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex flex-wrap gap-3 align-items-center">
            <span class="fw-bold">Register by barcode and RFID tag</span>
            <span class="badge @(IsOperationOn ? "bg-success" : "bg-secondary")">@(IsOperationOn ? "Running" : "Stopped")</span>
            <span class="ms-auto d-flex flex-wrap gap-2">
                <NavLink href="/register/test" class="btn btn-sm btn-outline-secondary">Test tag</NavLink>
                <NavLink href="/register/cancel" class="btn btn-sm btn-outline-secondary">Cancel tag registration</NavLink>
            </span>
        </div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="pair-separator" class="form-label">Barcode separator</label>
                <input id="pair-separator" class="form-control" style="max-width:120px" maxlength="1" @bind="Separator" disabled="@IsOperationOn" />
            </div>
            @if (IsOperationOn)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="StopOperationAsync">Stop</button>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled="@(!IsDeviceConnected)" @onclick="StartOperationAsync">Start</button>
            }
            <span class="text-muted small">Hold the product sheet with the barcode facing the scanner, then bring the tag to the reader.</span>
        </div>
    </div>

    <div class="alert alert-@MessageKind fs-5">@Message</div>

    @if (ConfirmMessage is not null)
    {
        <div class="alert alert-warning d-flex flex-wrap gap-3 align-items-center">
            <span>@ConfirmMessage</span>
            <button type="button" class="btn btn-warning" @onclick="() => AnswerConfirm(true)">Yes</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => AnswerConfirm(false)">No</button>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">Capture</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="pair-barcode" class="form-label">Barcode (serial) <span class="badge @(HasBarcode ? "bg-success" : "bg-light text-dark")">@(HasBarcode ? "captured" : "waiting")</span></label>
                <input id="pair-barcode" @ref="BarcodeBox" class="form-control" style="min-width:260px" @bind="BarcodeInput" @bind:event="oninput"
                       @onkeyup="OnBarcodeKeyUp" disabled="@(!IsOperationOn)" autocomplete="off" />
            </div>
            <div>
                <label for="pair-epc" class="form-label">Tag EPC <span class="badge @(HasEpc ? "bg-success" : "bg-light text-dark")">@(HasEpc ? "captured" : "waiting")</span></label>
                <input id="pair-epc" class="form-control" style="min-width:280px" maxlength="24" @bind="EpcInput" @bind:event="oninput"
                       @onkeyup="OnEpcKeyUp" disabled="@(!IsOperationOn)" autocomplete="off" />
            </div>
            <button type="button" class="btn btn-outline-secondary" disabled="@(!IsOperationOn)" @onclick="ClearCaptureAsync">Clear</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap gap-3">
            <span class="fw-bold">Results (@Results.Count)</span>
            <span class="text-success">@Results.Count(p => p.Kind == PairResultKind.Success) registered</span>
            <span class="text-danger">@Results.Count(p => p.Kind == PairResultKind.Error) failed</span>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>#</th><th>@TextResources.APP_StringKeys_ProductSerial</th><th>EPC</th><th>@TextResources.APP_StringKeys_Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Results)
                    {
                        <tr class="@row.CssClass">
                            <td>@row.Index</td>
                            <td>@row.Serial</td>
                            <td class="font-monospace">@row.Epc</td>
                            <td>@row.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<TelerikLoaderContainer Visible="@(IsSaving && ConfirmMessage is null)" />
