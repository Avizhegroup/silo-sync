@page "/register/pair"
@inherits SiloBasePage
@implements IDisposable
@namespace Silo.Modules.Register.Pages

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.PairTitle" Subtitle="@RegisterTexts.PairSubtitle" ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps">
        <NavLink href="/register/test" class="btn btn-outline-secondary">@RegisterTexts.PairLinkTest</NavLink>
        <NavLink href="/register/cancel" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Revoke</NavLink>
    </PageHeader>

    <SectionCard Step="1" Title="@RegisterTexts.PairStepSettings">
        <HeaderContent>
            <span class="badge rounded-pill @(IsOperationOn ? "bg-success" : "bg-secondary")">@(IsOperationOn ? RegisterTexts.Running : RegisterTexts.Stopped)</span>
        </HeaderContent>
        <ChildContent>
            <div class="row g-3 align-items-start">
                <FormField Class="col-md-2" Label="@TextResources.APP_StringKeys_Separator_Phrase" For="pair-separator" Hint="@RegisterTexts.PairSeparatorHint">
                    <TelerikTextBox Id="pair-separator" @bind-Value="Separator" MaxLength="1" Enabled="@(!IsOperationOn)" Width="100%" />
                </FormField>
                <div class="col-md-3 pt-md-4">
                    @if (IsOperationOn)
                    {
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" FillMode="@ThemeConstants.Button.FillMode.Outline" OnClick="StopOperationAsync">
                            <MaterialIcon IconName="@MaterialIconsHelper.Stop" /> @TextResources.APP_StringKeys_Pause
                        </TelerikButton>
                    }
                    else
                    {
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="IsDeviceConnected" OnClick="StartOperationAsync"
                                       Title="@(IsDeviceConnected ? TextResources.APP_StringKeys_Start : RegisterTexts.DeviceNeededHint)">
                            <MaterialIcon IconName="@MaterialIconsHelper.PlayArrow" /> @TextResources.APP_StringKeys_Start
                        </TelerikButton>
                    }
                </div>
                <div class="col-md-7 pt-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <TelerikCheckBox Id="pair-autoprint" @bind-Value="AutoPrint" Enabled="@(!IsOperationOn && ReceiptFormats.Count > 0)" />
                        <label for="pair-autoprint">@RegisterTexts.PairAutoPrint</label>
                    </div>
                    <div class="form-text">@RegisterTexts.PairAutoPrintHint</div>
                </div>
                @if (AutoPrint)
                {
                    <FormField Class="col-md-5" Label="@RegisterTexts.PairReceiptFormat" For="pair-receipt">
                        <TelerikDropDownList Id="pair-receipt" Data="ReceiptFormats" TextField="@nameof(DeviceFormat.Name)" ValueField="@nameof(DeviceFormat.Name)"
                                             @bind-Value="ReceiptFormatName" Enabled="@(!IsOperationOn)" DefaultText="@RegisterTexts.LabelFormat" Width="100%" />
                    </FormField>
                    <FormField Class="col-md-5" Label="@RegisterTexts.PrinterLabel" For="pair-receipt-printer">
                        <PrinterSelect Id="pair-receipt-printer" Printers="Printers" @bind-Value="ReceiptPrinter"
                                       DefaultText="@RegisterTexts.PrinterFromFile" Enabled="@(!IsOperationOn)" />
                    </FormField>
                }
            </div>
        </ChildContent>
    </SectionCard>

    <StatusMessage Kind="@MessageKind" Message="@Message" Class="fs-5" />

    @if (ConfirmMessage is not null)
    {
        <ConfirmBar Kind="warning" Message="@ConfirmMessage" YesText="@TextResources.APP_StringKeys_Yes" NoText="@TextResources.APP_StringKeys_No"
                    OnYes="@(() => AnswerConfirm(true))" OnNo="@(() => AnswerConfirm(false))" />
    }

    <SectionCard Step="2" Title="@RegisterTexts.PairStepCapture">
        <HeaderContent>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="IsOperationOn" OnClick="ClearCaptureAsync">
                <MaterialIcon IconName="@MaterialIconsHelper.DeleteSweep" /> @TextResources.APP_StringKeys_Clear
            </TelerikButton>
        </HeaderContent>
        <ChildContent>
            <div class="row g-3">
                <FormField Class="col-md-6" Label="@RegisterTexts.PairBarcodeLabel" For="pair-barcode"
                           Hint="@(HasBarcode ? RegisterTexts.Captured : RegisterTexts.Waiting)">
                    <ScanInput Id="pair-barcode" @ref="BarcodeBox" @bind-Value="BarcodeInput" OnKeyUp="OnBarcodeKeyUp" Enabled="IsOperationOn" />
                </FormField>
                <FormField Class="col-md-6" Label="@RegisterTexts.PairEpcLabel" For="pair-epc"
                           Hint="@(HasEpc ? RegisterTexts.Captured : RegisterTexts.Waiting)">
                    <ScanInput Id="pair-epc" @bind-Value="EpcInput" OnKeyUp="OnEpcKeyUp" MaxLength="24" Enabled="IsOperationOn" />
                </FormField>
            </div>
        </ChildContent>
    </SectionCard>

    <SectionCard Step="3" Title="@($"{RegisterTexts.PairResults} ({Results.Count})")">
        <HeaderContent>
            <span class="text-success">@Results.Count(p => p.Kind == PairResultKind.Success) @RegisterTexts.PairRegisteredCount</span>
            <span class="text-danger">@Results.Count(p => p.Kind == PairResultKind.Error) @RegisterTexts.PairFailedCount</span>
        </HeaderContent>
        <ChildContent>
            <RegisterGrid TItem="PairRow" Data="Results" PageSize="15" Sortable="false" RowKind="@(row => row.CssClass)">
                <Columns>
                    <GridColumn Field="@nameof(PairRow.Index)" Title="#" Width="70px" />
                    <GridColumn Field="@nameof(PairRow.Serial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(PairRow.Epc)" Title="@TextResources.APP_StringKeys_TagEPC" />
                    <GridColumn Field="@nameof(PairRow.Status)" Title="@TextResources.APP_StringKeys_Status" />
                </Columns>
            </RegisterGrid>
        </ChildContent>
    </SectionCard>
</div>
<PageLoader Visible="@(IsSaving && ConfirmMessage is null)" />
