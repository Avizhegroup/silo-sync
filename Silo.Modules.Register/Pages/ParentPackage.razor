@page "/register/package"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<TelerikLoaderContainer Visible="@IsLoading" />

<div class="container-fluid mt-2">
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">1. @TextResources.APP_StringKeys_Add @TextResources.APP_StringKeys_ProductSerial</div>
                <div class="card-body d-flex flex-wrap gap-3 align-items-end">
                    <div>
                        <label for="pkg-serial" class="form-label">@TextResources.APP_StringKeys_ProductSerial</label>
                        <input id="pkg-serial" class="form-control" style="min-width:220px" @bind="Serial" @bind:event="oninput"
                               @onkeyup="OnSerialKeyUp" autofocus />
                    </div>
                    <button type="button" class="btn btn-primary" disabled="@(IsLoading || string.IsNullOrWhiteSpace(Serial))" @onclick="OnAddClick">
                        @TextResources.APP_StringKeys_Add
                    </button>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">2. Package</div>
                <div class="card-body d-flex flex-wrap gap-3 align-items-end">
                    <div>
                        <label for="pkg-code" class="form-label">Package code</label>
                        <input id="pkg-code" class="form-control" @bind="PackageCode" @bind:event="oninput" @onkeyup="OnPackageCodeKeyUp" />
                    </div>
                    <div>
                        <label for="pkg-epc" class="form-label">Package EPC</label>
                        <input id="pkg-epc" class="form-control" maxlength="24" style="min-width:230px" @bind="PackageEpc" @bind:event="oninput" />
                    </div>
                    <button type="button" class="btn btn-outline-primary" disabled="@IsLoading" @onclick="OnLoadPackageClick">
                        @TextResources.APP_StringKeys_Search
                    </button>
                    <button type="button" class="btn @(IsReading ? "btn-warning" : "btn-outline-primary")" disabled="@(IsLoading || !IsDeviceConnected)" @onclick="OnReadTagClick"
                            title="@(IsDeviceConnected ? "Read the package tag with the reader" : "The device host is not connected")">
                        @(IsReading ? "Waiting for the tag..." : "Read package tag")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-bold">3. @TextResources.APP_StringKeys_Count: <span class="badge bg-secondary">@Items.Count</span></span>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted">@TextResources.APP_StringKeys_Value: @TotalValue.ToString("0.##")</span>
                <select class="form-select" style="max-width:240px" @bind="SelectedFormatKey" disabled="@(IsPrinting || !IsDeviceConnected)">
                    <option value="">Label format</option>
                    @foreach (var format in Formats)
                    {
                        <option value="@format.Key">@format.Display</option>
                    }
                </select>
                @if (SelectedFormat?.Kind == "zpl")
                {
                    <select class="form-select" style="max-width:220px" @bind="SelectedPrinter" disabled="@IsPrinting">
                        <option value="">(default printer of the host)</option>
                        @foreach (var printer in Printers)
                        {
                            <option value="@printer">@printer</option>
                        }
                    </select>
                }
                <button type="button" class="btn btn-outline-dark" disabled="@(IsLoading || IsPrinting || SelectedFormat is null || Items.Count == 0 || !IsDeviceConnected)" @onclick="OnPrintLabelClick">
                    Print label
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@IsLoading" @onclick="OnClearClick">@TextResources.APP_StringKeys_New</button>
                <button type="button" class="btn btn-success" disabled="@(IsLoading || Items.Count == 0 || string.IsNullOrWhiteSpace(PackageEpc))" @onclick="OnSaveClick">
                    @TextResources.APP_StringKeys_Save
                </button>
            </div>
        </div>
        <div class="card-body">
            <TelerikGrid Data="Items" Pageable="true" PageSize="10" Sortable="true">
                <GridColumns>
                    <GridColumn Field="@nameof(PackageItem.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(PackageItem.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(PackageItem.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(PackageItem.ProductCount)" Title="@TextResources.APP_StringKeys_Value" />
                    <GridColumn Title="@TextResources.APP_StringKeys_Status">
                        <Template Context="row">
                            @{
                                var item = (PackageItem)row;
                            }
                            @if (string.IsNullOrEmpty(item.TagTreeParentSerial))
                            {
                                <span class="badge bg-secondary">@TextResources.APP_StringKeys_New</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">@item.TagTreeParentSerial</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Title="@TextResources.APP_StringKeys_Delete" Width="120px">
                        <Template Context="row">
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@IsLoading" @onclick="() => OnRemoveClick((PackageItem)row)">
                                @TextResources.APP_StringKeys_Delete
                            </button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    </div>
</div>
