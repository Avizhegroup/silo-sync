@page "/register/package"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.PackageTitle" Subtitle="@RegisterTexts.PackageSubtitle" ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps" />

    <div class="row g-3">
        <div class="col-lg-6">
            <SectionCard Step="1" Title="@RegisterTexts.PackageStepAdd" Hint="@RegisterTexts.PackageStepAddHint" Class="h-100">
                <div class="row g-3 align-items-end">
                    <FormField Class="col-md-8" Label="@TextResources.APP_StringKeys_ProductSerial" For="pkg-serial">
                        <ScanInput Id="pkg-serial" @bind-Value="Serial" OnKeyUp="OnSerialKeyUp" />
                    </FormField>
                    <div class="col-md-4">
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsLoading)" OnClick="OnAddClick">
                            <MaterialIcon IconName="@MaterialIconsHelper.Add" /> @TextResources.APP_StringKeys_Add
                        </TelerikButton>
                    </div>
                </div>
            </SectionCard>
        </div>
        <div class="col-lg-6">
            <SectionCard Step="2" Title="@RegisterTexts.PackageStepPackage" Hint="@RegisterTexts.PackageStepPackageHint" Class="h-100">
                <div class="row g-3 align-items-end">
                    <FormField Class="col-md-4" Label="@TextResources.APP_StringKeys_ParentCode" For="pkg-code">
                        <ScanInput Id="pkg-code" @bind-Value="PackageCode" OnKeyUp="OnPackageCodeKeyUp" />
                    </FormField>
                    <FormField Class="col-md-8" Label="@RegisterTexts.PackageEpcLabel" For="pkg-epc">
                        <ScanInput Id="pkg-epc" @bind-Value="PackageEpc" MaxLength="24" />
                    </FormField>
                    <div class="col-12 d-flex flex-wrap gap-2">
                        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Enabled="@(!IsLoading)" OnClick="OnLoadPackageClick">
                            <MaterialIcon IconName="@MaterialIconsHelper.Search" /> @TextResources.APP_StringKeys_Search
                        </TelerikButton>
                        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       ThemeColor="@(IsReading ? ThemeConstants.Button.ThemeColor.Warning : ThemeConstants.Button.ThemeColor.Primary)"
                                       Enabled="@(!IsLoading && IsDeviceConnected)" OnClick="OnReadTagClick"
                                       Title="@(IsDeviceConnected ? RegisterTexts.PackageReadTagHint : RegisterTexts.PackageReaderNotConnected)">
                            <MaterialIcon IconName="@MaterialIconsHelper.Sensors" /> @(IsReading ? RegisterTexts.PackageWaitingTag : RegisterTexts.PackageReadTag)
                        </TelerikButton>
                    </div>
                </div>
            </SectionCard>
        </div>
    </div>

    <SectionCard Step="3" Title="@RegisterTexts.PackageStepItems">
        <HeaderContent>
            <span class="badge rounded-pill bg-secondary">@TextResources.APP_StringKeys_Count: @Items.Count</span>
            <span class="text-secondary">@TextResources.APP_StringKeys_Value: @TotalValue.ToString("0.##")</span>
        </HeaderContent>
        <ChildContent>
            <div class="row g-3 align-items-end mb-3">
                <FormField Class="col-md-4" Label="@RegisterTexts.LabelFormat" For="pkg-format">
                    <LabelFormatSelect Id="pkg-format" Formats="Formats" @bind-Value="SelectedFormatKey" Enabled="@(!IsPrinting && IsDeviceConnected)" />
                </FormField>
                @if (SelectedFormat?.Kind == "zpl")
                {
                    <FormField Class="col-md-4" Label="@RegisterTexts.PrinterLabel" For="pkg-printer">
                        <PrinterSelect Id="pkg-printer" Printers="Printers" @bind-Value="SelectedPrinter"
                                       DefaultText="@RegisterTexts.PackageDefaultPrinterLabel" Enabled="@(!IsPrinting)" />
                    </FormField>
                }
                <div class="col-auto d-flex flex-wrap gap-2">
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                                   Enabled="@(!IsLoading && !IsPrinting && SelectedFormat is not null && Items.Count > 0 && IsDeviceConnected)" OnClick="OnPrintLabelClick"
                                   Title="@(SelectedFormat is null ? RegisterTexts.PrintSelectedFormat : RegisterTexts.PackagePrintLabel)">
                        <MaterialIcon IconName="@MaterialIconsHelper.Print" /> @RegisterTexts.PackagePrintLabel
                    </TelerikButton>
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(!IsLoading)" OnClick="OnClearClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Refresh" /> @TextResources.APP_StringKeys_New
                    </TelerikButton>
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Success" Enabled="@(!IsLoading && Items.Count > 0)" OnClick="OnSaveClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Save" /> @TextResources.APP_StringKeys_Save
                    </TelerikButton>
                </div>
            </div>

            <RegisterGrid TItem="PackageItem" Data="Items" EmptyText="@RegisterTexts.PackageItemsEmpty">
                <Columns>
                    <GridColumn Field="@nameof(PackageItem.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(PackageItem.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(PackageItem.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(PackageItem.ProductCount)" Title="@TextResources.APP_StringKeys_Value" />
                    <GridColumn Title="@TextResources.APP_StringKeys_Status">
                        <Template Context="row">
                            @{
                                var item = (PackageItem)row;
                            }
                            @if (string.IsNullOrEmpty(item.TagTreeParentSerial))
                            {
                                <span class="badge bg-secondary">@TextResources.APP_StringKeys_New</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">@item.TagTreeParentSerial</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Title="@TextResources.APP_StringKeys_Delete" Width="120px" Sortable="false">
                        <Template Context="row">
                            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" FillMode="@ThemeConstants.Button.FillMode.Outline"
                                           Size="@ThemeConstants.Button.Size.Small" Enabled="@(!IsLoading)" OnClick="@(() => OnRemoveClick((PackageItem)row))">
                                <MaterialIcon IconName="@MaterialIconsHelper.Delete" /> @TextResources.APP_StringKeys_Delete
                            </TelerikButton>
                        </Template>
                    </GridColumn>
                </Columns>
            </RegisterGrid>
        </ChildContent>
    </SectionCard>
</div>

<PageLoader Visible="IsLoading" />
