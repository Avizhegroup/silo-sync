@page "/register/print"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.PrintTitle" Subtitle="@RegisterTexts.PrintSubtitle" ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps">
        <NavLink href="/register/batch" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Register</NavLink>
    </PageHeader>

    <SectionCard Step="1" Title="@RegisterTexts.PrintStepOperation" Hint="@RegisterTexts.PrintStepOperationHint">
        <div class="row g-3 align-items-end">
            <FormField Class="col-md-4 col-lg-3" Label="@TextResources.APP_StringKeys_OperationCode" For="print-action">
                <ScanInput Id="print-action" @bind-Value="ActionId" OnKeyUp="OnActionKeyUp" />
            </FormField>
            <div class="col-auto">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsLoading && !IsBusy)" OnClick="LoadAsync">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search" /> @RegisterTexts.PrintLoadSerials
                </TelerikButton>
            </div>
        </div>
    </SectionCard>

    <SectionCard Step="2" Title="@RegisterTexts.PrintStepSettings">
        <HeaderContent>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(IsDeviceConnected && !IsBusy)" OnClick="RefreshDeviceAsync"
                           Title="@RegisterTexts.DeviceNeededHint">
                <MaterialIcon IconName="@MaterialIconsHelper.Refresh" /> @TextResources.APP_StringKeys_Refresh
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(IsDeviceConnected && !IsBusy && SelectedFormat is not null && !IsPdf)" OnClick="CheckPrinterAsync">
                <MaterialIcon IconName="@MaterialIconsHelper.Print" /> @RegisterTexts.PrintCheckPrinter
            </TelerikButton>
        </HeaderContent>
        <ChildContent>
            <div class="row g-3 align-items-start">
                <FormField Class="col-md-6 col-xl-4" Label="@RegisterTexts.PrintMode" For="print-mode">
                    <OptionSelect Id="print-mode" Options="ModeOptions" Value="@PrintMode" ValueChanged="OnModeChanged" DefaultText="@null" Enabled="@(!IsBusy)" />
                </FormField>
                <FormField Class="col-md-6 col-xl-4" Label="@RegisterTexts.LabelFormat" For="print-format">
                    <LabelFormatSelect Id="print-format" Formats="VisibleFormats" @bind-Value="SelectedFormatKey" Enabled="@(!IsBusy)" />
                </FormField>
                @if (SelectedFormat?.IsFastReport == true)
                {
                    <FormField Class="col-md-6 col-xl-4" Label="@RegisterTexts.PrintFrxOutput" For="print-output">
                        <OptionSelect Id="print-output" Options="OutputOptions" @bind-Value="FrxOutput" DefaultText="@null" Enabled="@(!IsBusy)" />
                    </FormField>
                }
                @if (NeedsPrinter)
                {
                    <FormField Class="col-md-6 col-xl-4" Label="@RegisterTexts.PrinterLabel" For="print-printer">
                        <PrinterSelect Id="print-printer" Printers="Printers" @bind-Value="SelectedPrinter"
                                       DefaultText="@(SelectedFormat?.IsFastReport == true ? RegisterTexts.PrinterFromFile : RegisterTexts.PrinterDefault)" Enabled="@(!IsBusy)" />
                    </FormField>
                }
                <FormField Class="col-md-6 col-xl-4" Label="@RegisterTexts.PrintEpcType" For="print-epc-type">
                    <OptionSelect Id="print-epc-type" Options="EpcTypeOptions" @bind-Value="EpcType" DefaultText="@null" Enabled="@(!IsBusy)" />
                </FormField>
                <div class="col-12 d-flex flex-wrap gap-4">
                    @if (Formats.Any(p => p.IsFastReport))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <TelerikCheckBox Id="print-brand" @bind-Value="FilterByBrand" Enabled="@(!IsBusy)" />
                            <label for="print-brand">@RegisterTexts.PrintFilterBrand</label>
                        </div>
                    }
                    @if (SelectedFormat?.Kind == "zmin")
                    {
                        <div class="d-flex align-items-center gap-2">
                            <TelerikCheckBox Id="print-rfid" @bind-Value="WriteRfid" Enabled="@(!IsBusy)" />
                            <label for="print-rfid">@RegisterTexts.PrintWriteRfid</label>
                        </div>
                    }
                    <div class="d-flex align-items-center gap-2">
                        <TelerikCheckBox Id="print-reprint" @bind-Value="AllowReprint" Enabled="@(!IsBusy)" />
                        <label for="print-reprint">@RegisterTexts.PrintAllowReprint</label>
                    </div>
                </div>
            </div>
        </ChildContent>
    </SectionCard>

    <SectionCard Step="3" Title="@($"{RegisterTexts.PrintStepSerials} ({Rows.Count})")">
        <HeaderContent>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Size="@ThemeConstants.Button.Size.Small" Enabled="@(!IsBusy)" OnClick="@(() => SelectAll(true))">
                <MaterialIcon IconName="@MaterialIconsHelper.SelectAll" /> @TextResources.APP_StringKeys_Print_SelectAll
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Size="@ThemeConstants.Button.Size.Small" Enabled="@(!IsBusy)" OnClick="@(() => SelectAll(false))">
                <MaterialIcon IconName="@MaterialIconsHelper.DeleteSweep" /> @TextResources.APP_StringKeys_Clear
            </TelerikButton>
            @if (PrintMode == "print")
            {
                <NavLink href="/register/pair" class="btn btn-sm btn-outline-primary">@RegisterTexts.PrintPair</NavLink>
            }
            @if (SelectedFormat?.IsFastReport == true)
            {
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="CanPrint" OnClick="PreviewAsync">
                    <MaterialIcon IconName="@MaterialIconsHelper.PictureAsPdf" /> @RegisterTexts.PrintPreview
                </TelerikButton>
            }
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Success" Enabled="CanPrint" OnClick="PrintSelectedAsync"
                           Title="@(SelectedFormat is null ? RegisterTexts.PrintSelectedFormat : PrintButtonText)">
                <MaterialIcon IconName="@MaterialIconsHelper.Print" /> @PrintButtonText (@Rows.Count(p => p.IsSelected))
            </TelerikButton>
        </HeaderContent>
        <ChildContent>
            <RegisterGrid TItem="PrintLabelRow" Data="Rows" PageSize="20" Sortable="false" RowKind="RowKind" EmptyText="@RegisterTexts.PrintRowsEmpty">
                <Columns>
                    <GridColumn Title="" Width="60px" Sortable="false">
                        <Template Context="item">
                            @{
                                var row = (PrintLabelRow)item;
                            }
                            <TelerikCheckBox @bind-Value="row.IsSelected" Enabled="@(!IsBusy)" />
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PrintLabelRow.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(PrintLabelRow.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(PrintLabelRow.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(PrintLabelRow.TagEpc)" Title="@TextResources.APP_StringKeys_TagEPC" />
                    <GridColumn Title="@TextResources.APP_StringKeys_Status">
                        <Template Context="item">
                            @{
                                var row = (PrintLabelRow)item;
                            }
                            @(string.IsNullOrEmpty(row.Status) ? (row.RegisterFlag ? RegisterTexts.Registered : string.Empty) : row.Status)
                        </Template>
                    </GridColumn>
                </Columns>
            </RegisterGrid>
        </ChildContent>
    </SectionCard>
</div>
<PageLoader Visible="@(IsLoading || IsBusy)" />
