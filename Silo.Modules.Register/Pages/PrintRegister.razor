@page "/register/print"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">1. Operation</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="print-action" class="form-label">@TextResources.APP_StringKeys_OperationCode</label>
                <input id="print-action" class="form-control" style="max-width:180px" @bind="ActionId" @bind:event="oninput"
                       @onkeyup="OnActionKeyUp" inputmode="numeric" />
            </div>
            <button type="button" class="btn btn-primary" disabled="@(IsLoading || IsBusy)" @onclick="LoadAsync">Load serials</button>
            <NavLink href="/register/batch" class="btn btn-outline-secondary">@TextResources.APP_StringKeys_Register</NavLink>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">2. Label and printer</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="print-mode" class="form-label">Mode</label>
                <select id="print-mode" class="form-select" style="min-width:260px" value="@PrintMode" @onchange="OnModeChanged" disabled="@IsBusy">
                    <option value="register">Register the tag, then print (RFID label printer)</option>
                    <option value="print">Print only (pair the tags later by barcode)</option>
                    <option value="autoregister">Print the barcode, then register automatically</option>
                </select>
            </div>
            <div>
                <label for="print-format" class="form-label">Label format</label>
                <select id="print-format" class="form-select" style="min-width:260px" @bind="SelectedFormatKey" disabled="@IsBusy">
                    <option value="">-</option>
                    @foreach (var format in VisibleFormats)
                    {
                        <option value="@format.Key">@format.Display</option>
                    }
                </select>
            </div>
            @if (Formats.Any(p => p.IsFastReport))
            {
                <div class="form-check">
                    <input id="print-brand" type="checkbox" class="form-check-input" @bind="FilterByBrand" disabled="@IsBusy" />
                    <label for="print-brand" class="form-check-label">Only FastReport formats of the product's brand</label>
                </div>
            }
            @if (SelectedFormat?.IsFastReport == true)
            {
                <div>
                    <label for="print-output" class="form-label">FastReport output</label>
                    <select id="print-output" class="form-select" @bind="FrxOutput" disabled="@IsBusy">
                        <option value="print">Printer</option>
                        <option value="pdf">One PDF (opens on the workstation)</option>
                    </select>
                </div>
            }
            @if (NeedsPrinter)
            {
                <div>
                    <label for="print-printer" class="form-label">Printer</label>
                    <select id="print-printer" class="form-select" style="min-width:240px" @bind="SelectedPrinter" disabled="@IsBusy">
                        <option value="">@(SelectedFormat?.IsFastReport == true ? "(printer named in the file, else the host default)" : "(default of the device host)")</option>
                        @foreach (var printer in Printers)
                        {
                            <option value="@printer">@printer</option>
                        }
                    </select>
                </div>
            }
            @if (SelectedFormat?.Kind == "zmin")
            {
                <div class="form-check">
                    <input id="print-rfid" type="checkbox" class="form-check-input" @bind="WriteRfid" disabled="@IsBusy" />
                    <label for="print-rfid" class="form-check-label">Write the RFID chip while printing</label>
                </div>
            }
            <div>
                <label for="print-epc-type" class="form-label">EPC type (server)</label>
                <select id="print-epc-type" class="form-select" @bind="EpcType" disabled="@IsBusy">
                    <option value="2">2 - product code + new serial</option>
                    <option value="1">1 - product code + random + serial</option>
                    <option value="kdt">kdt</option>
                </select>
            </div>
            <div class="form-check">
                <input id="print-reprint" type="checkbox" class="form-check-input" @bind="AllowReprint" disabled="@IsBusy" />
                <label for="print-reprint" class="form-check-label">Allow reprint of serials that are already registered</label>
            </div>
            <button type="button" class="btn btn-outline-secondary" disabled="@(!IsDeviceConnected || IsBusy)" @onclick="RefreshDeviceAsync">Refresh list</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(!IsDeviceConnected || IsBusy || SelectedFormat is null || IsPdf)" @onclick="CheckPrinterAsync">Check printer</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap gap-3 align-items-center">
            <span class="fw-bold">3. Serials (@Rows.Count)</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => SelectAll(true)">Select all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => SelectAll(false)">Clear</button>
            @if (PrintMode == "print")
            {
                <NavLink href="/register/pair" class="btn btn-sm btn-outline-primary">Pair printed labels with tags</NavLink>
            }
            @if (SelectedFormat?.IsFastReport == true)
            {
                <button type="button" class="btn btn-outline-secondary ms-auto" disabled="@(!CanPrint)" @onclick="PreviewAsync">Preview first (PDF)</button>
            }
            <button type="button" class="btn btn-success @(SelectedFormat?.IsFastReport == true ? string.Empty : "ms-auto")"
                    disabled="@(!CanPrint)" @onclick="PrintSelectedAsync">@PrintButtonText (@Rows.Count(p => p.IsSelected))</button>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>@TextResources.APP_StringKeys_ProductSerial</th>
                        <th>@TextResources.APP_StringKeys_ProductCode</th>
                        <th>@TextResources.APP_StringKeys_ProductName</th>
                        <th>EPC</th>
                        <th>@TextResources.APP_StringKeys_Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr class="@RowClass(row)">
                            <td><input type="checkbox" @bind="row.IsSelected" disabled="@IsBusy" /></td>
                            <td>@row.ProductSerial</td>
                            <td>@row.ProductCode</td>
                            <td>@row.ProductName</td>
                            <td class="font-monospace">@row.TagEpc</td>
                            <td>@(string.IsNullOrEmpty(row.Status) ? (row.RegisterFlag ? "Registered" : string.Empty) : row.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<TelerikLoaderContainer Visible="@(IsLoading || IsBusy)" />
