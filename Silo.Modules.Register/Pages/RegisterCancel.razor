@page "/register/cancel"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@TextResources.APP_StringKeys_Revoke</PageTitle>

<div class="container-fluid mt-3" dir="rtl">
    <h1 class="h4">@TextResources.APP_StringKeys_Revoke</h1>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label">@TextResources.APP_StringKeys_ProductSerial</label>
                    <input class="form-control" @bind="Serial" @bind:event="oninput" />
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <button class="btn btn-outline-primary" @onclick="LoadTag" disabled="@IsLoading">@TextResources.APP_StringKeys_Search</button>
                </div>
            </div>
            @if (Tag is not null)
            {
                <dl class="row mt-3">
                    <dt class="col-sm-3">@TextResources.APP_StringKeys_ProductSerial</dt><dd class="col-sm-9">@Tag.ProductSerial</dd>
                    <dt class="col-sm-3">@TextResources.APP_StringKeys_ProductCode</dt><dd class="col-sm-9">@Tag.ProductCode</dd>
                    <dt class="col-sm-3">@TextResources.APP_StringKeys_ProductName</dt><dd class="col-sm-9">@Tag.ProductName</dd>
                    <dt class="col-sm-3">@TextResources.APP_StringKeys_Chart_Regcode</dt><dd class="col-sm-9">@Tag.RegCode</dd>
                </dl>
                <button class="btn btn-danger" @onclick="CancelRegistration" disabled="@IsLoading">@TextResources.APP_StringKeys_Revoke</button>
            }
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="alert @(Succeeded ? "alert-success" : "alert-danger") mt-3" role="status">@Message</div>
            }
        </div>
    </div>
</div>
