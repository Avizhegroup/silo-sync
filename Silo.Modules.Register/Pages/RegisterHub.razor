@page "/register"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@TextResources.APP_StringKeys_Register</PageTitle>

<div class="container-fluid mt-3">
    <h1 class="h3 mb-3">@TextResources.APP_StringKeys_Register</h1>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@TextResources.APP_StringKeys_OperationInfo @TextResources.APP_StringKeys_Register</h2>
                    <p>Prepare production print actions and review their serial rows.</p>
                    <a class="btn btn-primary" href="/print/management">Open print management</a>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Product master data</h2>
                    <p>Manage products and production types used by registration workflows.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/product/add">Products</a>
                        <a class="btn btn-outline-primary" href="/product/addproducttype">Production types</a>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Registration reports</h2>
                    <p>Review print activity and tag history.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/print/report">Print report</a>
                        <a class="btn btn-outline-primary" href="/report/taghistory">Tag history</a>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Tag maintenance</h2>
                    <p>Update tag details or transfer tag counts.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/tag/edit">Edit tags</a>
                        <a class="btn btn-outline-primary" href="/tag/transfer">Transfer counts</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
