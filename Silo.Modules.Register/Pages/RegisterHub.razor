@page "/register"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@TextResources.APP_StringKeys_Register</PageTitle>

<div class="container-fluid mt-3">
    <h1 class="h3 mb-3">@TextResources.APP_StringKeys_Register</h1>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@TextResources.APP_StringKeys_OperationInfo @TextResources.APP_StringKeys_Register</h2>
                    <a class="btn btn-primary" href="/print/management">@TextResources.APP_StringKeys_Print</a>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@TextResources.APP_StringKeys_Product</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/product/add">@TextResources.APP_StringKeys_Product</a>
                        <a class="btn btn-outline-primary" href="/product/addproducttype">@TextResources.APP_StringKeys_ProductType</a>
                        <a class="btn btn-outline-primary" href="/register/settings">@TextResources.APP_StringKeys_Settings</a>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@TextResources.APP_StringKeys_Reports</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/print/report">@TextResources.APP_StringKeys_Print</a>
                        <a class="btn btn-outline-primary" href="/report/taghistory">@TextResources.APP_StringKeys_Tagzone</a>
                        <a class="btn btn-outline-primary" href="/register/reports">@TextResources.APP_StringKeys_Register</a>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@TextResources.APP_StringKeys_Tagzone</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" href="/tag/edit">@TextResources.APP_StringKeys_Edit</a>
                        <a class="btn btn-outline-primary" href="/tag/transfer">@TextResources.APP_StringKeys_ProductCount</a>
                        <a class="btn btn-outline-primary" href="/register/rfid">@TextResources.APP_StringKeys_Register</a>
                        <a class="btn btn-outline-primary" href="/register/cancel">@TextResources.APP_StringKeys_Revoke</a>
                        <a class="btn btn-outline-primary" href="/register/date">@TextResources.APP_StringKeys_Date</a>
                        <a class="btn btn-outline-primary" href="/register/package">@TextResources.APP_StringKeys_ProductPackWeight</a>
                        <a class="btn btn-outline-primary" href="/register/verify">@TextResources.APP_StringKeys_Search</a>
                        <a class="btn btn-outline-primary" href="/register/verify-group">@TextResources.APP_StringKeys_Reports</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
