@page "/register/reportmatrix"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@PageTitle</PageTitle>

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.MatrixTitle" Subtitle="@RegisterTexts.MatrixSubtitle" Steps="HowToSteps" />

    <SectionCard Step="1" Title="@TextResources.APP_StringKeys_Filters">
        <div class="row g-3">
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_FromDate" For="mx-from" Hint="@RegisterTexts.MatrixDateHint"
                       Error="@(FromDateError ? RegisterTexts.MatrixInvalidFormat : null)">
                <TelerikTextBox Id="mx-from" @bind-Value="FromDate" MaxLength="10" Placeholder="1404/05/12" Width="100%" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@RegisterTexts.MatrixFromTime" For="mx-ftime" Hint="@RegisterTexts.MatrixTimeHint">
                <TelerikTextBox Id="mx-ftime" @bind-Value="FromTime" MaxLength="5" Placeholder="06:00" Width="100%" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_ToDate" For="mx-to" Hint="@RegisterTexts.MatrixDateHint"
                       Error="@(ToDateError ? RegisterTexts.MatrixInvalidFormat : null)">
                <TelerikTextBox Id="mx-to" @bind-Value="ToDate" MaxLength="10" Placeholder="1404/05/12" Width="100%" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@RegisterTexts.MatrixToTime" For="mx-ttime" Hint="@RegisterTexts.MatrixTimeHint"
                       Error="@(TimeError ? RegisterTexts.MatrixInvalidFormat : null)">
                <TelerikTextBox Id="mx-ttime" @bind-Value="ToTime" MaxLength="5" Placeholder="14:00" Width="100%" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_Line" For="mx-line">
                <OptionSelect Id="mx-line" Options="LineOptions" @bind-Value="Line" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_Chart_Shift" For="mx-shift">
                <OptionSelect Id="mx-shift" Options="ShiftOptions" @bind-Value="Shift" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_Chart_Qc" For="mx-qc">
                <OptionSelect Id="mx-qc" Options="QcOptions" @bind-Value="Qc" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_Product_Size" For="mx-size">
                <OptionSelect Id="mx-size" Options="SizeOptions" @bind-Value="Size" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_ProductCode" For="mx-code">
                <TelerikTextBox Id="mx-code" @bind-Value="ProductCode" Width="100%" />
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_Chart_Regcode" For="mx-tech">
                <TelerikTextBox Id="mx-tech" @bind-Value="TechnicalCode" Width="100%" />
                <div class="d-flex align-items-center gap-2 mt-1">
                    <TelerikCheckBox Id="mx-like" @bind-Value="TechnicalCodeLike" />
                    <label for="mx-like" class="small">@TextResources.APP_StringKeys_Like</label>
                </div>
            </FormField>
            <FormField Class="col-md-3 col-xl-2" Label="@TextResources.APP_StringKeys_DocKey" For="mx-doc">
                <TelerikTextBox Id="mx-doc" @bind-Value="DocumentId" Width="100%" />
            </FormField>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsLoading)" OnClick="OnSearchClick">
                <MaterialIcon IconName="@MaterialIconsHelper.Search" /> @TextResources.APP_StringKeys_Search
            </TelerikButton>
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(!IsLoading)" OnClick="OnClearClick">
                <MaterialIcon IconName="@MaterialIconsHelper.Refresh" /> @TextResources.APP_StringKeys_Clear
            </TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Success" FillMode="@ThemeConstants.Button.FillMode.Outline"
                           Enabled="@(!IsLoading && PivotRows.Count > 0)" OnClick="OnExcelClick">
                <MaterialIcon IconName="@MaterialIconsHelper.Download" /> @TextResources.APP_StringKeys_ExportExcel
            </TelerikButton>
        </div>
    </SectionCard>

    @if (Result is null)
    {
        <StatusMessage Kind="info" Message="@RegisterTexts.MatrixEmpty" />
    }
    else if (PivotRows.Count == 0)
    {
        <StatusMessage Kind="warning" Message="@TextResources.APP_StringKeys_Validation_AnyData" />
    }
    else
    {
        <SectionCard Step="2" Title="@($"{TextResources.APP_StringKeys_Product_Size} / {TextResources.APP_StringKeys_Chart_Regcode}")">
            <RegisterGrid TItem="PivotRow" Data="PivotRows" PageSize="25" Sortable="false" EmptyText="@null">
                <Columns>
                    <GridColumn Field="@nameof(PivotRow.Line)" Title="@TextResources.APP_StringKeys_Line">
                        <FooterTemplate><strong>@TextResources.APP_StringKeys_SumValue</strong></FooterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(PivotRow.RegCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                    <GridColumn Field="@nameof(PivotRow.Size)" Title="@TextResources.APP_StringKeys_Product_Size" />
                    <GridColumn Field="@nameof(PivotRow.ProductType)" Title="@TextResources.APP_StringKeys_ProductType" />
                    @foreach (var qc in QcColumns)
                    {
                        var column = qc;
                        <GridColumn Title="@column" TextAlign="@ColumnTextAlign.Right">
                            <Template Context="item">@(((PivotRow)item).Value(column).ToString("0.##"))</Template>
                            <FooterTemplate><strong>@ColumnTotal(column).ToString("0.##")</strong></FooterTemplate>
                        </GridColumn>
                    }
                    <GridColumn Title="@TextResources.APP_StringKeys_SumValue" TextAlign="@ColumnTextAlign.Right">
                        <Template Context="item"><strong>@(((PivotRow)item).Total.ToString("0.##"))</strong></Template>
                        <FooterTemplate><strong>@GrandTotal.ToString("0.##")</strong></FooterTemplate>
                    </GridColumn>
                </Columns>
            </RegisterGrid>
        </SectionCard>
    }
</div>

<PageLoader Visible="IsLoading" />
