@page "/register/reports"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@TextResources.APP_StringKeys_Reports</PageTitle>

<div class="container-fluid mt-3" dir="rtl">
    <h1 class="h4">@TextResources.APP_StringKeys_Reports</h1>
    <div class="row g-3">
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm"><div class="card-body">
                <h2 class="h5">@TextResources.APP_StringKeys_Print</h2>
                <a class="btn btn-primary" href="/print/report">@TextResources.APP_StringKeys_Search</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm"><div class="card-body">
                <h2 class="h5">@TextResources.APP_StringKeys_Tagzone</h2>
                <a class="btn btn-primary" href="/report/taghistory">@TextResources.APP_StringKeys_Search</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm"><div class="card-body">
                <h2 class="h5">@TextResources.APP_StringKeys_Register</h2>
                <a class="btn btn-primary" href="/register/production-report">@TextResources.APP_StringKeys_Search</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm"><div class="card-body">
                <h2 class="h5">@TextResources.APP_StringKeys_Revoke</h2>
                <a class="btn btn-primary" href="/register/reports/cancelled">@TextResources.APP_StringKeys_Search</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm"><div class="card-body">
                <h2 class="h5">@TextResources.APP_StringKeys_Validation_BadFormat</h2>
                <a class="btn btn-primary" href="/register/reports/errors">@TextResources.APP_StringKeys_Search</a>
            </div></section>
        </div>
    </div>
</div>
