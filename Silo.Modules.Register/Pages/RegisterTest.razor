@page "/register/test"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket"
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.TestTitle" Subtitle="@RegisterTexts.TestSubtitle" ShowDevice="true" IsDeviceConnected="IsDeviceConnected" Steps="HowToSteps">
        <NavLink href="/register/test/group" class="btn btn-outline-secondary">@RegisterTexts.TestGroupLink</NavLink>
    </PageHeader>

    <SectionCard Step="1" Title="@RegisterTexts.TestStepInput">
        <div class="row g-3 align-items-start">
            <FormField Class="col-md-5" Label="@RegisterTexts.TestBarcodeLabel" For="test-barcode" Hint="@RegisterTexts.TestBarcodeHint">
                <ScanInput Id="test-barcode" @bind-Value="BarcodeInput" OnKeyUp="OnBarcodeKeyUp" />
            </FormField>
            <FormField Class="col-md-5" Label="@($"{TextResources.APP_StringKeys_TagEPC} (24)")" For="test-epc" Hint="@RegisterTexts.TestEpcHint">
                <ScanInput Id="test-epc" @bind-Value="EpcInput" OnKeyUp="OnEpcKeyUp" MaxLength="24" />
            </FormField>
            <div class="col-md-2 pt-md-4">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" Enabled="@(!IsLoading)" OnClick="OnResetClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh" /> @TextResources.APP_StringKeys_New
                </TelerikButton>
            </div>
        </div>
    </SectionCard>

    @if (ResultState == TestResultState.None)
    {
        <StatusMessage Kind="info" Message="@RegisterTexts.TestEmpty" />
    }
    else
    {
        <StatusMessage Kind="@(ResultState == TestResultState.Match ? "success" : "danger")" Message="@ResultMessage" Class="fs-5 fw-bold" />
    }

    <SectionCard Step="2" Title="@RegisterTexts.TestStepCompare">
        <RegisterGrid TItem="ComparisonRow" Data="ComparisonRows" Sortable="false" EmptyText="@null">
            <Columns>
                <GridColumn Field="@nameof(ComparisonRow.Field)" Title="@TextResources.APP_StringKeys_Title" />
                <GridColumn Field="@nameof(ComparisonRow.Label)" Title="@RegisterTexts.TestColumnLabel" />
                <GridColumn Field="@nameof(ComparisonRow.Tag)" Title="@RegisterTexts.TestColumnTag" />
            </Columns>
        </RegisterGrid>
    </SectionCard>
</div>
<PageLoader Visible="IsLoading" />
