@page "/register/test"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Telerik.Blazor.Components
@using Silo.Shared.Components

<PageTitle>@PageTitle</PageTitle>

<LocalWebSocketComponent @ref="Socket" 
                         Port="@DevicePort"
                         OnConnectionChanged="OnDeviceConnectionChanged"
                         OnMessageReceived="OnDeviceMessageReceived"
                         OnError="OnDeviceError" />
<div class="container-fluid mt-2">
   
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">1. @TextResources.APP_StringKeys_ProductSerial / EPC</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="test-barcode" class="form-label">Label barcode (serial)</label>
                <input id="test-barcode" class="form-control" style="min-width:240px" @bind="BarcodeInput" @bind:event="oninput"
                       @onkeyup="OnBarcodeKeyUp" autofocus />
            </div>
            <div>
                <label for="test-epc" class="form-label">Tag EPC (24 characters)</label>
                <input id="test-epc" class="form-control" style="min-width:280px" maxlength="24" @bind="EpcInput" @bind:event="oninput"
                       @onkeyup="OnEpcKeyUp" />
            </div>
            <button type="button" class="btn btn-outline-secondary" disabled="@IsLoading" @onclick="OnResetClick">@TextResources.APP_StringKeys_New</button>
            <NavLink href="/register/test/group" class="btn btn-outline-secondary">Group test</NavLink>
        </div>
    </div>

    @if (ResultState == TestResultState.None)
    {
        <div class="alert alert-info">Scan the label barcode and read the tag to compare them.</div>
    }
    else
    {
        <div class="alert @(ResultState == TestResultState.Match ? "alert-success" : "alert-danger") fs-5 fw-bold text-center">
            @ResultMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header fw-bold">2. Comparison</div>
        <div class="card-body">
            <TelerikGrid Data="ComparisonRows" Pageable="false" Sortable="false">
                <GridColumns>
                    <GridColumn Field="@nameof(ComparisonRow.Field)" Title="@TextResources.APP_StringKeys_Title" />
                    <GridColumn Field="@nameof(ComparisonRow.Label)" Title="Label" />
                    <GridColumn Field="@nameof(ComparisonRow.Tag)" Title="Tag" />
                </GridColumns>
            </TelerikGrid>
        </div>
    </div>
</div>
<TelerikLoaderContainer Visible="@IsLoading" />
