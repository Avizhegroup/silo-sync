@page "/register/date"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Application.Features

<PageTitle>@PageTitle</PageTitle>

<div class="container-fluid mt-2">
    <PageHeader Title="@RegisterTexts.DateTitle" Subtitle="@RegisterTexts.DateSubtitle" Steps="HowToSteps" />

    <SectionCard Step="1" Title="@RegisterTexts.DateStepFind">
        <div class="row g-3 align-items-end">
            <FormField Class="col-md-6 col-lg-4" Label="@($"{TextResources.APP_StringKeys_ProductSerial} / EPC")" For="date-serial">
                <ScanInput Id="date-serial" @bind-Value="Serial" OnKeyUp="OnSerialKeyUp" />
            </FormField>
            <div class="col-auto">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsLoading)" OnClick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search" /> @TextResources.APP_StringKeys_Search
                </TelerikButton>
            </div>
        </div>
    </SectionCard>

    @if (Product is null)
    {
        <StatusMessage Kind="info" Message="@RegisterTexts.DateFirst" />
    }
    else
    {
        <SectionCard Step="2" Title="@RegisterTexts.DateStepProduct">
            <RegisterGrid TItem="GetRevokeTagsVm" Data="ProductList" Sortable="false" EmptyText="@null">
                <Columns>
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.ProductDate)" Title="@TextResources.APP_StringKeys_Chart_ProductDate" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.Warehouse)" Title="@TextResources.APP_StringKeys_Field_Warehouse_Title" />
                    <GridColumn Field="@nameof(GetRevokeTagsVm.InspectStatus)" Title="@TextResources.APP_StringKeys_Inspect_Status" />
                </Columns>
            </RegisterGrid>
        </SectionCard>

        <StatusMessage Kind="@(CanEdit ? "success" : "danger")" Message="@EditReason" />

        <SectionCard Step="3" Title="@RegisterTexts.DateStepNew">
            <div class="row g-3 align-items-start">
                <FormField Class="col-md-4 col-lg-3" Label="@TextResources.APP_StringKeys_Date" For="date-new" Hint="@RegisterTexts.DateFormat"
                           Error="@(DateError ? RegisterTexts.DateFormat : null)">
                    <TelerikTextBox Id="date-new" @bind-Value="NewDate" MaxLength="10" Placeholder="14yy/mm/dd" Enabled="CanEdit" Width="100%" />
                </FormField>
                <FormField Class="col-md-3 col-lg-2" Label="@RegisterTexts.DateTime" For="date-time" Hint="@RegisterTexts.DateTimeFormat"
                           Error="@(TimeError ? RegisterTexts.DateTimeFormat : null)">
                    <TelerikTextBox Id="date-time" @bind-Value="NewTime" MaxLength="5" Placeholder="HH:mm" Enabled="CanEdit" Width="100%" />
                </FormField>
                <div class="col-auto pt-md-4">
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Success" Enabled="@(!IsLoading && CanEdit)" OnClick="OnSaveClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Save" /> @TextResources.APP_StringKeys_Save
                    </TelerikButton>
                </div>
            </div>
        </SectionCard>
    }
</div>

<PageLoader Visible="IsLoading" />
