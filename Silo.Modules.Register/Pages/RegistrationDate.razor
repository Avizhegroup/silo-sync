@page "/register/date"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages
@using Silo.Application.Features
@using Telerik.Blazor.Components

<PageTitle>@PageTitle</PageTitle>

<TelerikLoaderContainer Visible="@IsLoading" />

<div class="container-fluid mt-2">
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">1. @TextResources.APP_StringKeys_Search @TextResources.APP_StringKeys_ProductSerial</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label for="date-serial" class="form-label">@TextResources.APP_StringKeys_ProductSerial / EPC</label>
                <input id="date-serial" class="form-control" style="min-width:260px" @bind="Serial" @bind:event="oninput"
                       @onkeyup="OnSerialKeyUp" autofocus />
            </div>
            <button type="button" class="btn btn-primary" disabled="@(IsLoading || string.IsNullOrWhiteSpace(Serial))" @onclick="OnSearchClick">
                @TextResources.APP_StringKeys_Search
            </button>
        </div>
    </div>

    @if (Product is null)
    {
        <div class="alert alert-info">@TextResources.APP_StringKeys_ProductSerial</div>
    }
    else
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">2. @TextResources.APP_StringKeys_ProductName</div>
            <div class="card-body">
                <TelerikGrid Data="ProductList" Pageable="false" Sortable="false">
                    <GridColumns>
                        <GridColumn Field="@nameof(GetRevokeTagsVm.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                        <GridColumn Field="@nameof(GetRevokeTagsVm.ProductCode)" Title="@TextResources.APP_StringKeys_ProductCode" />
                        <GridColumn Field="@nameof(GetRevokeTagsVm.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                        <GridColumn Field="@nameof(GetRevokeTagsVm.ProductDate)" Title="@TextResources.APP_StringKeys_Chart_ProductDate" />
                        <GridColumn Field="@nameof(GetRevokeTagsVm.Warehouse)" Title="@TextResources.APP_StringKeys_Field_Warehouse_Title" />
                        <GridColumn Field="@nameof(GetRevokeTagsVm.InspectStatus)" Title="@TextResources.APP_StringKeys_Inspect_Status" />
                    </GridColumns>
                </TelerikGrid>
            </div>
        </div>

        <div class="alert @(CanEdit ? "alert-success" : "alert-danger")">@EditReason</div>

        <div class="card shadow-sm">
            <div class="card-header fw-bold">3. @TextResources.APP_StringKeys_Date</div>
            <div class="card-body d-flex flex-wrap gap-3 align-items-start">
                <div>
                    <label for="date-new" class="form-label">@TextResources.APP_StringKeys_Date (1404/01/31)</label>
                    <input id="date-new" class="form-control @(DateError ? "is-invalid" : string.Empty)" maxlength="10" disabled="@(!CanEdit)"
                           placeholder="14yy/mm/dd" @bind="NewDate" @bind:event="oninput" />
                    @if (DateError)
                    {
                        <div class="invalid-feedback">14yy/mm/dd</div>
                    }
                </div>
                <div>
                    <label for="date-time" class="form-label">HH:mm</label>
                    <input id="date-time" class="form-control @(TimeError ? "is-invalid" : string.Empty)" maxlength="5" disabled="@(!CanEdit)"
                           placeholder="HH:mm" @bind="NewTime" @bind:event="oninput" />
                    @if (TimeError)
                    {
                        <div class="invalid-feedback">HH:mm</div>
                    }
                </div>
                <div class="align-self-end">
                    <button type="button" class="btn btn-success" disabled="@(IsLoading || !IsInputValid)" @onclick="OnSaveClick">
                        @TextResources.APP_StringKeys_Save
                    </button>
                </div>
            </div>
        </div>
    }
</div>
