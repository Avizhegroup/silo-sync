@page "/register/settings"
@inherits SiloBasePage
@namespace Silo.Modules.Register.Pages

<PageTitle>@TextResources.APP_StringKeys_Settings</PageTitle>

<div class="container-fluid mt-3" dir="rtl">
    <h1 class="h4">@TextResources.APP_StringKeys_Settings</h1>
    <div class="card shadow-sm"><div class="card-body">
        <h2 class="h5">@TextResources.APP_StringKeys_Product</h2>
        <p>مدیریت داده‌های پایه و انواع محصول از صفحات موجود سامانه انجام می‌شود.</p>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/product/add">@TextResources.APP_StringKeys_Product</a>
            <a class="btn btn-outline-primary" href="/product/addproducttype">@TextResources.APP_StringKeys_ProductType</a>
        </div>
    </div></div>
</div>
