@page "/"

<PageTitle>داشبورد</PageTitle>

<h1>داشبورد</h1>

<div class="dashboard-cards">
    <div class="card">
        <div class="card-title">وضعیت اتصال</div>
        <div class="card-value @(State.IsConnected ? "status-ok" : "status-error")">
            @(State.IsConnected ? "متصل" : "قطع")
        </div>
    </div>
    <div class="card">
        <div class="card-title">وضعیت خواندن</div>
        <div class="card-value @(State.IsInventoryRunning ? "status-ok" : "status-error")">
            @(State.IsInventoryRunning ? "در حال اجرا" : "متوقف")
        </div>
    </div>
    <div class="card">
        <div class="card-title">توان آنتن</div>
        <div class="card-value">@State.CurrentPower dBm</div>
    </div>
    <div class="card">
        <div class="card-title">کد ایستگاه</div>
        <div class="card-value">@StationCode</div>
    </div>
    <div class="card">
        <div class="card-title">نوع گیت</div>
        <div class="card-value">@GateType</div>
    </div>
    <div class="card">
        <div class="card-title">تعداد تگ‌های اخیر</div>
        <div class="card-value">@State.TagCount</div>
    </div>
    <div class="card">
        <div class="card-title">تعداد ارسال موفق</div>
        <div class="card-value status-ok">@State.SuccessCount</div>
    </div>
    <div class="card">
        <div class="card-title">تعداد ارسال ناموفق</div>
        <div class="card-value @(State.FailureCount > 0 ? "status-error" : "status-ok")">@State.FailureCount</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(State.LastApiError) || State.LastApiCallUtc.HasValue)
{
    <div class="card">
        <div class="card-title">
            آخرین ارسال به سرور
            @if (State.LastApiCallUtc.HasValue)
            {
                <span class="text-muted">(@State.LastApiCallUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(State.LastApiError))
        {
            <div class="status-error">@State.LastApiError</div>
        }
        else
        {
            <div class="status-ok">آخرین ارسال موفق بود</div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(State.LastError))
{
    <div class="card">
        <div class="card-title">آخرین خطا</div>
        <div class="status-error">@State.LastError</div>
    </div>
}

<div class="card">
    <TelerikButton OnClick="OnConnectClick"
                   Enabled="!State.IsConnected"
                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
        اتصال
    </TelerikButton>
    <TelerikButton OnClick="OnDisconnectClick"
                   Enabled="State.IsConnected"
                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error">
        قطع اتصال
    </TelerikButton>
    <TelerikButton OnClick="OnStartInventoryClick"
                   Enabled="State.IsConnected && !State.IsInventoryRunning"
                   ThemeColor="@ThemeConstants.Button.ThemeColor.Success">
        شروع خواندن
    </TelerikButton>
    <TelerikButton OnClick="OnStopInventoryClick"
                   Enabled="State.IsInventoryRunning"
                   ThemeColor="@ThemeConstants.Button.ThemeColor.Warning">
        توقف خواندن
    </TelerikButton>
</div>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="@LoaderType.InfiniteSpinner"
                        Text="لطفاً صبر کنید..." />
