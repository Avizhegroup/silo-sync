@page "/live-tags"

<PageTitle>تگ‌های خوانده‌شده</PageTitle>

<h1>تگ‌های خوانده‌شده</h1>

<TelerikGrid Data="Tags"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterRow"
             Pageable="true"
             PageSize="25"
             @ref="GridRef">
    <GridToolBarTemplate>
        <TelerikButton Title="پاک کردن"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       OnClick="OnClearClick">
            پاک کردن
        </TelerikButton>
        <TelerikButton Title="خروجی اکسل"
                       OnClick="OnExportExcelClick">
            خروجی اکسل
        </TelerikButton>
    </GridToolBarTemplate>
    <GridColumns>
        <GridColumn Field="@nameof(TagReadEntry.Epc)" Title="EPC" />
        <GridColumn Field="@nameof(TagReadEntry.ReadUtc)" Title="زمان خواندن" DisplayFormat="{0:yyyy-MM-dd HH:mm:ss.fff}" />
        <GridColumn Field="@nameof(TagReadEntry.StationCode)" Title="کد ایستگاه" />
        <GridColumn Field="@nameof(TagReadEntry.GateType)" Title="نوع گیت" />
        <GridColumn Field="@nameof(TagReadEntry.PostSucceeded)" Title="نتیجه ارسال">
            <Template>
                @{
                    var entry = (TagReadEntry)context;
                    <span class="@(entry.PostSucceeded ? "status-ok" : "status-error")">
                        @(entry.PostSucceeded ? "موفق" : "ناموفق")
                    </span>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TagReadEntry.ErrorMessage)" Title="پیام خطا" />
    </GridColumns>
</TelerikGrid>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="@LoaderType.InfiniteSpinner"
                        Text="لطفاً صبر کنید..." />
