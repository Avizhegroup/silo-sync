@page "/logs"

<PageTitle>لاگ‌ها</PageTitle>

<h1>لاگ‌ها</h1>

<div class="card">
    <div class="form-row">
        <label>نوع لاگ</label>
        <TelerikDropDownList Data="LogKinds"
                             @bind-Value="SelectedKind"
                             TextField="Text"
                             ValueField="Kind"
                             OnChange="OnLogKindChange" />
    </div>
    <div class="form-row">
        <label>فایل لاگ</label>
        <TelerikDropDownList Data="LogFiles"
                             @bind-Value="SelectedFile"
                             TextField="Name"
                             ValueField="Path"
                             OnChange="OnRefreshClick" />
    </div>
    <div class="form-row">
        <label>تعداد خطوط</label>
        <TelerikNumericTextBox @bind-Value="LineCount" Min="10" Max="5000" Step="50" />
    </div>

    <TelerikButton OnClick="OnRefreshClick"
                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
        به‌روزرسانی
    </TelerikButton>
    <TelerikCheckBox @bind-Value="AutoRefresh" Id="auto-refresh" />
    <label for="auto-refresh">به‌روزرسانی خودکار هر ۵ ثانیه</label>
</div>

<pre class="pre-wrap">@LogContent</pre>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="@LoaderType.InfiniteSpinner"
                        Text="لطفاً صبر کنید..." />
