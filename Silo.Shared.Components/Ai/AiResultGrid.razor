@namespace Silo.Shared.Components.Ai
@using System.Text.Json
@using Telerik.SvgIcons
@using Silo.Shared.Components.Modals

@if (Data != null && Data.Any() && Data[0] != null)
{
    var gridData = ParseGridData(Data[0]);

    @if (gridData.Any())
    {
        var columns = gridData.First().Keys.ToList();

        <div class="mt-3 ai-grid-wrapper">
            <TelerikGrid Data="@gridData"
                         Pageable="true"
                         PageSize="10"
                         Sortable="true"
                         Resizable="true">

                <GridToolBarTemplate>
                    <TelerikButton OnClick="@(() => ExportToExcelAsync(Data[0]))"
                                   Icon="@SvgIcon.FileExcel"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                                   Title="دریافت فایل اکسل">
                        دریافت فایل اکسل
                    </TelerikButton>

                    @if (ShowSaveButton)
                    {
                        <TelerikButton OnClick="@OnSaveReportClick"
                                       Icon="@SvgIcon.Save"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Title="ثبت گزارش">
                            ثبت گزارش
                        </TelerikButton>
                    }

                    <span class="k-toolbar-spacer"></span>
                </GridToolBarTemplate>

                <GridColumns>
                    @foreach (var col in columns)
                    {
                        <GridColumn Field="@col"
                                    Title="@col"
                                    FieldType="@(typeof(string))" />
                    }
                </GridColumns>
            </TelerikGrid>
        </div>
    }
    else
    {
        <div class="mt-3">
            <p class="bg-warning p-2 rounded text-dark">
                نتیجه‌ای برای نمایش وجود ندارد.
            </p>
        </div>
    }

    @if (ShowSaveButton)
    {
        <Modal Buttons="ModalButtons.No"
               ModalTitle="@TextResources.APP_StringKeys_Save"
               @ref="FormatModal"
               Size="ModalSize.Large"
               CloseBtnText="@TextResources.APP_StringKeys_Close">
            <ModalBodyContentHtml>
                <AiReportFormatSection Mode="@Mode"
                                       QueryId="@QueryId"
                                       OnSaved="OnFormatSaved" />
            </ModalBodyContentHtml>
        </Modal>
    }
}