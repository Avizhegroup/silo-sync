@namespace Silo.Shared.Components.Ai
@using Microsoft.AspNetCore.Components.Forms
@using Silo.Shared.Components.Modals
@using Silo.Application.Dto

<Modal Buttons="ModalButtons.No"
       ModalTitle="@TextResources.APP_StringKeys_Save"
       @ref="Modal"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            <EditForm Model="this"
                      OnInvalidSubmit="OnInvalidSubmit"
                      OnValidSubmit="OnValidSubmit">

                <div class="form-group mb-3">
                    <label class="form-label">@($"{TextResources.APP_StringKeys_Field_Title}*")</label>
                    <div class="k-form-field-wrap">
                        <input type="text" 
                               @bind="ReportName" 
                               class="form-control" 
                               placeholder="@TextResources.APP_StringKeys_Field_Title" />
                    </div>
                </div>

                @* <div class="form-group mb-3">
                    <label class="form-label">@TextResources.APP_StringKeys_Validation_Choose</label>
                    <TelerikDropDownList Data="MenuCategories"
                                         @bind-Value="SelectedCategoryId"
                                         TextField="Title"
                                         ValueField="Id"
                                         Class="form-control">
                    </TelerikDropDownList>
                </div> *@

                <div class="form-group mb-3">
                    <label class="form-label">@TextResources.APP_StringKeys_Validation_Empty</label>
                    <TelerikMultiSelect Data="AllUsers"
                                        @bind-Value="SelectedUserIds"
                                        TextField="Name"
                                        ValueField="Id"
                                        Class="form-control"
                                        Placeholder="کاربران را انتخاب کنید..."
                                        AutoClose="false">
                    </TelerikMultiSelect>
                </div>


                <div class="d-flex justify-content-end gap-2">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="async () => await Modal.Close(null)">
                        @TextResources.APP_StringKeys_Close
                    </button>
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @TextResources.APP_StringKeys_Save
                    </button>
                </div>
            </EditForm>
        </div>
    </ModalBodyContentHtml>
</Modal>

