@typeparam TColumn where TColumn : struct
@typeparam TFilter where TFilter : struct
@namespace Silo.Shared.Components.Report
@using Silo.Application.Dto
@using Silo.Application.Features
@using Silo.Shared.Components

<div class="row">
    <div class="col-md-9">
        <div class="card card-stats right-card text-align-center"
             style="margin-bottom:2px; padding:5px;">
            <div>
                <h6 class="form-title card-title" style="text-align: right !important;">
                    @TextResources.APP_StringKeys_Filters
                </h6>
            </div>
            <div class=" d-flex flex-row align-items-center flex-wrap  search-button-div" style="margin-top:-148px !important;width:480px;">
                <button class="btn btn-warning"
                        type="button"
                        title="@TextResources.APP_StringKeys_Clear"
                        style="margin-left: 2px;"
                        @onclick="()=> AddedFilters.Clear()">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button class="btn btn-success"
                        type="button"
                        title="@TextResources.APP_StringKeys_Filters"
                        style="margin-left: 2px;"
                        @onclick="OnFilterModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Filter_alt"></MaterialIcon>
                </button>
            </div>
            @if (AddedFilters.Any())
            {
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:10px!important;">
                    <div class=" d-flex flex-row align-items-center flex-wrap col-md-12" style="margin-bottom:10px!important;">
                        <FilterReportEditSectionGeneric TItem="TFilter"
                                                        Filters="AddedFilters"
                                                        OnRemoveClick="OnFilterRemove">
                        </FilterReportEditSectionGeneric>
                    </div>
                </div>
            }

        </div>
        @if (IsColumnsEditable)
        {
            <div class="card card-stats right-card text-align-center"
                 style="margin-bottom:5px; padding:5px;">
                <div>
                    <h6 class="form-title card-title" style="text-align: right !important;">
                        @TextResources.APP_StringKeys_Columns
                    </h6>
                </div>

                <div class=" d-flex flex-row align-items-center flex-wrap  search-button-div" style="margin-top:-148px !important;width:480px;">
                    <button class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                            style="margin-left: 2px;" @onclick="OnClearColumnsClick">
                        <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                    </button>
                    <button class="btn btn-success" type="button" title="@TextResources.APP_StringKeys_Columns"
                            style="margin-left: 2px;" @onclick="async(e) => await OnColumnSectionModalClick(e)">
                        <MaterialIcon IconName="@MaterialIconsHelper.List"></MaterialIcon>
                    </button>
                </div>

                <ColumnEditSectionGeneric TColumn="TColumn"
                                          AddedDataColumns="AddedDataColumns"
                                          AddedDataMiningElementColumns="AddedDataMiningElementColumns"
                                          AddedCalculatingColumns="AddedCalculatingColumns"
                                          AddedPivotColumn="AddedPivotColumn"
                                          IsEditable="IsColumnsEditable">
                </ColumnEditSectionGeneric>
            </div>
        }
    </div>
    <div class="col-md-3"
         style="margin-right: -25px">
        <div class="card card-stats left-card"
             style="height:95%">
            <div class="d-flex flex-row align-items-center flex-wrap"
                 style="padding: 25px">
                @if (IsColumnsEditable)
                {
                    <button class="btn btn-success"
                            type="button"
                            style="margin-left: 2px; "
                            @onclick="async(e)=> await ModalFormats.Open(e)">
                        <MaterialIcon IconName="@MaterialIconsHelper.List"></MaterialIcon>
                    </button>
                }
                <button class="btn btn-primary"
                        type="button"
                        style="margin-left: 2px; margin-right: 5px;"
                        @onclick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                </button>
            </div>
        </div>
    </div>
</div>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_Filters"
       @ref="ModalFilters"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            @if (ModalFilters.ModalClass.Equals("Show"))
            {
                <FilterSection TItem="TFilter"
                               Filters="Filters"
                               OnAddClick="OnAddNewFilter"
                               OnRemoveClick="OnFilterRemove">
                </FilterSection>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>
<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_Columns"
       @ref="ModalColumns"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            <CascadingValue Value="IsLoading">
                <CascadingValue Value="Notification">
                    <ColumnSection @ref="ColumnSectionRef"
                                   TColumn="TColumn"
                                   CalculatingColumns="CalculatingColumns"
                                   DataColumns="DataColumns"
                                   DataMiningElementColumns="DataMiningElementColumns"
                                   PivotColumns="PivotColumns"
                                   OnCalculatingColumnAdd="OnCalculatingColumnAdd"
                                   OnDataColumnAdd="OnDataColumnAdd"
                                   OnDataMiningElementColumnAdd="OnDataMiningElementColumnAdd"
                                   OnCalculatingColumnRemove="OnCalculatingColumnRemove"
                                   OnDataColumnRemove="OnDataColumnRemove"
                                   OnDataMiningElementColumnRemove="OnDataMiningElementColumnRemove"
                                   OnPivotColumnAdd="OnPivotColumnAdd"
                                   OnPivotColumnRemove="OnPivotColumnRemove">
                    </ColumnSection>
                </CascadingValue>
            </CascadingValue>
        </div>
    </ModalBodyContentHtml>
</Modal>
<Modal Buttons="ModalButtons.Close"
       ModalTitle="@TextResources.APP_StringKeys_ReportFormat_Save"
       @ref="ModalFormats"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            @if (ModalFormats.ModalClass.Equals("Show"))
            {
                <CascadingValue Value="Api">
                    <CascadingValue Value="IsLoading">
                        <CascadingValue Value="Notification">
                            <FormatSection TColumn="TColumn"
                                           TFilter="TFilter"
                                           CalculatingColumns="AddedCalculatingColumns"
                                           DataColumns="AddedDataColumns"
                                           Filters="AddedFilters"
                                           PivotColumn="AddedPivotColumn"
                                           OnChooseFormat="OnFormatChoose">
                            </FormatSection>
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>