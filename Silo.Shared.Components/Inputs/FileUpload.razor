@namespace Silo.Shared.Components
@using Microsoft.AspNetCore.Components.Forms

<span class="silo-upload @Class" id="@Id"
      style="@Style">
    @if (ShowDropZone)
    {
        @if (UploadUrl.HasValue())
        {
            <div class="silo-dropzone" @onclick="OnClickButton">
                <div class="silo-dropzone-content">
                    @if (MaterialIconClass.HasValue())
                    {
                        <MaterialIcon IconName="@MaterialIconClass"></MaterialIcon>
                    }
                    else if (ButtonImageUrl.HasValue())
                    {
                        <img height="40" width="40"
                             src="@ButtonImageUrl"
                             class="silo-up-btn-img" />
                    }

                    <div class="silo-dropzone-text">@DropZoneText</div>

                    @if (ButtonText.HasValue())
                    {
                        <button class="up-btn @ButtonClass"
                                title="@ButtonTitle"
                                type="button">
                            @ButtonText
                        </button>
                    }
                </div>

                <input id="up-@Id"
                       type="file"
                       accept="@AllowedExtensions"
                       style="width:0px;height:0px;position:absolute;opacity:0;"
                       class="silo-up-input" />
            </div>
        }
        else
        {
            <label class="silo-dropzone" for="@($"up-{Id}")">
                <div class="silo-dropzone-content">
                    @if (MaterialIconClass.HasValue())
                    {
                        <MaterialIcon IconName="@MaterialIconClass"></MaterialIcon>
                    }
                    else if (ButtonImageUrl.HasValue())
                    {
                        <img height="40" width="40"
                             src="@ButtonImageUrl"
                             class="silo-up-btn-img" />
                    }

                    <div class="silo-dropzone-text">@DropZoneText</div>

                    @if (ButtonText.HasValue())
                    {
                        <button class="up-btn @ButtonClass"
                                title="@ButtonTitle"
                                type="button">
                            @ButtonText
                        </button>
                    }
                </div>
            </label>

            <InputFile OnChange="OnUploadFileExcel"
                       id="@($"up-{Id}")"
                       accept="@AllowedExtensions"
                       style="width:0px;height:0px;position:absolute;opacity:0;"></InputFile>
        }
    }
    else
    {
        @if (UploadUrl.HasValue())
        {
            <input id="up-@Id"
                   type="file"
                   accept="@AllowedExtensions"
                   style="width:0px;"
                   class="silo-up-input" />
        }
        else
        {
            <InputFile OnChange="OnUploadFileExcel"
                       id="@($"up-{Id}")"
                       accept="@AllowedExtensions"
                       style="width:0px;"></InputFile>
        }

        <button id="silo-up-btn-@Id"
                title="@ButtonTitle"
                class="up-btn @ButtonClass"
                @onclick="OnClickButton"
                type="button">
            @ButtonText

            @if (ButtonImageUrl.HasValue())
            {
                <img id="silo-up-btn-img-@Id"
                     height="20" width="20"
                     src="@ButtonImageUrl"
                     class="silo-up-btn-img" />
            }

            @if (MaterialIconClass.HasValue())
            {
                <MaterialIcon IconName="@MaterialIconClass"></MaterialIcon>
            }
        </button>
    }
</span>
