@namespace Silo.Shared.Components

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3">
        <span class="fw-semibold d-inline-flex align-items-center gap-1">
            <MaterialIcon IconName="@MaterialIconsHelper.Usb" />
            @TitleText
        </span>
        <span class="badge rounded-pill @(IsConnected ? "bg-success" : "bg-secondary")">@(IsConnected ? ConnectedText : DisconnectedText)</span>
        @if (!IsConnected)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <TelerikTextBox @bind-Value="TokenInput" Password="true" Placeholder="@TokenPlaceholderText"
                                Enabled="@(!IsConnectRequested)" Width="260px" Title="@TokenText" />
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!IsConnectRequested)"
                               OnClick="OnConnectClick">@(IsConnectRequested ? ConnectingText : ConnectText)</TelerikButton>
            </div>
        }
        @if (IsConnectRequested || IsConnected)
        {
            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" OnClick="OnDisconnectClick">@DisconnectText</TelerikButton>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <span class="text-danger small">@Error</span>
        }
    </div>
    @if (!IsConnected && string.IsNullOrEmpty(Error))
    {
        <div class="card-footer bg-transparent text-secondary small">@HintText</div>
    }
</div>
