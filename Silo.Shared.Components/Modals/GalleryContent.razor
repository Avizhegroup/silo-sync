@using System.Text.Json
@using Silo.Application.Dto
@using Silo.Application.Features

@namespace Silo.Shared.Components

@if (GalleryMedias is not null && GalleryMedias.Any())
{
    <div class="gallery-grid">

        @foreach (var media in GalleryMedias)
        {
            var iconName = media.Extension switch
            {
                GalleryExtension.Pdf => "picture_as_pdf",
                GalleryExtension.Word => "description",
                GalleryExtension.Zip => "folder_zip",
                GalleryExtension.Image => "image",
                _ => "insert_drive_file"
            };

            var iconColorClass = media.Extension switch
            {
                GalleryExtension.Pdf => "icon-pdf",
                GalleryExtension.Word => "icon-word",
                GalleryExtension.Zip => "icon-zip",
                GalleryExtension.Image => "icon-image",
                _ => "icon-default"
            };

            var actionTypeTitle = string.Empty;

            if (media.Data.HasValue())
            {
                using var jsonData = JsonDocument.Parse(media.Data);

                if (jsonData.RootElement.TryGetProperty(
                        "ActionTypeTitle",
                        out var property))
                {
                    actionTypeTitle = property.GetString() ?? string.Empty;
                }
            }

            <div class="gallery-item @(SelectedGalleryMedia?.Id == media.Id
                                ? "gallery-item-selected"
                                : "")"
                 @ondblclick="async () => await OnMediaDoubleClick(media)"
                 @onclick="() => SelectedGalleryMedia = media"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu="async e => await OnGalleryMediaRightClick(e, media)">

                <div class="gallery-item-card">

                    <div class="gallery-item-icon @iconColorClass"
                         style="overflow:hidden;
                        border-radius:8px;
                        width:133px;
                        height:95px;">

                        @if (media.Extension == GalleryExtension.Image &&
                             !string.IsNullOrEmpty(media.Base64Image))
                        {
                            <img src="@media.Base64Image"
                                 style="width:100%;
                            height:100%;
                            object-fit:cover;" />
                        }
                        else
                        {
                            <MaterialIcon IconName="@iconName" />
                        }

                    </div>

                    <div class="gallery-item-info">

                        <div class="gallery-item-name"
                             title="@media.MediaName">
                            @media.MediaName
                        </div>

                        <div class="gallery-item-name"
                             title="@actionTypeTitle">
                            @actionTypeTitle
                        </div>

                        <div class="gallery-item-date">
                            @(PersianCalendarTools.GregorianToPersian(
                                media.UpldoadDateTime))
                        </div>

                    </div>

                </div>
            </div>
        }
    </div>

    @if (GalleryMedias.Count > 20)
    {
        <div class="gallery-pagination-info">
            @GalleryMedias.Count فایل
        </div>
    }
}
else if (!IsLoading)
{
    <div class="gallery-empty">
        <MaterialIcon IconName="photo_library" />
        <p>@TextResources.APP_StringKeys_Validation_AnyData</p>
    </div>
}

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>

<TelerikContextMenu Class="gallery-context"
                    @ref="ContextMenu"
                    Data="@ContextMenuItems"
                    OnClick="@((TelerikContextMenuItem item) => OnContextMenuItemClick(item))">
</TelerikContextMenu>

<TelerikTooltip TargetSelector=".gallery-item-card"
                Position="@TooltipPosition.Top"
                ShowOn="@TooltipShowEvent.Hover">
</TelerikTooltip>