@page "/"
@page "/customer/check"
@attribute [AllowAnonymous]
@using Silo.Application.Features;
@using Silo.Identity.Client;
<div class="row">
    @if (ActiveSection == CustomerCheckGuaranteePageMode.Search)
    {
        <EditForm Model="Command"
                  OnInvalidSubmit="OnInvalidSubmit"
                  OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class="col-md-6 k-validation-summary k-messagebox k-messagebox-error p-0" role="alert">
                <ValidationSummary />
            </div>
            <div class="row g-3">
                <hr class="my-4">
                <h5 class="mb-3">
                    انتخاب مدل
                </h5>
                <div class="col-md-4">
                    <label for="group" class="form-label">گروه محصول</label>
                    <TelerikDropDownList Data="Groups"
                                     TextField="@nameof(GetAllProductGroupVm.Title)"
                                     ValueField="@nameof(GetAllProductGroupVm.Code)"
                                     @bind-Value="SearchProductModel.Group"
                                     DefaultText="انتخاب نشده"
                                     Filterable="true"
                                     FilterOperator="StringFilterOperator.Contains"
                                     Class="drop-all form-control"
                                     Id="group"
                                     OnChange="OnGroupChange">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div class="col-md-4">
                    <label for="subgroup" class="form-label">زیر گروه محصول</label>
                    <TelerikDropDownList Data="FilteredSubGroups"
                                     TextField="@nameof(GetAllProductSubGroupVm.Title)"
                                     ValueField="@nameof(GetAllProductSubGroupVm.Code)"
                                     @bind-Value="SearchProductModel.SubGroup"
                                     DefaultText="انتخاب نشده"
                                     Filterable="true"
                                     FilterOperator="StringFilterOperator.Contains"
                                     Id="subgroup"
                                     Class="drop-all form-control"
                                     OnChange="OnSubGroupChange">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <h5 class="mb-3">
                    مشخصات محصول
                </h5>
                <div class="col-md-4">
                    <label for="model" class="form-label">مدل محصول</label>
                    <TelerikDropDownList Data="FilteredProductModels"
                                     TextField="@nameof(GetProductModelsVm.TechnicalCode)"
                                     ValueField="@nameof(GetProductModelsVm.TechnicalCode)"
                                     @bind-Value="Command.RegCode"
                                     DefaultText="انتخاب نشده"
                                     Filterable="true"
                                     FilterOperator="StringFilterOperator.Contains"
                                     Id="city"
                                     Class="drop-all form-control">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div class="col-md-4">
                    <label for="serial" class="form-label">سریال محصول</label>
                    <TelerikTextBox @bind-Value="Command.DeviceIp"
                                Class="form-control"
                                Placeholder="سریال محصول"
                                Id="serial">
                    </TelerikTextBox>
                </div>
                <hr class="my-4">
                <h5 class="mb-3">
                    مشتری
                </h5>
                <div class="col-md-4">
                    <label for="firstName" class="form-label">نام و نام خانوادگی</label>
                    <TelerikTextBox @bind-Value="Command.CustomerFullName"
                                Class="form-control"
                                Placeholder="نام و نام خانوادگی"
                                Id="firstName">
                    </TelerikTextBox>
                </div>
                <div class="col-md-4">
                    <label for="phoneNumber" class="form-label">شماره تلفن</label>
                    <TelerikMaskedTextBox @bind-Value="Command.PhoneNumber"
                                      Mask="09000000000"
                                      IncludeLiterals="true"
                                      Class="form-control"
                                      Placeholder="شماره تلفن"
                                      Id="phoneNumber">
                    </TelerikMaskedTextBox>
                </div>
                <div class="col-md-4">
                    <label for="nationalCode" class="form-label">کد ملی</label>
                    <TelerikMaskedTextBox @bind-Value="Command.NationalCode"
                                      Mask="0000000000"
                                      IncludeLiterals="true"
                                      Class="form-control"
                                      Placeholder="کد ملی"
                                      Id="nationalCode">
                    </TelerikMaskedTextBox>
                </div>
                <div class="col-md-4">
                    <label for="province" class="form-label">استان</label>
                    <TelerikDropDownList Data="Provinces"
                                     TextField="@nameof(GetAllProvinceVm.Title)"
                                     ValueField="@nameof(GetAllProvinceVm.Id)"
                                     @bind-Value="Command.Province"
                                     DefaultText="انتخاب نشده"
                                     Filterable="true"
                                     FilterOperator="StringFilterOperator.Contains"
                                     Class="drop-all form-control"
                                     Id="province"
                                     OnChange="OnProvinceChange">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div class="col-md-4">
                    <label for="city" class="form-label">شهر</label>
                    <TelerikDropDownList Data="FilteredCities"
                                     TextField="@nameof(GetCitiesVm.Title)"
                                     ValueField="@nameof(GetCitiesVm.Id)"
                                     @bind-Value="Command.City"
                                     DefaultText="انتخاب نشده"
                                     Filterable="true"
                                     FilterOperator="StringFilterOperator.Contains"
                                     Id="city"
                                     Class="drop-all form-control">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <button type="button" class="btn btn-warning" @onclick="OnClearClick">پاک کردن</button>
                </div>
            </div>
        </EditForm>
    }
    else if (ActiveSection == CustomerCheckGuaranteePageMode.Exist)
    {
        <div class="bg-success pt-3 px-3 pt-md-5 px-md-5 text-center text-white overflow-hidden" style="min-height:100vh;">
            <div class="my-3 p-3">
                <h2 class="display-5">اصالت محصول</h2>
                <h4>
                    @string.Concat("عنوان محصول", " : ", CustomerGuarantee.ProductTitle)
                </h4>
                <p class="lead">@string.Format("محصول شما اصل بوده و تحت پوشش گارانتی شرکت {0} می‌باشد.", Company ?? "")</p>
            </div>
            <div class="bg-success shadow-sm mx-auto border border-3 border-dark" style="width: 80%; height: 300px; border-radius: 21px 21px 0 0;">
                <div class="my-3 py-3">
                    <h2 class="display-5">گارانتی</h2>
                    <p class="lead">
                        @if (CustomerGuarantee.GuaranteeStatus == 1)
                        {
                            @string.Format("وضعیت گارانتی: {0} - {1} روز باقی‌مانده تا تاریخ {2}"
                                ,CustomerGuarantee.GuaranteeStatusTitle, CustomerGuarantee.GuaranteeRemainingDays ?? 0
                                ,CustomerGuarantee.GuaranteeEndDate)
                        }
                        else
                        {
                            @string.Format("وضعیت گارانتی: {0}"
                                ,CustomerGuarantee.GuaranteeStatusTitle)
                        }
                    </p>
                    <button type="button" class="btn btn-warning" @onclick="OnReturnToSearchClick">بازگشت</button>
                </div>
            </div>
        </div>
    }
    else if (ActiveSection == CustomerCheckGuaranteePageMode.ActivedNow)
    {
        <div class="bg-success pt-3 px-3 pt-md-5 px-md-5 text-center text-white overflow-hidden" style="min-height:100vh;">
            <div class="my-3 p-3">
                <h2 class="display-5">اصالت محصول</h2>
                <h4>
                    @string.Concat("عنوان محصول", " : ", CustomerGuarantee.ProductTitle)
                </h4>
                <p class="lead">@string.Format("محصول شما اصل بوده و تحت پوشش گارانتی شرکت {0} می‌باشد.", Company ?? "")</p>
            </div>
            <div class="bg-success shadow-sm mx-auto border border-3 border-dark" style="width: 80%; height: 300px; border-radius: 21px 21px 0 0;">
                <div class="my-3 py-3 text-white">
                    <h2 class="display-5">گارانتی</h2>
                    <p class="lead">
                        @string.Format("گارانتی شما هم‌اکنون فعال شد - {0} روز باقی‌مانده تا تاریخ {1}"
                            ,CustomerGuarantee.GuaranteeRemainingDays ?? 0
                            ,CustomerGuarantee.GuaranteeEndDate)
                    </p>
                    <button type="button" class="btn btn-warning" @onclick="OnReturnToSearchClick">بازگشت</button>
                </div>
            </div>
        </div>
    }
    else if (ActiveSection == CustomerCheckGuaranteePageMode.NotExist)
    {
        <div class="bg-danger pt-3 px-3 pt-md-5 px-md-5 text-center text-white overflow-hidden" style="min-height:100vh;">
            <div class="my-3 py-3">
                <p class="lead">محصول یافت نشد یا تحت پوشش گارانتی نمی‌باشد</p>
                <button type="button" class="btn btn-warning" @onclick="OnReturnToSearchClick">بازگشت</button>
            </div>
        </div>
    }
    else if (ActiveSection == CustomerCheckGuaranteePageMode.CheckedBefore)
    {
        <div class="row bg-danger pt-3 px-3 pt-md-5 px-md-5 text-center text-white overflow-hidden" style="min-height:100vh;">
            <div class="my-3 py-3">
                <p class="lead">این محصول قبلاً بررسی شده است</p>
                <button type="button" class="btn btn-warning" @onclick="OnReturnToSearchClick">بازگشت</button>
            </div>
        </div>
    }
</div>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="درحال بارگزاری">
</TelerikLoaderContainer>