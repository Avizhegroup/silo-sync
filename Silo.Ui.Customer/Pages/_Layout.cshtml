@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="~/styles/site.min.css" rel="stylesheet" />
    <link href="Silo.Ui.Customer.styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/styles/libraries/bootstrap.rtl.css.map" />
    <script src="/js/telerik/jquery.min.js"></script>
    <script src="_content/Telerik.UI.for.Blazor/js/telerik-blazor.js"></script>
    <link rel="stylesheet" href="_content/Telerik.UI.for.Blazor/css/kendo-theme-bootstrap/all.css" />
    <link rel="stylesheet" href="_content/Telerik.UI.for.Blazor/css/kendo-theme-default/all.css" />
    <component type="typeof(HeadOutlet)" render-mode="Server" />

</head>
<body>

    @RenderBody()

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.server.js"></script>

    <script src="_content/Silo.Shared.Components/js/Silo.Shared.Components.min.js"></script>
    <link rel="stylesheet" href="_content/Silo.Shared.Components/css/Silo.Shared.Components.min.css" />

    @RenderSection("Scripts", required: false)
