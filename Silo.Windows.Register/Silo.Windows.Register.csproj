<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The native vendor DLLs (VHLib, UhfReader_API_HID, SLABHID*) are x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RfidApiLib">
      <HintPath>Packages\RfidApiLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LabelPrinter">
      <HintPath>Packages\LabelPrinter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FastReport">
      <HintPath>Packages\FastReport.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silo.Shared\Silo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default label templates (zpl\*.txt, zmin\*.lsf, frx\*.frx); copied next to the executable. -->
    <None Include="Formats\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent;Publish">
        <Exec Command="xcopy /y &quot;$(ProjectDir)Packages\*.*&quot; &quot;$(ProjectDir)$(OutDir)&quot;" />
        <Exec Command="xcopy /y &quot;$(ProjectDir)Formats\*.*&quot; &quot;$(ProjectDir)$(OutDir)\Formats&quot;" />
    </Target>

</Project>