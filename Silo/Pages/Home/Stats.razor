                                    <GridColumn Field="@nameof(GetStatsOnQcVm.CountSerial)" Title="@TextResources.APP_StringKeys_Count" />
                                    <GridColumn Field="@nameof(GetStatsOnQcVm.Percent)" Title="@TextResources.APP_StringKeys_Percent" />
                                </GridColumns>
                            </TelerikGrid>
                        </TabStripTab>
                    </TelerikTabStrip>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent fw-semibold">@TextResources.APP_StringKeys_Report_Diff_Pl</div>
                <div class="card-body p-1">
                    <TelerikTabStrip>
                        <TabStripTab Title="نمودار دایره‌ای">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartLegend Position="ChartLegendPosition.Bottom" />
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Pie"
                                                 Data="@OnLines"
                                                 Field="@nameof(GetTagStatsOnLineVm.Percent)"
                                                 CategoryField="@nameof(GetTagStatsOnLineVm.LineTitle)">
                                        <ChartSeriesTooltip Visible="true" Context="item">
                                            <Template>@item.Category</Template>
                                        </ChartSeriesTooltip>
                                        <ChartSeriesLabels Visible="true"
                                                           Template="@seriesLabelTamplate"
