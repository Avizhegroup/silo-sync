    @* ── Detail Grid ── *@
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent fw-semibold">گزارش ریز تولید</div>
                <div class="card-body p-1">
                    <TelerikGrid Data="OnDetails" PageSize="10" Pageable="true" Sortable="true" Navigable="true">
                        <GridToolBarTemplate>
                            <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                @TextResources.APP_StringKeys_ExportExcel
                            </GridCommandButton>
                        </GridToolBarTemplate>
                        <GridExport>
                            <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report" />
                        </GridExport>
                        <GridColumns>
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.ProductCode)" Title="@TextResources.APP_StringKeys_Chart_ProductCode" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.Date)" Title="@TextResources.APP_StringKeys_Date" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.LineTitle)" Title="@TextResources.APP_StringKeys_Line" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.Username)" Title="@TextResources.APP_StringKeys_Username" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.RegCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.Shift)" Title="@TextResources.APP_StringKeys_Chart_Shift" />
                            <GridColumn Field="@nameof(GetTagStatsOnDetailsVm.Value)" Title="@TextResources.APP_StringKeys_Value" />
                        </GridColumns>
                    </TelerikGrid>
                </div>
            </div>
        </div>
    </div>

</div>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>

<style>
    .kpi-card {
        border-radius: 12px;
        transition: box-shadow .2s;
    }

        .kpi-card:hover {
            box-shadow: 0 4px 18px rgba(0,0,0,.12) !important;
        }

    .kpi-icon {
        width: 52px;
        height: 52px;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .kpi-label {
        font-size: .8rem;
        color: #6c757d;
    }

    .kpi-value {
        line-height: 1.2;
    }
</style>