                                                           Distance="1" />
                                    </ChartSeries>
                                </ChartSeriesItems>
                            </TelerikChart>
                        </TabStripTab>
                        <TabStripTab Title="نمودار میله‌ای">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Bar"
                                                 Data="@OnLines"
                                                 Field="@nameof(GetTagStatsOnLineVm.Percent)"
                                                 CategoryField="@nameof(GetTagStatsOnLineVm.LineTitle)"
                                                 Style="ChartSeriesStyle.Smooth">
                                        <ChartSeriesMarkers Visible="false" />
                                        <ChartSeriesTooltip Visible="true" />
                                    </ChartSeries>
                                </ChartSeriesItems>
                                <ChartCategoryAxes>
                                    <ChartCategoryAxis>
                                        <ChartCategoryAxisLabels>
                                            <ChartCategoryAxisLabelsRotation Angle="-45" />
                                        </ChartCategoryAxisLabels>
                                    </ChartCategoryAxis>
                                </ChartCategoryAxes>
                            </TelerikChart>
                        </TabStripTab>
                        <TabStripTab Title="جزئیات">
                            <TelerikGrid Data="OnLines" PageSize="5" Pageable="true" Sortable="true">
                                <GridToolBarTemplate>
                                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                        @TextResources.APP_StringKeys_ExportExcel
                                    </GridCommandButton>
                                </GridToolBarTemplate>
                                <GridExport>
                                    <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report" />
                                </GridExport>
                                <GridColumns>
                                    <GridColumn Field="@nameof(GetTagStatsOnLineVm.LineTitle)" Title="@TextResources.APP_StringKeys_Line" />
                                    <GridColumn Field="@nameof(GetTagStatsOnLineVm.CountSerial)" Title="@TextResources.APP_StringKeys_Count" />
                                    <GridColumn Field="@nameof(GetTagStatsOnLineVm.SumValue)" Title="@TextResources.APP_StringKeys_SumValue" />
                                    <GridColumn Field="@nameof(GetTagStatsOnLineVm.Percent)" Title="@TextResources.APP_StringKeys_Percent" />
                                </GridColumns>
                            </TelerikGrid>
                        </TabStripTab>
                    </TelerikTabStrip>
                </div>
            </div>
        </div>
    </div>

    @* ── Charts Row 3: Shift + Date ── *@
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent fw-semibold">@TextResources.APP_StringKeys_Report_Diff_Shift</div>
                <div class="card-body p-1">
                    <TelerikTabStrip>
                        <TabStripTab Title="نمودار دایره‌ای">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartLegend Position="ChartLegendPosition.Bottom" />
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Pie"
                                                 Data="@OnShifts"
                                                 Field="@nameof(GetTagsStatsOnShiftVm.Percent)"
                                                 CategoryField="@nameof(GetTagsStatsOnShiftVm.Shift)">
                                        <ChartSeriesTooltip Visible="true" Context="item">
                                            <Template>@item.Category</Template>
                                        </ChartSeriesTooltip>
                                        <ChartSeriesLabels Visible="true"
                                                           Template="@seriesLabelTamplate"
                                                           Position="seriesLabelPosition"
                                                           Distance="1" />
                                    </ChartSeries>
                                </ChartSeriesItems>
                            </TelerikChart>
                        </TabStripTab>
                        <TabStripTab Title="نمودار میله‌ای">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Bar"
                                                 Data="@OnShifts"
                                                 Field="@nameof(GetTagsStatsOnShiftVm.Percent)"
                                                 CategoryField="@nameof(GetTagsStatsOnShiftVm.Shift)"
                                                 Style="ChartSeriesStyle.Smooth">
                                        <ChartSeriesMarkers Visible="false" />
                                        <ChartSeriesTooltip Visible="true" />
                                    </ChartSeries>
                                </ChartSeriesItems>
                                <ChartCategoryAxes>
                                    <ChartCategoryAxis>
                                        <ChartCategoryAxisLabels>
                                            <ChartCategoryAxisLabelsRotation Angle="-45" />
                                        </ChartCategoryAxisLabels>
                                    </ChartCategoryAxis>
                                </ChartCategoryAxes>
                            </TelerikChart>
                        </TabStripTab>
                        <TabStripTab Title="جزئیات">
                            <TelerikGrid Data="OnShifts" PageSize="5" Pageable="true" Sortable="true">
                                <GridToolBarTemplate>
                                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                        @TextResources.APP_StringKeys_ExportExcel
                                    </GridCommandButton>
                                </GridToolBarTemplate>
                                <GridExport>
                                    <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report" />
                                </GridExport>
                                <GridColumns>
                                    <GridColumn Field="@nameof(GetTagsStatsOnShiftVm.Shift)" Title="@TextResources.APP_StringKeys_Chart_Shift" />
                                    <GridColumn Field="@nameof(GetTagsStatsOnShiftVm.CountSerial)" Title="@TextResources.APP_StringKeys_Count" />
                                    <GridColumn Field="@nameof(GetTagsStatsOnShiftVm.SumValue)" Title="@TextResources.APP_StringKeys_SumValue" />
                                    <GridColumn Field="@nameof(GetTagsStatsOnShiftVm.Percent)" Title="@TextResources.APP_StringKeys_Percent" />
                                </GridColumns>
                            </TelerikGrid>
                        </TabStripTab>
                    </TelerikTabStrip>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent fw-semibold">@TextResources.APP_StringKeys_Report_Diff_ProductDate</div>
                <div class="card-body p-1">
                    <TelerikTabStrip>
                        <TabStripTab Title="نمودار خطی">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Area"
                                                 Data="@OnDates"
                                                 Field="@nameof(GetTagStatsOnProductDateVm.CountSerial)"
                                                 CategoryField="@nameof(GetTagStatsOnProductDateVm.Date)"
                                                 Style="ChartSeriesStyle.Smooth"
                                                 Color="#3f7fba">
                                        <ChartSeriesMarkers Visible="false" />
                                        <ChartSeriesTooltip Visible="true" />
                                    </ChartSeries>
                                </ChartSeriesItems>
                                <ChartCategoryAxes>
                                    <ChartCategoryAxis>
                                        <ChartCategoryAxisLabels>
                                            <ChartCategoryAxisLabelsRotation Angle="-45" />
                                        </ChartCategoryAxisLabels>
                                    </ChartCategoryAxis>
                                </ChartCategoryAxes>
                            </TelerikChart>
                        </TabStripTab>
                        <TabStripTab Title="نمودار میله‌ای">
                            <TelerikChart Width="100%" Height="300px">
                                <ChartSeriesItems>
                                    <ChartSeries Type="ChartSeriesType.Bar"
                                                 Data="@OnDates"
                                                 Field="@nameof(GetTagStatsOnProductDateVm.Percent)"
                                                 CategoryField="@nameof(GetTagStatsOnProductDateVm.Date)"
                                                 Style="ChartSeriesStyle.Smooth">
                                        <ChartSeriesMarkers Visible="false" />
                                        <ChartSeriesTooltip Visible="true" />
                                    </ChartSeries>
                                </ChartSeriesItems>
