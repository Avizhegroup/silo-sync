                                <GridToolBarTemplate>
                                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                        @TextResources.APP_StringKeys_ExportExcel
                                    </GridCommandButton>
                                </GridToolBarTemplate>
                                <GridExport>
                                    <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report" />
                                </GridExport>
                                <GridColumns>
                                    <GridColumn Field="@nameof(GetTagStatsOnProductDateVm.Date)" Title="@TextResources.APP_StringKeys_Date" />
                                    <GridColumn Field="@nameof(GetTagStatsOnProductDateVm.CountSerial)" Title="@TextResources.APP_StringKeys_Count" />
                                    <GridColumn Field="@nameof(GetTagStatsOnProductDateVm.SumValue)" Title="@TextResources.APP_StringKeys_SumValue" />
