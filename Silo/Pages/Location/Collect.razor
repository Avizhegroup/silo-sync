@page "/location/collect"
@page "/location/collect/{RedirectedDocumentCode}/{RedirectedDocumentType}"
@namespace Silo.Pages.Location
@using Silo.Application.Features;
@using Silo.Components.PlacementOrder
@inherits SiloBasePage

<PageTitle>@PageTitle</PageTitle>

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center" style="margin-bottom:5px;">
        <div>
            <h5 class="form-title card-title" style="text-align: center !important;">
                @TextResources.APP_StringKeys_Position_Collect_List2
            </h5>
            <label id="lbl-docempty" class="text-danger" hidden>@TextResources.APP_StringKeys_Validation_Empty</label>
        </div>
    </div>
    <div class="card card-stats col-md-12 text-align-center">
        <div class="form-search-span" id="form-main" style="margin-top: 5px !important;">
            <EditForm class="form-search-span"
                      style="margin-top:10px !important; margin-bottom:10px;"
                      Model="DocumentKeyTypeRequest"
                      OnInvalidSubmit="OnInvalidSubmit"
                      OnValidSubmit="SearchOnDoc">

                <DataAnnotationsValidator />
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:0px!important;">
                    <label style="margin-right: 20px !important;">@TextResources.APP_StringKeys_DocCode :</label>
                    <TelerikTextBox @bind-Value="DocumentKeyTypeRequest.Key"
                                    class="form-control input-search-span-lg pointer">
                    </TelerikTextBox>
                    <label style="margin-right: 20px !important;">@TextResources.APP_StringKeys_Document_Type :</label>
                    <TelerikDropDownList Data="DocumentTypes"
                                         TextField="@nameof(GetAllDocumentTypesVm.Title)"
                                         ValueField="@nameof(GetAllDocumentTypesVm.Code)"
                                         @bind-Value="DocumentKeyTypeRequest.Type"
                                         DefaultText="@TextResources.APP_StringKeys_NotChoosed"
                                         Filterable="true"
                                         FilterOperator="StringFilterOperator.Contains"
                                         Width="200px">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Class="text-align-right" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                    <InputText @bind-Value="DocumentKeyTypeRequest.Key" />
                    <InputCheckbox />
                    <Input
                    <span class="bg-primary text-light"
                          id="div-desc"
                          style="margin-right: 15px;font-size: 15px;">
                        @Desc
                    </span>
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-top:-40px !important; direction:ltr!important">
                    <button type="submit" class="btn btn-primary"
                            title="@TextResources.APP_StringKeys_Send">
                        <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
<div class="row col-md-12">
    @if (Docs.Any())
    {
        <div class="card card-stats col-md-12 text-align-center" style="margin-bottom:10px;">
            <TelerikGrid Data="Docs"
                     PageSize="10"
                     Navigable="true"
                     Pageable="true"
                     Sortable="true"
                     OnRowRender="OnRowDocRenderHandler">
                <RowTemplate Context="doc">
                    <td class="td-style">@doc.ProductCode</td>
                    <td class="td-style">@doc.ProductTechnicalCode</td>
                    <td class="td-style">@doc.ProductName</td>
                    <td class="td-style">@doc.SumValue</td>
                    <td class="td-style">@doc.ProductPackValue</td>
                    <td class="td-style">@doc.CountProduct</td>
                    <td class="td-style">@doc.CountProductDesc</td>
                    <td class="td-style">
                        @{
                            CollectContradictions st = CheckDocItemContradiction(doc);

                            @(st == CollectContradictions.NotIn ? TextResources.APP_StringKeys_Position_Collect_Contradiction_NotInPlan :
                        st == CollectContradictions.NotCountEquality
                        ? string.Format(TextResources.APP_StringKeys_Position_Collect_Contradiction_Count
                        , GetDocContradictionAmount(doc)) : "")
                        }
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GateProductDto.ProductCode)"
                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                            Width="150px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.ProductTechnicalCode)"
                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                            Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.ProductName)"
                            Title="@TextResources.APP_StringKeys_ProductName"
                            Width="300px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.SumValue)"
                            Title="@TextResources.APP_StringKeys_Position_Collect_SumValueRequest"
                            Width="120px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.ProductPackValue)"
                            Title="@TextResources.APP_StringKeys_Item_Sum"
                            Width="100px">
                    </GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.CountProduct)"
                            Title="@TextResources.APP_StringKeys_Position_Collect_CountRequest"
                            Width="120px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.CountProductDesc)"
                            Title="@TextResources.APP_StringKeys_Position_Collect_SumValueRequestDesc"
                            Width="150px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.Status)"
                            Title="@TextResources.APP_StringKeys_Status"></GridColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    }
    <div class="card text-align-center col-md-12">
        <div style="margin-top:5px;">
            <h6 class="form-title card-title">
                @TextResources.APP_StringKeys_Position_Collect_PlanRequest
            </h6>
            <div class=" d-flex flex-row align-items-center flex-wrap" style="    margin-bottom: 3px !important;">
                <button id="btn-CollectList" class="btn btn-primary"
                        style="margin-top:-35px!important;" type="button" title="@TextResources.APP_StringKeys_Search"
                        @onclick="SortCollect">
                    <img width="20" height="20" src="/images/Utilities/search.png" />
                    @TextResources.APP_StringKeys_Position_Collect_GetPlan
                </button>
                <button id="btn-doc" class="btn btn-primary"
                        type="button" title="@TextResources.APP_StringKeys_Add"
                        @onclick="OnClickAddModal"
                        style="margin-right:5px;margin-top: -35px;">
                    <img width="20" height="20" src="/images/Utilities/pluswhite.png" />
                </button>
                <TelerikDropDownList Data="Trucks"
                                     TextField="Code"
                                     ValueField="Title"
                                     DefaultText="@TextResources.APP_StringKeys_Truck_Choose"
                                     OnChange="OnChangeAllTruck"
                                     Width="150px"
                                     @bind-Value="AllSelectedTruck"
                                     Class="drop-all">
                </TelerikDropDownList>
                <TelerikDropDownList Data="Docks"
                                     TextField="Title"
                                     ValueField="ZoneCode"
                                     @bind-Value="AllSelectedDock"
                                     DefaultText="@TextResources.APP_StringKeys_Truck_ChooseDock"
                                     Width="150px"
                                     Class="drop-all"
                                     OnChange="OnChangeAllDock">
                </TelerikDropDownList>
            </div>
        </div>
        @if (Plans.Any())
        {
            <TelerikGrid @ref="PlanGrid"
                     Data="Plans"
                     PageSize="10"
                     Navigable="true"
                     Pageable="true"
                     Sortable="true"
                     OnRowRender="OnRowPlanRenderHandler">
                <RowTemplate Context="plan">
                    <td class="td-style">@plan.ProductCode</td>
                    <td class="td-style">@plan.ProductTechnicalCode</td>
                    <td class="td-style">@plan.ProductName</td>
                    <td class="td-style">@plan.SumValue</td>
                    <td class="td-style">@plan.CountProductDesc</td>
                    <td class="td-style">@plan.Location</td>
                    <td class="td-style">@plan.SerialList</td>
                    <td class="td-style">
                        <TelerikDropDownList Data="Trucks"
                                         TextField="Title"
                                         ValueField="Code"
                                         @bind-Value="plan.TruckCode"
                                         DefaultText="@TextResources.APP_StringKeys_Truck_Choose"
                                         Width="150px">
                        </TelerikDropDownList>

                    </td>
                    <td class="td-style">
                        <TelerikDropDownList Data="Docks"
                                         TextField="Title"
                                         ValueField="ZoneCode"
                                         @bind-Value="plan.DockCode"
                                         DefaultText="@TextResources.APP_StringKeys_Truck_ChooseDock"
                                         Width="150px">
                        </TelerikDropDownList>
                    </td>
                    <td class="td-style">
                        @{
                            CollectContradictions st = CheckPlanItemContradiction(plan);

                            @(st == CollectContradictions.NotIn ? TextResources.APP_StringKeys_Position_Collect_Contradiction_NotInDoc : "")
                            @(plan.DockCode.HasNoValue() ? " عدم انتخاب بارانداز " : "")
                            @(plan.TruckCode.HasNoValue() ? " عدم انتخاب لیفتراک " : "")
                        }
                    </td>
                    <td class="td-style">
                        <button type="button" class="btn btn-danger tr-buttom" @onclick="(e)=>DeletePalnRow(plan.ProductCode,plan.Location)">
                            @TextResources.APP_StringKeys_Delete
                        </button>
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GateProductDto.ProductCode)"
                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                            Width="150px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.ProductTechnicalCode)"
                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                            Width="80px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.ProductName)"
                            Title="@TextResources.APP_StringKeys_ProductName"
                            Width="300px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.SumValue)"
                            Title="@TextResources.APP_StringKeys_Summery_SumCount"
                            Width="80px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.CountProduct)"
                            Title="@TextResources.APP_StringKeys_Count"
                            Width="60px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.Location)"
                            Title="@TextResources.APP_StringKeys_Zone"
                            Width="70px"></GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.SerialList)"
                            Title="@TextResources.APP_StringKeys_Serials"
                            Width="100px">
                    </GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.TruckCode)"
                            Title="@TextResources.APP_StringKeys_Truck_TruckNumber"
                            Width="160px">
                    </GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.DockCode)"
                            Title="@TextResources.APP_StringKeys_Collect_Dock"
                            Width="160px">
                    </GridColumn>
                    <GridColumn Field="@nameof(GateProductDto.Status)"
                            Title="@TextResources.APP_StringKeys_Status"
                            Width="120px"></GridColumn>
                    <GridColumn Width="60px"></GridColumn>
                </GridColumns>
            </TelerikGrid>
        }
        <br />
    </div>
    <div class="card text-align-center col-md-12" style="height:100px;">
        <h6 class="form-title card-title" style="position: absolute;left: 15px;">
            @TextResources.APP_StringKeys_Collect_Save
        </h6>
        <div class=" d-flex flex-row align-items-center flex-wrap search-button-div" style="top: 100px !important; min-width:300px!important;">
            <button id="btn-clear" class="btn btn-secondary" type="button" title="@TextResources.APP_StringKeys_DataList"
                    style="margin-left: 2px;margin-right: 2px;" @onclick="OnGetPlacementOrdersClick">
                <MaterialIcon IconName="@MaterialIconsHelper.List"></MaterialIcon>
            </button>
            <button id="btn-clear" class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                    style="margin-left: 2px;margin-right: 2px;" @onclick="OnClickClear">
                <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
            </button>
            @if (Plans.Any())
            {
                <button id="btn-print" class="btn btn-secondary" type="button" title="@TextResources.APP_StringKeys_Print"
                        style="margin-left: 2px;margin-right: 2px;" @onclick="OnPrintPlanClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Print"></MaterialIcon>
                </button>
            }
            <button type="button" id="btn-send" class="btn btn-primary" title="@TextResources.APP_StringKeys_Send"
                    @onclick="OnClickSave">
                <MaterialIcon IconName="@MaterialIconsHelper.Save"></MaterialIcon>
            </button>
        </div>
    </div>
</div>

@if (IsLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
    </TelerikLoaderContainer>
}

<Modal Buttons="ModalButtons.YesCancel"
       CancelBtnText="@TextResources.APP_StringKeys_Close"
       YesBtnText="@TextResources.APP_StringKeys_Yes"
       ModalTitle="@TextResources.APP_StringKeys_Modal_Range_Title"
       @ref="Modal"
       OnYesModal="OnYesModalDeletePlanRow">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @TextResources.APP_StringKeys_Remove_CheckBeforeDelete
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Size="ModalSize.Large"
       Buttons="ModalButtons.No"
       ModalTitle="@TextResources.APP_StringKeys_Truck_AddPlan"
       @ref="ModalAdd">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            <div class="text-danger">
                @SearchError
            </div>
            <div>
                <label>@TextResources.APP_StringKeys_ProductCode:</label>
                <TelerikDropDownList Data="Docs"
                                     TextField="ProductCode"
                                     ValueField="ProductCode"
                                     DefaultText="@TextResources.APP_StringKeys_ProductCode"
                                     Width="250px"
                                     @bind-Value="SearchProductCode">
                </TelerikDropDownList>
                <label>@TextResources.APP_StringKeys_FromZone</label>
                <TelerikDropDownList Data="Zones"
                                     TextField="ZoneCode"
                                     ValueField="ZoneCode"
                                     DefaultText="@TextResources.APP_StringKeys_FromZone"
                                     Width="150px"
                                     @bind-Value="SearchZone">
                </TelerikDropDownList>
                <label>@TextResources.APP_StringKeys_Count</label>
                <input type="text"
                       class="form-control input-search-span"
                       style="display: inline;"
                       @bind-value="SearchCount" />
                <button type="button" class="btn btn-primary"
                        @onclick="OnModalAddOk"
                        style="margin-right:10px;">
                    @TextResources.APP_StringKeys_Add
                </button>
            </div>
        </div>
    </ModalBodyContentHtml>
</Modal>

<Modal Size="ModalSize.ExtraLarge"
       Buttons="ModalButtons.No"
       ModalTitle="@TextResources.APP_StringKeys_View_Position_Collect"
       @ref="ModalHistory">
    <ModalBodyContentHtml>
        <TelerikGrid Data="PlacementOrders"
                     PageSize="5"
                     Navigable="true"
                     Pageable="true"
                     Sortable="true">
            <DetailTemplate>
                @{
                    var details = context as GetAllPlacementOrderVm;

                    <PlacementOrderDetailsGridHierarchy OperationCode="@details.OperationCode"></PlacementOrderDetailsGridHierarchy>
                }
            </DetailTemplate>
            <RowTemplate Context="order">
                <td>@order.OperationCode</td>
                <td>@order.DocumentKey</td>
                <td>@order.DocumentType</td>
                <td>
                 @(PersianCalendarTools.GregorianToPersian(order.DateTime) + " " +
                                                    order.DateTime.ToShortTimeString())
                </td>
                <td>@order.User</td>
                <td>@order.OrderCount</td>
                <td>
                    @if (order.Status.Equals(1))
                    {
                        <button type="button"
                                class="btn btn-danger btn-ignore-modal" @onclick="async ()=> await OnRevokePlacementOrderClick(order.OperationCode)">
                            @TextResources.APP_StringKeys_Ignore
                        </button>
                    }
                    @if (order.Status.Equals(2))
                    {
                        <button type="button"
                                class="btn btn-outline-success" disabled>
                            @TextResources.APP_StringKeys_Finished
                        </button>
                    }
                    @if (order.Status.Equals(3))
                    {
                        <button type="button"
                                class="btn btn-light" disabled>
                            @TextResources.APP_StringKeys_Ignored
                        </button>
                    }
                </td>
            </RowTemplate>
            <GridColumns>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.OperationCode)"
                            Title="@TextResources.APP_StringKeys_Code"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.DocumentKey)"
                            Title="@TextResources.APP_StringKeys_DocCode"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.DocumentType)"
                            Title="@TextResources.APP_StringKeys_Document_Type"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.DateTime)"
                            Title="@TextResources.APP_StringKeys_Date"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.User)"
                            Title="@TextResources.APP_StringKeys_Field_Username"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.OrderCount)"
                            Title="@TextResources.APP_StringKeys_CollectOrder_Count"></GridColumn>
                <GridColumn Field="@nameof(GetAllPlacementOrderVm.Status)"
                            Title="@TextResources.APP_StringKeys_Status"></GridColumn>
            </GridColumns>
        </TelerikGrid>
    </ModalBodyContentHtml>
</Modal>

<Modal Buttons="ModalButtons.YesCancel"
       ModalTitle="@TextResources.APP_StringKeys_Attention"
       @ref="ModalRevoke"
       Size="ModalSize.Normal"
       OnYesModal="OnApproveRevokePlacementOrderClick"
       YesBtnText="@TextResources.APP_StringKeys_Ignore"
       CancelBtnText="@TextResources.APP_StringKeys_Close">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @TextResources.APP_StringKeys_PlacementOrder_IgnoreMessage
        </div>
    </ModalBodyContentHtml>
</Modal>

<style type="text/css">
    .drop-all {
        margin-right: 10px;
        font-size: 0.85em;
        margin-top: -35px;
    }

    input[type=checkbox] {
        width: 40%;
        margin-right: 10px;
    }
</style>