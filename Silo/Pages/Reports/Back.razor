@page "/report/back"
@inherits SiloBasePage
@using Silo.Application.Features;
@using Newtonsoft.Json.Linq

<PageTitle>@PageTitle</PageTitle>

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center">
        <div>
            <h5 class="form-title card-title">
                @TextResources.APP_StringKeys_View_Report_Back
            </h5>
        </div>
        @if (IsFiltersShown)
        {
            <form role="form" class="form-search-span" id="form-main" style="margin-top:-50px !important;">
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:0px!important;margin-top:5px;">
                    <label>@TextResources.APP_StringKeys_ProductCode :</label>
                    <input @bind-value="Request.ProductCode" class="form-control input-search-span-lg pointer" />
                    <button type="button" class="btn btn-light" @onclick="async ()=> await ProductCodeModal.Show()">
                        <img width="20" height="20" src="/images/Utilities/grid.png" />
                    </button>
                    <label style="margin-right: 4px;">@TextResources.APP_StringKeys_FromDate :</label>
                    <DatePicker InputClass=" input-search-span-lg pointer "
                                @bind-Value="Request.FromDate"></DatePicker>
                    <label style="margin-right: 18px;">@TextResources.APP_StringKeys_ToDate :</label>
                    <DatePicker InputClass=" input-search-span-lg pointer "
                                @bind-Value="Request.ToDate"></DatePicker>
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap">
                    <label>@TextResources.APP_StringKeys_ProductSerial :</label>
                    <input @bind-value="Request.ProductSerial" class="form-control input-search-span-lg pointer" />
                    <label style="margin-right:54px;">@TextResources.APP_StringKeys_Chart_Regcode :</label>
                    <input @bind-value="Request.TechnicalCode" class="form-control input-search-span-lg pointer" />
                    <label style="margin-right: -50px;">@TextResources.APP_StringKeys_Like:</label>
                    <input type="checkbox" @bind-value="Request.TechnicalCodeLike" class="form-control" />
                    <label style="margin-right:22px; margin-left:5px">@TextResources.APP_StringKeys_Chart_Shift :</label>
                    <TelerikDropDownList Data="Shifts"
                                         TextField="Title"
                                         ValueField="Code"
                                         @bind-Value="Request.Shift"
                                         DefaultText="@TextResources.APP_StringKeys_NotChoosed"
                                         Width="200px"
                                         Class="drop-all">
                    </TelerikDropDownList>
                </div>
                <div class=" d-flex flex-row align-items-center flex-wrap search-button-div">
                    <button class="btn btn-warning" 
                            type="button" 
                            title="@TextResources.APP_StringKeys_Clear"
                            style="margin-left: 2px;" 
                            @onclick="OnClickClear">
                        <img width="20" height="20" src="/images/Utilities/Clear.png" asp-append-version="true">
                    </button>
                    <button type="button" 
                            id="btn-send" 
                            class="btn btn-primary" 
                            title="@TextResources.APP_StringKeys_Send" 
                            @onclick="OnClickSubmit">
                        <img width="20" height="20" src="/images/Utilities/send.png">
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@if (Products is not null)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 text-align-center">
            <br />
            <TelerikGrid Data="Products"
                     PageSize="10"
                     Navigable="true"
                     Pageable="true"
                     Sortable="true">
                <RowTemplate Context="product">
                    <td class="td-style">@product.ProductCode</td>
                    <td class="td-style">@product.ProductName</td>
                    <td class="td-style">@product.Count</td>
                    <td class="td-style">@product.SumCount</td>
                    <td class="td-style">
                        <button @onclick="async ()=> await OnClickRowDetails(product.ProductCode)"
                            class="btn-dt-1 btn-success tr-buttom btn">
                            @TextResources.APP_StringKeys_Details
                        </button>
                    </td>
                </RowTemplate>
                <GridToolBarTemplate>
                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                        @TextResources.APP_StringKeys_ExportExcel
                    </GridCommandButton>
                </GridToolBarTemplate>
                <GridExport>
                    <GridExcelExport AllPages="true" FileName="@PageTitle" />
                </GridExport>
                <GridColumns>
                    <GridColumn Field="@nameof(GetAllReturnProductVm.ProductCode)"
                            Title="@TextResources.APP_StringKeys_ProductCode"
                            Width="200px">
                        <FooterTemplate>
                            تعداد کد کالا: @context.Count
                        </FooterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductVm.ProductName)"
                            Title="@TextResources.APP_StringKeys_ProductName"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductVm.Count)"
                            Title="@TextResources.APP_StringKeys_Count"
                            Width="150px">
                        <FooterTemplate>
                            تعداد محموله ها: @context.Sum
                        </FooterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductVm.SumCount)"
                            Title="@TextResources.APP_StringKeys_Summery_SumCount"
                            Width="250px">
                        <FooterTemplate>
                            جمع مقدار محموله ها: @context.Sum
                        </FooterTemplate>
                    </GridColumn>
                    <GridColumn Width="60px"></GridColumn>
                </GridColumns>
                <GridAggregates>
                    <GridAggregate Field=@nameof(GetAllReturnProductVm.SumCount) Aggregate="@GridAggregateType.Sum" />
                    <GridAggregate Field=@nameof(GetAllReturnProductVm.Count) Aggregate="@GridAggregateType.Sum" />
                    <GridAggregate Field=@nameof(GetAllReturnProductVm.ProductCode) Aggregate="@GridAggregateType.Count" />
                </GridAggregates>
            </TelerikGrid>
        </div>
    </div>
}
@if (IsLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
    </TelerikLoaderContainer>
}

<ProductCodeModal @ref="ProductCodeModal"
                  OnClickProductCode="OnClickProductCode">

</ProductCodeModal>

<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
       @ref="ModalDetails"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            <TelerikGrid Data="Details"
                         PageSize="5"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true">
                <RowTemplate Context="product">
                    <td class="td-style td-dt">@product.ProductCode</td>
                    <td class="td-style td-dt">@product.ProductSerial</td>
                    <td class="td-style td-dt">@product.Size</td>
                    <td class="td-style td-dt">@product.RegCode</td>
                    <td class="td-style td-dt">@product.Qc</td>
                    <td class="td-style td-dt">@product.Count</td>
                    <td class="td-style td-dt">@product.Line</td>
                    <td class="td-style td-dt">@product.Shift</td>
                    <td class="td-style td-dt">@product.DateTimeEnter.ToNormalPersianDateTime()</td>
                    <td class="td-style td-dt">@product.ExitDateTime</td>
                    <td class="td-style td-dt">@JToken.Parse(product.ExitDesc)["MovementActionDesc"]</td>
                    <td class="td-style td-dt">@product.Status</td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.ProductCode)"
                                Title="@TextResources.APP_StringKeys_Chart_ProductCode" Width="120px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.ProductSerial)"
                                Title="@TextResources.APP_StringKeys_ProductSerial" Width="55px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Size)"
                                Title="@TextResources.APP_StringKeys_Product_Size" Width="70px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.RegCode)"
                                Title="@TextResources.APP_StringKeys_Chart_Regcode" Width="60px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Qc)"
                                Title="@TextResources.APP_StringKeys_QC" Width="70px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Count)"
                                Title="@TextResources.APP_StringKeys_ProductCount" Width="50px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Line)"
                                Title="@TextResources.APP_StringKeys_Line" Width="70px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Shift)"
                                Title="@TextResources.APP_StringKeys_Chart_Shift" Width="55px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.DateTimeEnter)"
                                Title="@TextResources.APP_StringKeys_EnterDate" Width="90px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.ExitDateTime)"
                                Title="@TextResources.APP_StringKeys_ExitDate" Width="90px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.ExitDesc)"
                                Title="@TextResources.APP_StringKeys_ExitDesc" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllReturnProductDetailsVm.Status)"
                                Title="@TextResources.APP_StringKeys_Field_Status" Width="80px"></GridColumn>
                </GridColumns>
                <GridToolBarTemplate>
                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                        @TextResources.APP_StringKeys_ExportExcel
                    </GridCommandButton>
                </GridToolBarTemplate>
                <GridExport>
                    <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Details" />
                </GridExport>
            </TelerikGrid>
        </div>
    </ModalBodyContentHtml>
</Modal>


