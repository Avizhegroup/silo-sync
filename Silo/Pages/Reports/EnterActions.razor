            {
                <FilterReportSelectSection Filters="Filters" OnSearchClick="OnAddNewFilterClick"
                                           OnAddClick="OnAddNewFilterInComponentClick"
                                           OnRemoveClick="OnRemoveFilterInComponentClick">
                </FilterReportSelectSection>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>
<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Info"
       @ref="InfoModal"
       Size="ModalSize.ExtraLarge"
       OkBtnClass="btn btn-success"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Save"
       OnOkModal="OnSaveInfoClick">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            @foreach (var chunck in MovementActionDataItems.Chunk(3))
            {
                <div class="d-flex flex-row align-items-center flex-wrap">
                    @foreach (var item in chunck)
                    {
                        <label>@item.Name:</label>
                        <input type="text"
                               class="form-control input-search-span-lg"
                               @bind-value="item.Value" />
                    }
                </div>
            }
        </div>
