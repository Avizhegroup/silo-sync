@page "/report/enteraction"
@page "/report/enteraction/{TabMode:int}"
@inherits SiloBasePage
@namespace Silo.Pages.Reports
@using Newtonsoft.Json.Linq;
@using Silo.Application.Features;
@using Silo.Components.Filter
@using Silo.Shared.Components.Print
@using Silo.Shared.Components.Report

<PageTitle>@PageTitle</PageTitle>

@if (IsFiltersShown)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 text-align-right" style="margin-bottom:5px; min-height: 70px;">
            <h6>@TextResources.APP_StringKeys_Filters</h6>
            <div class=" d-flex flex-row align-items-center flex-wrap  search-button-div" style="margin-top:-148px !important;width:480px;">
                <button class="btn btn-success" type="button" title="@TextResources.APP_StringKeys_Filters"
                        style="margin-left: 2px;" @onclick="OnFilterModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Filter_alt"></MaterialIcon>
                </button>
                <button class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                        style="margin-left: 2px;" @onclick="OnClearClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button class="btn btn-primary" type="button"
                        title="@TextResources.APP_StringKeys_Send"
                        @onclick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                </button>
            </div>
            @if (ApplyFilters.Any())
            {
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:10px!important;">
                    <FilterReportEditSection Filters="ApplyFilters"
                                             OnFilterValueChanged="OnChangeFilterValueInEditComponent">
                    </FilterReportEditSection>
                </div>
            }
        </div>
    </div>
}

<div class="row col-md-12" style="margin-top: -10px;">
    <div class="card card-stats col-md-12 text-align-center">
        <TelerikTabStrip>
            @if (TabMode == 1 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_Exit_Tab2">
                    @if (Aggregates is not null)
                    {
                        <TelerikGrid Data="Aggregates"
                                     PageSize="10"
                                     Navigable="true"
                                     Pageable="true"
                                     Sortable="true">
                            <RowTemplate Context="product">
                                <td class="td-style">@product.ProductCode</td>
                                <td class="td-style">@product.ProductName</td>
                                <td class="td-style">@product.TechnicalCode</td>
                                <td class="td-style">@product.OpCode</td>
                                <td class="td-style">@product.ActionTypeTitle</td>
                                <td class="td-style">@product.StoreTitle</td>
                                <td class="td-style">@product.DestinationTitle</td>
                                <td class="td-style">@product.Qc</td>
                                <td class="td-style">@product.Count</td>
                                <td class="td-style">@product.SumCount</td>
                                <td class="td-style">@product.ProductCountInPack</td>
                                @if (product.TechnicalInfoData is not null)
                                {
                                    @foreach (var field in TechnicalFilterColumns)
                                    {
                                        <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                                    }
                                }
                                <td class="td-style">
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async()=> await OnEnterActionAggOnProductCodeDetailsClick(product)">
                                        @TextResources.APP_StringKeys_Details
                                    </button>
                                </td>
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                                <TelerikButton Icon="@FontIcon.Print" OnClick="@OnClickExportAggregatesToPdfMaster" Class="orange-pdf">
                                    @TextResources.APP_StringKeys_Print
                                </TelerikButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_Exit_Tab2"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_Exit_Tab2))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.ProductCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                                            Width="120px">
                                    <FooterTemplate>
                                        تعداد کد کالا: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.ProductName)"
                                            Title="@TextResources.APP_StringKeys_ProductName"
                                            Width="200px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.TechnicalCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.Qc)"
                                            Title="@TextResources.APP_StringKeys_Chart_Qc"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Count"
                                            Width="80px">
                                    <FooterTemplate>
                                        تعداد کل: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.SumCount)"
                                            Title="@TextResources.APP_StringKeys_SumValue"
                                            Width="80px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.ProductCountInPack)"
                                            Title="@TextResources.APP_StringKeys_ProductCountInPack"
                                            Width="100px">
                                </GridColumn>
                                @foreach (var column in TechnicalFilterColumns)
                                {
                                    <GridColumn Field="@nameof(GetEnterActionAggregateOnProductCodeVm.TechnicalInfoData)" Title="@column" Width="100px"></GridColumn>
                                }
                                <GridColumn Field="" Width="60px"></GridColumn>
                            </GridColumns>
                            <GridAggregates>
                                <GridAggregate Field=@nameof(GetEnterActionAggregateOnProductCodeVm.SumCount) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetEnterActionAggregateOnProductCodeVm.Count) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetEnterActionAggregateOnProductCodeVm.ProductCode) Aggregate="@GridAggregateType.Count" />
                            </GridAggregates>
                        </TelerikGrid>
                    }
                </TabStripTab>
            }
            @if (TabMode == 2 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_EnterAction_Tab1">
                    @if (Enters is not null)
                    {
                        <TelerikGrid Data="Enters"
                                     PageSize="10"
                                     Navigable="true"
                                     Pageable="true"
                                     Sortable="true"
                                     Width="100%"
                                     ScrollMode="GridScrollMode.Scrollable">
                            <RowTemplate Context="product">
                                <td class="td-style td-style-full">@product.OpCode</td>
                                <td class="td-style td-style-full">@product.DateTime</td>
                                <td class="td-style td-style-full">@product.User</td>
                                <td class="td-style td-style-full">@product.ActionTypeTitle</td>
                                <td class="td-style td-style-full">@product.StoreTitle</td>
                                <td class="td-style td-style-full">@product.DestinationTitle</td>
                                <td class="td-style td-style-full">@product.ActionDocumentId</td>
                                <td class="td-style td-style-full">@product.MovementActionDesc</td>
                                <td class="td-style td-style-full">@product.GateOp</td>
                                <td class="td-style td-style-full">@product.StationName</td>
                                <td class="td-style td-style-full">@product.Count</td>
                                <td class="td-style td-style-full">@product.SumCount</td>
