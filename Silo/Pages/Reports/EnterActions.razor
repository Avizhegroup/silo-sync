                                {
                                    @foreach (var field in DynamicFields.Where(p => p.ActionType == CurrentActionType && p.FieldShowColumnForAction))
                                    {
                                        <td class="td-style  td-style-full">@(JToken.Parse(product.MovementActionData)[$"{field.Title}"] ?? "")</td>
                                    }
                                }
                                <td class="td-style  td-style-full">
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async()=> await OnEnterActionDetailsClick(product)">
                                        @TextResources.APP_StringKeys_Details
                                    </button>
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async()=> await OnActionInfoClick(product)">
                                        @TextResources.APP_StringKeys_Info
                                    </button>
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async ()=>await OnSelectProductForPrint(product)">
                                        @TextResources.APP_StringKeys_Print
                                    </button>
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async ()=>await OnTruckCrossClick(product.OpCode)">
                                        @TextResources.APP_StringKeys_TruckCross
                                    </button>
                                </td>
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                                <TelerikButton Icon="@FontIcon.Print" OnClick="@OnClickExportEntersToPdfMaster" Class="orange-pdf">
                                    @TextResources.APP_StringKeys_Print
                                </TelerikButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_EnterAction_Tab1"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_EnterAction_Tab1))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="80px">
                                    <FooterTemplate>
                                        تعداد کد عملیات: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.DateTime)"
                                            Title="@TextResources.APP_StringKeys_Time"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.User)"
                                            Title="@TextResources.APP_StringKeys_User"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="150px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ActionDocumentId)"
                                            Title="@TextResources.APP_StringKeys_DocKey"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.MovementActionDesc)"
                                            Title="@TextResources.APP_StringKeys_Description"
                                            Width="120px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.GateOp)"
                                            Title="@TextResources.APP_StringKeys_GateOpCode"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.StationName)"
                                            Title="@TextResources.APP_StringKeys_Station"
                                            Width="110px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Count"
                                            Width="60px">
                                    <FooterTemplate>
                                        تعداد کل: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.SumCount)"
                                            Title="@TextResources.APP_StringKeys_Summery_SumCount"
                                            Width="90px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                @foreach (var column in DynamicFields.Where(p => p.ActionType == CurrentActionType && p.FieldShowColumnForAction))
                                {
                                    <GridColumn Field="@nameof(GetAllEnterActionsVm.MovementActionData)" Title="@column.Title" Width="100px"></GridColumn>
                                }
                                <GridColumn Width="250px"></GridColumn>
                            </GridColumns>
                            <GridAggregates>
                                <GridAggregate Field=@nameof(GetAllEnterActionsVm.SumCount) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllEnterActionsVm.Count) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllEnterActionsVm.OpCode) Aggregate="@GridAggregateType.Count" />
                            </GridAggregates>
                        </TelerikGrid>
                    }
                </TabStripTab>
            }
            @if (TabMode == 3 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_Exit_Tab3">
                    @if (FullDetails is not null)
                    {
                        <TelerikGrid Data="FullDetails"
                                     PageSize="10"
                                     Navigable="true"
                                     Pageable="true"
                                     Sortable="true"
                                     Width="100%"
                                     ScrollMode="@GridScrollMode.Scrollable">
                            <RowTemplate Context="product">
                                <td class="td-style td-style-full">@product.ProductCode</td>
                                <td class="td-style td-style-full">@product.ProductSerial</td>
                                <td class="td-style td-style-full">@product.ProductName</td>
                                <td class="td-style td-style-full">@product.OpCode</td>
                                <td class="td-style td-style-full">@product.DateTime</td>
                                <td class="td-style td-style-full">@product.Size</td>
                                <td class="td-style td-style-full">@product.TechnicalCode</td>
                                <td class="td-style td-style-full">@product.ActionTypeTitle</td>
                                <td class="td-style td-style-full">@product.StoreTitle</td>
                                <td class="td-style td-style-full">@product.DestinationTitle</td>
                                <td class="td-style td-style-full">@product.ActionDocumentId</td>
                                <td class="td-style td-style-full">@product.MovementActionDesc</td>
                                <td class="td-style td-style-full">@product.Qc</td>
                                <td class="td-style td-style-full">@product.ProductGroup</td>
                                <td class="td-style td-style-full">@product.ProductBrand</td>
                                <td class="td-style td-style-full">@product.ProductType</td>
                                <td class="td-style td-style-full">@product.Line</td>
                                <td class="td-style td-style-full">@product.Shift</td>
                                <td class="td-style td-style-full">@product.StationName</td>
                                <td class="td-style td-style-full">@product.Count</td>
                                <td class="td-style td-style-full">@product.Username</td>
                                @if (product.TechnicalInfoData is not null)
                                {
                                    @foreach (var field in TechnicalFilterColumns)
                                    {
                                        <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                                    }
                                }
                                @if (product.ProductProperties.HasValue())
                                {
                                    @foreach (var field in DynamicFieldRegisterDataColumns)
                                    {
                                        <td class="td-style">@(JToken.Parse(product.ProductProperties)[$"{field}"] ?? "")</td>
                                    }
                                }
                                @if (product.ProductProperties.HasValue())
                                {
                                    @foreach (var field in DynamicFieldForActionTypeDataColumns)
                                    {
                                        <td class="td-style">@(JToken.Parse(product.MovementActionData)[$"{field}"] ?? "")</td>
                                    }
                                }
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_Exit_Tab3"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_Exit_Tab3))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductSerial)"
                                            Title="@TextResources.APP_StringKeys_ProductSerial"
                                            Width="150px">
                                    <FooterTemplate>
                                        تعداد سریال: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductName)"
                                            Title="@TextResources.APP_StringKeys_ProductName"
                                            Width="200px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.DateTime)"
                                            Title="@TextResources.APP_StringKeys_DateTime"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Size)"
                                            Title="@TextResources.APP_StringKeys_Product_Size"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.TechnicalCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ActionDocumentId)"
                                            Title="@TextResources.APP_StringKeys_DocKey"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.MovementActionDesc)"
                                            Title="@TextResources.APP_StringKeys_Description"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Qc)"
                                            Title="@TextResources.APP_StringKeys_Chart_Qc"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductGroup)"
                                            Title="@TextResources.APP_StringKeys_ProductGroup"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductBrand)"
                                            Title="@TextResources.APP_StringKeys_ProductBrand"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductType)"
                                            Title="@TextResources.APP_StringKeys_Field_ProductType"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Line)"
                                            Title="@TextResources.APP_StringKeys_Chart_Pl"
                                            Width="60px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Shift)"
                                            Title="@TextResources.APP_StringKeys_Chart_Shift"
                                            Width="60px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.StationName)"
                                            Title="@TextResources.APP_StringKeys_Station"
                                            Width="110px"></GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Value"
                                            Width="80px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.Username)"
                                            Title="@TextResources.APP_StringKeys_Username"
                                            Width="110px"></GridColumn>
                                @foreach (var column in TechnicalFilterColumns)
                                {
                                    <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.TechnicalInfoData)" Title="@column" Width="100px"></GridColumn>
                                }
                                @foreach (var column in DynamicFieldRegisterDataColumns)
                                {
                                    <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.ProductProperties)" Title="@column" Width="100px"></GridColumn>
                                }
                                @foreach (var column in DynamicFieldForActionTypeDataColumns)
                                {
                                    <GridColumn Field="@nameof(GetEnterActionDetailsFullVm.MovementActionData)" Title="@column" Width="100px"></GridColumn>
                                }
                            </GridColumns>
                            <GridAggregates>
                                <GridAggregate Field=@nameof(GetEnterActionDetailsFullVm.Count) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetEnterActionDetailsFullVm.ProductSerial) Aggregate="@GridAggregateType.Count" />
                            </GridAggregates>
                        </TelerikGrid>
                    }
                </TabStripTab>
            }
        </TelerikTabStrip>
    </div>
</div>
<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
       @ref="DetailsModal"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            <TelerikGrid Data="Details"
                         PageSize="5"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true">
                <RowTemplate Context="product">
                    <td class="td-style td-dt">@product.ProductCode</td>
                    <td class="td-style td-dt">@product.ProductSerial</td>
                    <td class="td-style td-dt">@product.ProductName</td>
                    <td class="td-style td-dt">@product.ProductCount</td>
                    <td class="td-style td-dt">@product.Size</td>
                    <td class="td-style td-dt">@product.ProductBrand</td>
                    <td class="td-style td-dt">@product.ProductGroup</td>
                    <td class="td-style td-dt">@product.ProductType</td>
                    <td class="td-style td-dt">@product.TechnicalCode</td>
                    <td class="td-style td-dt">@product.StationName</td>
                    @if (product.TechnicalInfoData is not null)
                    {
                        @foreach (var field in TechnicalFilterColumns)
                        {
                            <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                        }
                    }
                    @if (product.ProductProperties is not null)
                    {
                        @foreach (var field in DynamicFieldRegisterDataColumns)
                        {
                            <td class="td-style">@(JToken.Parse(product.ProductProperties)[$"{field}"] ?? "")</td>
                        }
                    }
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductCode)" Title="@TextResources.APP_StringKeys_Chart_ProductCode" Width="150px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductSerial)" Title="@TextResources.APP_StringKeys_ProductSerial" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductName)" Title="@TextResources.APP_StringKeys_ProductName" Width="250px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductCount)" Title="@TextResources.APP_StringKeys_ProductCount" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.Size)" Title="@TextResources.APP_StringKeys_Product_Size" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductBrand)" Title="@TextResources.APP_StringKeys_ProductBrand" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductGroup)" Title="@TextResources.APP_StringKeys_ProductGroup" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductType)" Title="@TextResources.APP_StringKeys_Field_ProductType" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.TechnicalCode)" Title="@TextResources.APP_StringKeys_Chart_Regcode" Width="100px"></GridColumn>
                    <GridColumn Field="@nameof(GetEnterActionDetailsVm.StationName)" Title="@TextResources.APP_StringKeys_Station" Width="100px"></GridColumn>
                    @foreach (var column in TechnicalFilterColumns)
                    {
                        <GridColumn Field="@nameof(GetEnterActionDetailsVm.TechnicalInfoData)" Title="@column" Width="100px"></GridColumn>
                    }
                    @foreach (var column in DynamicFieldRegisterDataColumns)
                    {
                        <GridColumn Field="@nameof(GetEnterActionDetailsVm.ProductProperties)" Title="@column" Width="100px"></GridColumn>
