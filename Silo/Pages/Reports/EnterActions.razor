                    <input type="text" class="form-control input-search-span-lg" @bind-value="@ActionTruckCross.LicenseCode" disabled="true" />
                </div>
                <div class="form-inline">
                    <label style="margin-right:11px;">@TextResources.APP_StringKeys_Phone_Number</label>
                    <input type="text" class="form-control input-search-span-lg" @bind-value="@ActionTruckCross.DriverPhone" disabled="true" />
                    <label style="margin-right:73px;">@TextResources.APP_StringKeys_Plaque</label>
                    <input type="text" class="form-control input-search-span-lg" @bind-value="@ActionTruckCross.Plaque" disabled="true" />
