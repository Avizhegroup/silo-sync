        </TelerikTabStrip>
    </div>
</div>
<Modal Buttons="ModalButtons.OKClose"
       ModalTitle="@TextResources.APP_StringKeys_Details"
       @ref="DetailsModal"
       Size="ModalSize.ExtraLarge"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-center">
            <TelerikGrid Data="Details"
                         PageSize="5"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true"
                         Width="100%"
                         ScrollMode="GridScrollMode.Scrollable">
                <RowTemplate Context="product">
                    <td class="td-style td-dt">@product.ProductCode</td>
                    <td class="td-style td-dt">@product.ProductSerial</td>
                    <td class="td-style td-dt">@product.ProductName</td>
                    <td class="td-style td-dt">@product.ProductCount</td>
                    <td class="td-style td-dt">@product.Size</td>
                    <td class="td-style td-dt">@product.ProductBrand</td>
                    <td class="td-style td-dt">@product.ProductGroup</td>
                    <td class="td-style td-dt">@product.ProductType</td>
                    <td class="td-style td-dt">@product.Line</td>
                    <td class="td-style td-dt">@product.Shift</td>
                    <td class="td-style td-dt">@product.TechnicalCode</td>
                    <td class="td-style td-dt">@product.StationName</td>
                    <td class="td-style td-dt">@product.GuaranteeStatus</td>
                    <td class="td-style td-dt">@product.GuaranteeStartDate</td>
                    <td class="td-style td-dt">@product.GuaranteeEndDate</td>
                    @if (product.TechnicalInfoData.HasValue())
                    {
                        @foreach (var field in TechnicalFilterColumns)
                        {
                            <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                        }
                    }
                    @if (product.ProductProperties.HasValue())
                    {
                        @foreach (var field in DynamicFieldRegisterDataColumns)
                        {
                            <td class="td-style">@(JToken.Parse(product.ProductProperties)[$"{field}"] ?? "")</td>
                        }
                    }
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(GetAllExitActionDetailsByExitCodeVm.ProductCode)"
                                Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                                Width="200px"></GridColumn>
                    <GridColumn Field="@nameof(GetAllExitActionDetailsByExitCodeVm.ProductSerial)"
                                Title="@TextResources.APP_StringKeys_ProductSerial"
                                Width="200px"></GridColumn>
