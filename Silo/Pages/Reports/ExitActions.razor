@page "/report/exitaction"
@page "/report/exitaction/{TabMode:int}"
@inherits SiloBasePage
@namespace Silo.Pages.Reports
@using Newtonsoft.Json.Linq;
@using Silo.Application.Features;
@using Silo.Components.Filter
@using Silo.Shared.Components.Print
@using Silo.Shared.Components.Report

<PageTitle>@PageTitle</PageTitle>

@if (IsFiltersShown)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 text-align-right" style="min-height: 70px;">
            <h6>@TextResources.APP_StringKeys_Filters</h6>
            <div class=" d-flex flex-row align-items-center flex-wrap  search-button-div" style="margin-top:-148px !important;width:480px;">
                <button class="btn btn-success" type="button" title="@TextResources.APP_StringKeys_Filters"
                        style="margin-left: 2px;" @onclick="OnFilterModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Filter_alt"></MaterialIcon>
                </button>
                <button class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                        style="margin-left: 2px;" @onclick="OnClearClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button class="btn btn-primary" type="button"
                        title="@TextResources.APP_StringKeys_Send"
                        @onclick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                </button>
            </div>
            @if (ApplyFilters.Any())
            {
                <div class=" d-flex flex-row align-items-center flex-wrap" style="margin-bottom:10px!important;">
                    <FilterReportEditSection Filters="ApplyFilters"
                                             OnFilterValueChanged="OnChangeFilterValueInEditComponent">
                    </FilterReportEditSection>
                </div>
            }
        </div>
    </div>
}

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center">
        <TelerikTabStrip>
            @if (TabMode == 1 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_ExitAction_Tab2">
                    @if (Aggregates is not null)
                    {
                        <TelerikGrid Data="Aggregates"
                                     PageSize="10"
                                     Navigable="true"
                                     Pageable="true"
                                     Sortable="true">
                            <RowTemplate Context="product">
                                <td class="td-style">@product.ProductCode</td>
                                <td class="td-style">@product.ProductName</td>
                                <td class="td-style">@product.TechnicalCode</td>
                                <td class="td-style">@product.OpCode</td>
                                <td class="td-style">@product.ActionTypeTitle</td>
                                <td class="td-style">@product.DestinationTitle</td>
                                <td class="td-style">@product.StoreTitle</td>
                                <td class="td-style">@product.Qc</td>
                                <td class="td-style">@product.Count</td>
                                <td class="td-style">@product.SumCount</td>
                                <td class="td-style">@product.ProductCountInPack</td>
                                @if (product.TechnicalInfoData is not null)
                                {
                                    @foreach (var field in TechnicalFilterColumns)
                                    {
                                        <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                                    }
                                }
                                <td class="td-style">
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async()=> await OnExitActionAggOnProductCodeDetailsClick(product)">
                                        <MaterialIcon IconName="@MaterialIconsHelper.Summarize"></MaterialIcon>
                                    </button>
                                </td>
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                                <TelerikButton OnClick="@OnClickExportAggregatesToPdfMaster" Class="orange-pdf">
                                    @TextResources.APP_StringKeys_Print
                                </TelerikButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_Exit_Tab2"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_Exit_Tab2))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.ProductCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                                            Width="120px">
                                    <FooterTemplate>
                                        تعداد کد کالا: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.ProductName)"
                                            Title="@TextResources.APP_StringKeys_ProductName"
                                            Width="200px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.TechnicalCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.Qc)"
                                            Title="@TextResources.APP_StringKeys_Chart_Qc"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Count"
                                            Width="80px">
                                    <FooterTemplate>
                                        تعداد کل: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.SumCount)"
                                            Title="@TextResources.APP_StringKeys_SumValue"
                                            Width="80px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.ProductCountInPack)"
                                            Title="@TextResources.APP_StringKeys_ProductCountInPack"
                                            Width="100px">
                                </GridColumn>
                                @foreach (var column in TechnicalFilterColumns)
                                {
                                    <GridColumn Field="@nameof(GetAllExitActionOnProductCodeVm.TechnicalInfoData)" Title="@column" Width="100px"></GridColumn>
                                }
                                <GridColumn Field="" Width="60px"></GridColumn>
                            </GridColumns>
                            <GridAggregates>
                                <GridAggregate Field=@nameof(GetAllExitActionOnProductCodeVm.SumCount) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllExitActionOnProductCodeVm.Count) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllExitActionOnProductCodeVm.ProductCode) Aggregate="@GridAggregateType.Count" />
                            </GridAggregates>
                        </TelerikGrid>
                    }
                </TabStripTab>
            }
            @if (TabMode == 2 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_ExitAction_Tab1">
                    @if (Exits is not null)
                    {
