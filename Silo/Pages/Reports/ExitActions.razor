                                            @onclick="async ()=>await OnSelectProductForPrint(product)">
                                        <MaterialIcon IconName="@MaterialIconsHelper.Print"></MaterialIcon>
                                    </button>
                                    <button class="btn btn-success btn-details tr-buttom"
                                            @onclick="async ()=>await OnTruckCrossClick(product.OpCode)">
                                        <MaterialIcon IconName="@MaterialIconsHelper.Local_shipping"></MaterialIcon>
                                    </button>
                                    <a class="btn btn-success btn-details tr-buttom"
                                       href="/product/guarantee/@product.OpCode"
                                       target="_blank">
                                        <MaterialIcon IconName="@MaterialIconsHelper.Support_agent"></MaterialIcon>
                                    </a>
                                </td>
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                                <TelerikButton OnClick="@OnClickExportExitsToPdfMaster" Class="orange-pdf">
                                    @TextResources.APP_StringKeys_Print
                                </TelerikButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_ExitAction_Tab1"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_ExitAction_Tab1))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetAllEnterActionsVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="80px">
                                    <FooterTemplate>
                                        تعداد کد عملیات: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.DateTime)"
                                            Title="@TextResources.APP_StringKeys_Time"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.User)"
                                            Title="@TextResources.APP_StringKeys_User"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="150px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.ActionDocumentId)"
                                            Title="@TextResources.APP_StringKeys_DocKey"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.MovementActionDesc)"
                                            Title="@TextResources.APP_StringKeys_Description"
                                            Width="120px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.GateOp)"
                                            Title="@TextResources.APP_StringKeys_GateOpCode"
                                            Width="100px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.StationName)"
                                            Title="@TextResources.APP_StringKeys_Station"
                                            Width="110px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Count"
                                            Width="60px">
                                    <FooterTemplate>
                                        تعداد کل: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionVm.SumCount)"
                                            Title="@TextResources.APP_StringKeys_Summery_SumCount"
                                            Width="90px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                @foreach (var column in DynamicFields.Where(p => p.ActionType == CurrentActionType &&p.FieldShowColumnForAction))
                                {
                                    <GridColumn Field="@nameof(GetAllExitActionVm.MovementActionData)" Title="@column.Title" Width="100px"></GridColumn>
                                }
                                <GridColumn Width="250px"></GridColumn>
                            </GridColumns>
                            <GridAggregates>
                                <GridAggregate Field=@nameof(GetAllExitActionVm.SumCount) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllExitActionVm.Count) Aggregate="@GridAggregateType.Sum" />
                                <GridAggregate Field=@nameof(GetAllExitActionVm.OpCode) Aggregate="@GridAggregateType.Count" />
                            </GridAggregates>
                        </TelerikGrid>
                    }
                </TabStripTab>
            }
            @if (TabMode == 3 || TabMode == 0)
            {
                <TabStripTab Title="@TextResources.APP_StringKeys_Report_ExitAction_Tab3">
                    @if (FullDetails is not null)
                    {
                        <TelerikGrid Data="FullDetails"
                                     PageSize="10"
                                     Navigable="true"
                                     Pageable="true"
                                     Sortable="true"
                                     Width="100%"
                                     ScrollMode="@GridScrollMode.Scrollable">
                            <RowTemplate Context="product">
                                <td class="td-style td-style-full">@product.ProductCode</td>
                                <td class="td-style td-style-full">@product.ProductSerial</td>
                                <td class="td-style td-style-full">@product.ProductName</td>
                                <td class="td-style td-style-full">@product.Size</td>
                                <td class="td-style td-style-full">@product.TechnicalCode</td>
                                <td class="td-style td-style-full">@product.OpCode</td>
                                <td class="td-style td-style-full">@product.DateTime</td>
                                <td class="td-style td-style-full">@product.ActionTypeTitle</td>
                                <td class="td-style td-style-full">@product.DestinationTitle</td>
                                <td class="td-style td-style-full">@product.StoreTitle</td>
                                <td class="td-style td-style-full">@product.ActionDocumentId</td>
                                <td class="td-style td-style-full">@product.MovementActionDesc</td>
                                <td class="td-style td-style-full">@product.Qc</td>
                                <td class="td-style td-style-full">@product.ProductGroup</td>
                                <td class="td-style td-style-full">@product.ProductBrand</td>
                                <td class="td-style td-style-full">@product.ProductType</td>
                                <td class="td-style td-style-full">@product.Line</td>
                                <td class="td-style td-style-full">@product.Shift</td>
                                <td class="td-style td-style-full">@product.DeviceIp</td>
                                <td class="td-style td-style-full">@product.ContractStatus</td>
                                <td class="td-style td-style-full">@product.StationName</td>
                                <td class="td-style td-style-full">@product.Count</td>
                                <td class="td-style td-style-full">@product.Username</td>
                                @if (product.TechnicalInfoData.HasValue())
                                {
                                    @foreach (var field in TechnicalFilterColumns)
                                    {
                                        <td class="td-style">@JToken.Parse(product.TechnicalInfoData.Split("-,-").First())[$"{field}"]</td>
                                    }
                                }
                                @if (product.ProductProperties.HasValue())
                                {
                                    @foreach (var field in DynamicFieldRegisterDataColumns)
                                    {
                                        <td class="td-style">@(JToken.Parse(product.ProductProperties)[$"{field}"] ?? "")</td>
                                    }

                                }
                                @if (product.MovementActionData.HasValue())
                                {
                                    @foreach (var field in DynamicFieldForActionTypeDataColumns)
                                    {
                                        <td class="td-style">@(JToken.Parse(product.MovementActionData)[$"{field}"] ?? "")</td>
                                    }
                                }
                            </RowTemplate>
                            <GridToolBarTemplate>
                                <GridCommandButton Command="ExcelExport" Class="green-excel">
                                    @TextResources.APP_StringKeys_ExportExcel
                                </GridCommandButton>
                            </GridToolBarTemplate>
                            <GridExport>
                                <GridExcelExport AllPages="true" FileName="@TextResources.APP_StringKeys_Report_Exit_Tab3"
                                                 OnBeforeExport="@(async(e) => await OnExcelBeforeExport(e,TextResources.APP_StringKeys_Report_Exit_Tab3))" />
                            </GridExport>
                            <GridColumns>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_ProductCode"
                                            Width="150px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductSerial)"
                                            Title="@TextResources.APP_StringKeys_ProductSerial"
                                            Width="150px">
                                    <FooterTemplate>
                                        تعداد سریال: @context.Count
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductName)"
                                            Title="@TextResources.APP_StringKeys_ProductName"
                                            Width="200px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Size)"
                                            Title="@TextResources.APP_StringKeys_Product_Size"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.TechnicalCode)"
                                            Title="@TextResources.APP_StringKeys_Chart_Regcode"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.OpCode)"
                                            Title="@TextResources.APP_StringKeys_OperationCode"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.DateTime)"
                                            Title="@TextResources.APP_StringKeys_DateTime"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ActionTypeTitle)"
                                            Title="@TextResources.APP_StringKeys_ActionType"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.StoreTitle)"
                                            Title="@TextResources.APP_StringKeys_From_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.DestinationTitle)"
                                            Title="@TextResources.APP_StringKeys_To_Warehouse"
                                            Width="80px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ActionDocumentId)"
                                            Title="@TextResources.APP_StringKeys_DocKey"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.MovementActionDesc)"
                                            Title="@TextResources.APP_StringKeys_Description"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Qc)"
                                            Title="@TextResources.APP_StringKeys_Chart_Qc"
                                            Width="90px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductGroup)"
                                            Title="@TextResources.APP_StringKeys_ProductGroup"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductBrand)"
                                            Title="@TextResources.APP_StringKeys_ProductBrand"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductType)"
                                            Title="@TextResources.APP_StringKeys_Field_ProductType"
                                            Width="70px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Line)"
                                            Title="@TextResources.APP_StringKeys_Chart_Pl"
                                            Width="60px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Shift)"
                                            Title="@TextResources.APP_StringKeys_Chart_Shift"
                                            Width="60px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.DeviceIp)"
                                            Title="@TextResources.APP_StringKeys_RegisterDevice"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ContractStatus)"
                                            Title="@TextResources.APP_StringKeys_ContractStatus"
                                            Width="100px"></GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.StationName)"
                                            Title="@TextResources.APP_StringKeys_Station"
                                            Width="110px">
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Count)"
                                            Title="@TextResources.APP_StringKeys_Value"
                                            Width="80px">
                                    <FooterTemplate>
                                        جمع مقدار: @context.Sum
                                    </FooterTemplate>
                                </GridColumn>
                                <GridColumn Field="@nameof(GetAllExitActionDetailsVm.Username)"
                                            Title="@TextResources.APP_StringKeys_Username"
                                            Width="110px"></GridColumn>
                                @foreach (var column in TechnicalFilterColumns)
                                {
                                    <GridColumn Field="@nameof(GetAllExitActionDetailsVm.TechnicalInfoData)" Title="@column" Width="100px"></GridColumn>
                                }
                                @foreach (var column in DynamicFieldRegisterDataColumns)
                                {
                                    <GridColumn Field="@nameof(GetAllExitActionDetailsVm.ProductProperties)" Title="@column" Width="100px"></GridColumn>
                                }
                                @foreach (var column in DynamicFieldForActionTypeDataColumns)
                                {
                                    <GridColumn Field="@nameof(GetAllExitActionDetailsVm.MovementActionData)" Title="@column" Width="100px"></GridColumn>
                                }
                            </GridColumns>
