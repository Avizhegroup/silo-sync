@page "/report/freezeproduct"
@using Silo.Application.Features;
@using Silo.Components.Filter
@using Silo.Shared.Components.Report
@inherits SiloBasePage

<PageTitle>@PageTitle</PageTitle>

@if (IsFiltersShown)
{
    <div class="row col-md-12">
        <div class="card card-stats col-md-12 text-align-center" style="margin-bottom:5px; height: 70px; padding:5px;">
            <div class=" d-flex flex-row align-items-center flex-wrap  search-button-div" style="margin-top:-148px !important;width:480px;">
                <button class="btn btn-success" type="button" title="@TextResources.APP_StringKeys_Filters"
                        style="margin-left: 2px;" @onclick="OnFilterModalClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Filter_alt"></MaterialIcon>
                </button>
                <button class="btn btn-warning" type="button" title="@TextResources.APP_StringKeys_Clear"
                        style="margin-left: 2px;" @onclick="OnClearClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Refresh"></MaterialIcon>
                </button>
                <button class="btn btn-primary" type="button"
                        title="@TextResources.APP_StringKeys_Send"
                        @onclick="OnSearchClick">
                    <MaterialIcon IconName="@MaterialIconsHelper.Search"></MaterialIcon>
                </button>
            </div>
            @if (ApplyFilters.Any())
            {
                <div class=" d-flex flex-row align-items-center flex-wrap col-md-10" style="margin-bottom:10px!important;">
                    <FilterReportEditSection Filters="ApplyFilters">
                    </FilterReportEditSection>
                </div>
            }
        </div>
    </div>
}

@if (Products is not null)
{
    <div class="row col-md-12" style="margin-top: -10px;">
        <div class="card card-stats col-md-12 text-align-center" style="padding:5px;">
            <TelerikGrid Data="Products"
                         PageSize="10"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true"
                         Width="100%"
                         ScrollMode="@GridScrollMode.Scrollable">
                <GridToolBarTemplate>
                    <GridCommandButton Command="ExcelExport" Icon="@FontIcon.FileExcel" Class="green-excel">
                        @TextResources.APP_StringKeys_ExportExcel
                    </GridCommandButton>
                </GridToolBarTemplate>
                <GridExport>
                    <GridExcelExport AllPages="true" FileName="@PageTitle" />
                </GridExport>
                <GridColumns>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.ProductSerial)"
                                Width="100px">
                        <FooterTemplate>
                            تعداد: @context.Count
                        </FooterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.ProductCode)"
                                Width="120px"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.ProductName)"
                                Width="180px"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.Regcode)"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.ProductCount)">
                        <FooterTemplate>
                            جمع: @context.Sum
                        </FooterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.Qc)"
                                Width="80px"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.Size)"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.Line)"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.User)"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.DateTime)"></GridColumn>
                    <GridColumn Field="@nameof(GetFreezeProductsVm.Desc)"></GridColumn>
                </GridColumns>
                <RowTemplate>
                    <td class="td-style td-style-full">@context.ProductSerial</td>
                    <td class="td-style td-style-full">@context.ProductCode</td>
                    <td class="td-style td-style-full">@context.ProductName</td>
                    <td class="td-style td-style-full">@context.Regcode</td>
                    <td class="td-style td-style-full">@context.ProductCount</td>
                    <td class="td-style td-style-full">@context.Qc</td>
                    <td class="td-style td-style-full">@context.Size</td>
                    <td class="td-style td-style-full">@context.Line</td>
                    <td class="td-style td-style-full">@context.User</td>
                    <td class="td-style td-style-full">@PersianCalendarTools.GregorianToPersian(context.DateTime.Value) @context.DateTime.Value.ToShortTimeString()</td>
                    <td class="td-style td-style-full">@context.Desc</td>
                </RowTemplate>
                <GridAggregates>
                    <GridAggregate Field=@nameof(GetFreezeProductsVm.ProductCount) Aggregate="@GridAggregateType.Sum" />
                    <GridAggregate Field=@nameof(GetFreezeProductsVm.ProductSerial) Aggregate="@GridAggregateType.Count" />
                </GridAggregates>
            </TelerikGrid>
        </div>
    </div>

}

<Modal Buttons="ModalButtons.No"
       ModalTitle="@TextResources.APP_StringKeys_Filters"
       @ref="FiltersModal"
       Size="ModalSize.Large"
       CloseBtnText="@TextResources.APP_StringKeys_Close"
       OkBtnText="@TextResources.APP_StringKeys_Ok">
    <ModalBodyContentHtml>
        <div class="text-align-right">
            @if (FiltersModal.ModalClass.Equals("Show"))
            {
                <FilterReportSelectSection Filters="Filters" OnSearchClick="OnAddNewFilterClick">
                </FilterReportSelectSection>
            }
        </div>
    </ModalBodyContentHtml>
</Modal>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>