@page "/sync/failures"
@inherits SiloBasePage
@namespace Silo.Pages.Sync
@using System.Net.Http

<PageTitle>Sync Failures</PageTitle>

<div class="row col-md-12">
    <div class="card card-stats col-md-12 text-align-center" style="padding:10px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <h5 class="card-title">Sync Failures</h5>
            <div class="d-flex align-items-center">
                <label class="mr-2">Status:</label>
                <TelerikDropDownList Data="StatusOptions"
                                     @bind-Value="SelectedStatus"
                                     Width="160px"
                                     Class="mr-2">
                </TelerikDropDownList>
                <button class="btn btn-primary" @onclick="OnFilterClick">@TextResources.APP_StringKeys_Filter</button>
                <button class="btn btn-success ml-2" disabled="@IsRetrying" @onclick="OnBulkRetryClick">Bulk Retry</button>
            </div>
        </div>
    </div>

    @if (FailureList is not null)
    {
        <div class="card card-stats text-align-center col-md-12" style="margin-top:5px;padding:5px;">
            <TelerikGrid Data="FailureList"
                         PageSize="10"
                         Pageable="true"
                         Sortable="true"
                         Width="100%"
                         @ref="FailureGrid">
                <GridColumns>
                    <GridCheckboxColumn Width="40px"
                                        HeaderClass="header-select-all"
                                        SelectedItems="SelectedFailures"
                                        SelectedItemsChanged="OnSelectedFailuresChanged">
                    </GridCheckboxColumn>
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.SourceKey)" Title="Source Key" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.RowKey)" Title="Row Key" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.ErrorCategory)" Title="Category" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.ErrorMessage)" Title="Message" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.AttemptCount)" Title="Attempts" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.NextAttemptAt)" Title="Next Retry" />
                    <GridColumn Field="@nameof(GetOpenSyncFailuresVm.Status)" Title="Status" />
                    <GridTemplateColumn Title="Actions">
                        <Template>
                            @{
                                var item = context as GetOpenSyncFailuresVm;
                                <button class="btn btn-sm btn-primary" disabled="@IsRetrying" @onclick="async () => await OnRetryClick(item)">Retry</button>
                            }
                        </Template>
                    </GridTemplateColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    }
</div>

<TelerikLoaderContainer Visible="IsLoading"
                        LoaderPosition="@LoaderPosition.End"
                        LoaderType="LoaderType.InfiniteSpinner"
                        Text="@TextResources.APP_StringKeys_Loading">
</TelerikLoaderContainer>
