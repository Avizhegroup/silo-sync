@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Silo.Components
@using System.Reflection
@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <component type="typeof(HeadOutlet)" render-mode="Server" />
    <base href="~/" />

    <link href="Silo.styles.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/Site.min.css" />
    <script src="/js/telerik/jquery.min.js"></script>
    <script src="_content/Telerik.UI.for.Blazor/js/telerik-blazor.js"></script>
    <link id="telerik-theme-light" rel="stylesheet" href="_content/Telerik.UI.for.Blazor/css/kendo-theme-default/all.css" media="all" />
    <link id="telerik-theme-dark" rel="stylesheet" href="/styles/libraries/kendo-dark-9.min.css" media="not all" />
</head>
<body>

    @RenderBody()

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.min.js" ></script>
    <script src="~/js/BlobDownloader.js" ></script>
    
    <script src="_framework/blazor.server.js"></script>

    <script src="_content/Silo.Shared.Components/js/Silo.Shared.Components.min.js"></script>
    <link rel="stylesheet" href="_content/Silo.Shared.Components/css/Silo.Shared.Components.min.css" />

    @RenderSection("Scripts", required: false)
</body>
</html>
